#!/usr/bin/env bash
# scripts/target-gc
#
# Prune stale build artifacts from cargo target directories (manual
# maintenance recipe, #12791). Complements scripts/clean-tmp-targets.sh,
# which only handles /tmp agent orphans.
#
# Safety model:
#   - DRY-RUN by default: nothing is deleted without --apply.
#   - Strictly per-file mtime threshold: only files not modified within
#     --days (default TARGET_GC_DAYS=14) are candidates. Everything a fresh
#     build just wrote or replaced is immune by construction, proven twice:
#     synthetic fixtures and a live dry-run over a freshly built workspace
#     target tree reporting zero candidates. Artifacts idle longer than the
#     threshold ARE removed even if still referenced by the last build
#     state; the next build needing them pays a one-time rebuild.
#   - Never touches Cargo.lock / package-cache locks / CACHEDIR.TAG /
#     .rustc_info.json, never descends into .git or registry-named trees,
#     and only ever walks resolved cargo *target* roots. The registry lives
#     under CARGO_HOME, not under any target root; the name guards are a
#     second seatbelt against a mistyped --dir.
#   - Refuses to run while the devplane build flock is held (exit 75, same
#     contract as scripts/cargo-safe DENY), so GC can never race a routed
#     build that shares the devplane.
#
# Walk engine: python (os.scandir, single process) when available — on
# Windows/Git Bash a naive per-file find() storm costs minutes on GB-scale
# trees; the python path scans them in seconds. POSIX find fallback kept for
# hosts without python. Semantics identical either way.
#
# Usage:
#   scripts/target-gc                  # dry-run over default roots
#   scripts/target-gc --apply          # actually delete candidates
#   scripts/target-gc --days 30        # widen the freshness window
#   scripts/target-gc --dir /path/tgt  # add an extra root (repeatable)
#
# Default roots: the current checkout's target/, $DEVPLANE/target when DEVPLANE
# is exported, and the repository-stable default devplane target derived from
# the git common dir (see docs/how-to/MULTI_WORKTREE_BUILD_CACHING.md).
set -euo pipefail

APPLY=0
DAYS="${TARGET_GC_DAYS:-14}"
EXTRA_DIRS=()

usage() { grep '^#' "$0" | sed 's/^# \{0,1\}//'; }

while [ $# -gt 0 ]; do
    case "$1" in
        --apply) APPLY=1 ;;
        --dry-run) APPLY=0 ;;
        --days)
            [ $# -ge 2 ] || { echo "--days needs a number" >&2; exit 2; }
            case "$2" in
                ''|*[!0-9]*) echo "--days must be a non-negative integer" >&2; exit 2 ;;
                *) DAYS="$2" ;;
            esac
            shift
            ;;
        --dir)
            [ $# -ge 2 ] || { echo "--dir needs a path" >&2; exit 2; }
            EXTRA_DIRS+=("$2")
            shift
            ;;
        --help|-h) usage; exit 0 ;;
        *) echo "Unknown argument: $1 (see --help)" >&2; exit 2 ;;
    esac
    shift
done

file_size() {
    stat -c '%s' "$1" 2>/dev/null || stat -f '%z' "$1" 2>/dev/null || printf '0'
}

mib() { awk "BEGIN{printf \"%.2f\", $1/1048576}"; }

# ── Resolve default roots ─────────────────────────────────────────────────────

ROOTS=()

if repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    ROOTS+=("$repo_root/target")
    # Repository-stable devplane key: derive from the common git dir so every
    # linked worktree resolves one shared devplane.
    main_root="$(dirname "$(git rev-parse --git-common-dir)")"
else
    ROOTS+=("$PWD/target")
    main_root="$PWD"
fi

if [ -n "${DEVPLANE:-}" ]; then
    ROOTS+=("$DEVPLANE/target")
elif [ -d "${XDG_CACHE_HOME:-$HOME/.cache}/devplane/$(basename "$main_root")/target" ]; then
    ROOTS+=("${XDG_CACHE_HOME:-$HOME/.cache}/devplane/$(basename "$main_root")/target")
fi

for d in ${EXTRA_DIRS[@]+"${EXTRA_DIRS[@]}"}; do
    [ -d "$d" ] || { echo "ERROR: --dir '$d' is not a directory" >&2; exit 2; }
    ROOTS+=("$d")
done

# Collapse duplicates while keeping order (normalize drive-letter forms so
# F:/x and /f/x dedup on Git Bash).
seen="|"
roots_csv=""
for r in ${ROOTS[@]+"${ROOTS[@]}"}; do
    if command -v cygpath >/dev/null 2>&1; then
        r="$(cygpath -u "$r" 2>/dev/null || printf '%s' "$r")"
    fi
    case "$seen" in *"|$r|"*) continue ;; esac
    seen="$seen$r|"
    roots_csv+="$r"$'\n'
done

existing_roots=""
while IFS= read -r r; do
    [ -z "${r:-}" ] && continue
    [ -d "$r" ] && existing_roots+="$r"$'\n'
done <<< "$roots_csv"

echo "== target-gc (mode: $( [ "$APPLY" -eq 1 ] && echo APPLY || echo dry-run ), threshold: older than ${DAYS}d) =="

if [ -z "$existing_roots" ]; then
    echo "no existing target roots found; nothing to gc"
    exit 0
fi
printf 'roots:\n'
while IFS= read -r r; do
    [ -n "${r:-}" ] && printf '  %s\n' "$r"
done <<< "$existing_roots"

# ── Devplane lock guard ───────────────────────────────────────────────────────

if command -v flock >/dev/null 2>&1; then
    while IFS= read -r r; do
        [ -z "${r:-}" ] && continue
        lockfile="$(dirname "$r")/locks/cargo-build.lock"
        [ -e "$lockfile" ] || continue
        if ! flock -n 9 9<"$lockfile" 2>/dev/null; then
            echo "DENY: devplane build flock held ($lockfile); wait for the routed build to finish before gc-ing" >&2
            exit 75
        fi
        exec 9>&-
    done <<< "$existing_roots"
fi

# ── Collect candidates ────────────────────────────────────────────────────────
# Output: TSV "bytes<TAB>path" of every file older than the threshold, after
# the name-based exclusions above.

candidate_tsv="$(mktemp)"
trap 'rm -f "$candidate_tsv"' EXIT

pybin=""
if command -v python3 >/dev/null 2>&1; then pybin="python3"
elif command -v python >/dev/null 2>&1; then pybin="python"
fi

if [ -n "$pybin" ]; then
    roots_nul="$(mktemp)"
    walker_py="$(mktemp)"
    trap 'rm -f "$candidate_tsv" "$roots_nul" "$walker_py"' EXIT
    while IFS= read -r r; do
        [ -z "${r:-}" ] && continue
        # Windows-native python cannot resolve MSYS virtual paths like /tmp/...;
        # translate to native form when cygpath is available. MSYS/Cygwin pythons
        # and Linux accept the same native strings unchanged.
        if command -v cygpath >/dev/null 2>&1; then
            r="$(cygpath -w "$r" 2>/dev/null || printf '%s' "$r")"
        fi
        printf '%s\0' "$r" >> "$roots_nul"
    done <<< "$existing_roots"
    # The walker is a temp file, NOT "python -": a heredoc would own stdin and
    # starve the NUL-delimited root list. Roots stay on stdin; candidates
    # stream out as "bytes\tpath" TSV lines.
    cat > "$walker_py" <<'PYEOF'
import os
import sys
import time

days = int(sys.argv[1])
roots = [r.decode() for r in sys.stdin.buffer.read().split(b"\x00") if r]
cutoff = time.time() - days * 86400
excl_names = {".package-cache", "CACHEDIR.TAG", ".rustc_info.json"}

def excluded(name):
    return name.endswith(".lock") or name in excl_names

stack = list(roots)
while stack:
    d = stack.pop()
    try:
        it = os.scandir(d)
    except OSError:
        continue
    with it:
        for e in it:
            n = e.name
            try:
                if e.is_dir(follow_symlinks=False):
                    if n == ".git" or n == "registry":
                        continue
                    stack.append(e.path)
                elif not excluded(n):
                    st = e.stat(follow_symlinks=False)
                    if st.st_mtime <= cutoff:
                        sys.stdout.write("%d\t%s\n" % (st.st_size, e.path))
            except OSError:
                continue
PYEOF
    "$pybin" "$walker_py" "$DAYS" < "$roots_nul" >> "$candidate_tsv"
else
    while IFS= read -r r; do
        [ -z "${r:-}" ] && continue
        while IFS= read -r -d '' f; do
            printf '%s\t%s\n' "$(file_size "$f")" "$f"
        done < <(
            find "$r" \
                \( -type d \( -name .git -o -name registry \) \) -prune \
                -o \( -type f \( -name '*.lock' -o -name '.package-cache' \
                                -o -name 'CACHEDIR.TAG' -o -name '.rustc_info.json' \) \) -prune \
                -o -type f -mtime +"$DAYS" -print0 2>/dev/null
        )
    done <<< "$existing_roots" >> "$candidate_tsv"
fi

# The python engine emits native-form paths (cygpath-translated roots);
# normalize to MSYS/POSIX form so stat/rm in this script operate on the same
# paths every other repository tool uses. Drive-letter mapping matches the
# standard automatic Git-Bash mounts.
posix_tsv="$candidate_tsv.posix"
tr -d '\r' < "$candidate_tsv" | awk -F '\t' '
    {
        p = $2
        if (p ~ /^[A-Za-z]:\\/) {
            drv = tolower(substr(p, 1, 1))
            rest = substr(p, 4)
            gsub(/\\/, "/", rest)
            p = "/" drv "/" rest
        }
        print $1 "\t" p
    }' > "$posix_tsv"
mv -f "$posix_tsv" "$candidate_tsv"

if [ ! -s "$candidate_tsv" ]; then
    echo "nothing to reclaim"
    exit 0
fi

total_bytes=0
count=0
preview=0
while IFS=$'\t' read -r sz p; do
    total_bytes=$(( total_bytes + sz ))
    count=$(( count + 1 ))
    if [ "$APPLY" -eq 0 ] && [ "$preview" -lt 25 ]; then
        printf '  stale\t%s\t%s\n' "$sz" "$p"
        preview=$(( preview + 1 ))
    fi
done < "$candidate_tsv"

[ "$count" -gt "$preview" ] && [ "$APPLY" -eq 0 ] && printf '  ... (%d more)\n' "$((count - preview))"

printf 'candidates: %d files, %s MiB reclaimable\n' "$count" "$(mib "$total_bytes")"

if [ "$APPLY" -ne 1 ]; then
    echo "dry-run only; re-run with --apply to delete these candidates"
    exit 0
fi

reclaimed=0
removed=0
failed=0
while IFS=$'\t' read -r sz p; do
    if rm -f "$p" 2>/dev/null; then
        reclaimed=$(( reclaimed + sz ))
        removed=$(( removed + 1 ))
    else
        failed=$(( failed + 1 ))
        echo "WARN: could not remove $p (in use?) — skipped" >&2
    fi
done < "$candidate_tsv"

printf 'applied: removed %d files, reclaimed %s MiB' "$removed" "$(mib "$reclaimed")"
if [ "$failed" -gt 0 ]; then
    printf ', %d skipped' "$failed"
fi
printf '\n'
