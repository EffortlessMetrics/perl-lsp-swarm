#!/usr/bin/env bash
set -euo pipefail

# Toolchain guard (#12593): refuse a stale non-rustup cargo before any build work.
. "$(dirname -- "${BASH_SOURCE[0]}")/lib/cargo-toolchain-guard.sh" && cargo_toolchain_guard

usage() {
    cat <<'USAGE'
Usage: scripts/fuzz-bounded [--list] [--duration SECONDS] [-- TARGET...]

Runs every cargo-fuzz binary declared in fuzz/Cargo.toml with a bounded time
budget. Set FUZZ_MAX_LEN and FUZZ_TIMEOUT to override libFuzzer limits.
USAGE
}

# Git Bash `mapfile`/`read` drop LF but keep CR from native Windows Python.
# Strip that discovery artifact only. Caller argv is never rewritten.
normalize_discovered_target_name() {
    printf '%s' "${1%$'\r'}"
}

# Populate `discovered_targets` from cargo-fuzz metadata. Fail closed when the
# pipeline fails or when no non-empty bin names remain after CR stripping.
load_discovered_fuzz_targets() {
    local repo_root=$1
    local raw status=0 line normalized

    raw=$(
        cargo metadata \
            --manifest-path "$repo_root/fuzz/Cargo.toml" \
            --no-deps \
            --format-version 1 \
        | python3 -c 'import json, sys
metadata = json.load(sys.stdin)
targets = sorted(
    target["name"]
    for package in metadata["packages"]
    for target in package["targets"]
    if "bin" in target["kind"]
)
print("\n".join(targets))'
    ) || status=$?

    if ((status != 0)); then
        echo "error: failed to discover cargo-fuzz targets from fuzz/Cargo.toml" >&2
        return 1
    fi

    discovered_targets=()
    while IFS= read -r line || [[ -n $line ]]; do
        normalized=$(normalize_discovered_target_name "$line")
        if [[ -n $normalized ]]; then
            discovered_targets+=("$normalized")
        fi
    done <<<"$raw"

    if ((${#discovered_targets[@]} == 0)); then
        echo "error: cargo-fuzz metadata produced no bin targets" >&2
        return 1
    fi
}

reject_unknown_fuzz_targets() {
    local target
    local -a unknown=()
    declare -A known=()

    for target in "${discovered_targets[@]}"; do
        known["$target"]=1
    done

    for target in "${targets[@]}"; do
        # Empty argv is not a subscriptable key and is never a declared bin.
        if [[ -z "$target" ]]; then
            echo "error: empty fuzz target name" >&2
            return 2
        fi
        if [[ -z ${known[$target]+x} ]]; then
            unknown+=("$target")
        fi
    done

    if ((${#unknown[@]} > 0)); then
        echo "error: unknown fuzz target(s): ${unknown[*]}" >&2
        echo "known targets:" >&2
        printf '  %s\n' "${discovered_targets[@]}" >&2
        return 2
    fi
}

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
duration=${FUZZ_DURATION:-60}
list_only=0
targets=()
discovered_targets=()

while (($#)); do
    case "$1" in
        --list)
            list_only=1
            shift
            ;;
        --duration)
            if (($# < 2)); then
                echo "error: --duration requires a value" >&2
                usage >&2
                exit 2
            fi
            duration=$2
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        --)
            shift
            targets+=("$@")
            break
            ;;
        *)
            targets+=("$1")
            shift
            ;;
    esac
done

if [[ ! $duration =~ ^[0-9]+$ ]] || ((duration == 0)); then
    echo "error: duration must be a positive integer number of seconds" >&2
    exit 2
fi

load_discovered_fuzz_targets "$repo_root"

if ((${#targets[@]} == 0)); then
    targets=("${discovered_targets[@]}")
fi

if ((list_only)); then
    printf '%s\n' "${targets[@]}"
    exit 0
fi

reject_unknown_fuzz_targets

max_len=${FUZZ_MAX_LEN:-1000}
timeout=${FUZZ_TIMEOUT:-25}

echo "🔥 Running ${#targets[@]} fuzz target(s) for ${duration}s each"
for target in "${targets[@]}"; do
    echo ">>> cargo +nightly fuzz run $target -- -max_total_time=$duration -max_len=$max_len -timeout=$timeout"
    cargo +nightly fuzz run "$target" -- \
        -max_total_time="$duration" \
        -max_len="$max_len" \
        -timeout="$timeout"
done
echo "✅ Bounded fuzz testing complete"
