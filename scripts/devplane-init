#!/usr/bin/env bash
# scripts/devplane-init
set -euo pipefail

# Planning must not allocate a second cache layout or probe/install Cargo.
if command -v python3 >/dev/null 2>&1; then
  python=python3
elif command -v python >/dev/null 2>&1; then
  python=python
else
  echo 'devplane-init: DENY: Python 3 is required to plan admitted storage' >&2
  exit 75
fi

# -B also keeps importing the admission owner from writing __pycache__.
exec "$python" -B - "$(dirname -- "${BASH_SOURCE[0]}")" <<'PY'
import json
import os
import subprocess
import sys

sys.path.insert(0, sys.argv[1])
from cargo_admitted import Denied, read_only_git_environment, resource_plan

try:
    worktree, slot, paths = resource_plan(read_only_git_environment(os.environ))
except (Denied, OSError, subprocess.SubprocessError) as error:
    print("devplane-init: DENY: " + str(error), file=sys.stderr)
    raise SystemExit(75)

print("devplane plan: " + json.dumps({
    "status": "planned", "allocated": False, "capacity_assessed": False,
    "lease_acquired": False, "worktree": str(worktree), "slot": str(slot),
    "resources": {name: str(path) for name, path in paths.items()},
}, sort_keys=True))
print("Directories not allocated; capacity not assessed.")
print("""
Preflight and execute the same focused request from this worktree and shell:

  scripts/cargo-admitted --preflight check -p PACKAGE --profile agent --locked
  just agent-check PACKAGE

Keep any additional package, target, feature and test arguments identical in
preflight and execution. See docs/agents/CARGO_STORAGE.md for host admission.
""")
PY
