#!/usr/bin/env bash
# scripts/devplane-init
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
repo_name="$(basename "$repo_root")"
devplane="${DEVPLANE:-${XDG_CACHE_HOME:-$HOME/.cache}/devplane/$repo_name}"

mkdir -p \
  "$devplane/cargo-home" \
  "$devplane/target" \
  "$devplane/build" \
  "$devplane/sccache" \
  "$devplane/tmp" \
  "$devplane/locks"

cat <<EOM
devplane ready:

  DEVPLANE=$devplane
  CARGO_HOME=$devplane/cargo-home
  CARGO_TARGET_DIR=$devplane/target
  CARGO_BUILD_BUILD_DIR=$devplane/build
  SCCACHE_DIR=$devplane/sccache
  TMPDIR=$devplane/tmp

Recommended:

First qualify an operator-owned budget for the exact focused command below using
docs/how-to/CONSTRAINED_CARGO_BUILDS.md. Directory setup alone does not admit a
build. This example requires an already installed toolchain and dependencies.

  export DEVPLANE="$devplane"
  ./scripts/cargo-admitted --preflight --budget-file "\$HOME/.config/perl-lsp/cargo-budget.json" check -p perl-test-must --lib --locked --offline
  ./scripts/cargo-admitted --budget-file "\$HOME/.config/perl-lsp/cargo-budget.json" check -p perl-test-must --lib --locked --offline

Changed packages, targets, flags or storage settings require a matching qualified
budget. Without --budget-file, even small checks retain the default 40 GiB reserve.
Legacy cargo-safe recipes remain compatibility routes; setup does not migrate them.
EOM
