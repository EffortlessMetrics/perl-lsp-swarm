#!/usr/bin/env bash
# Startup validation for a provisioned Linux cloud image; see docs/how-to/CLOUD_STARTUP.md.
set -euo pipefail

script_dir="${BASH_SOURCE[0]%/*}"
if [[ "$script_dir" == "${BASH_SOURCE[0]}" ]]; then
    script_dir=.
fi
repo="$(CDPATH= cd -- "$script_dir/.." && pwd)"
startup_dir="$(pwd -P)"
shared="${PERL_LSP_CLOUD_SHARED:-/workspace/shared}"
if [[ "$shared" != /* ]]; then
    shared="$startup_dir/$shared"
fi
export CARGO_HOME="$shared/cargo"
export RUSTUP_HOME="$shared/rustup"
export DEVPLANE="$shared/devplane/perl-lsp-swarm"
export npm_config_cache="$shared/npm-cache"

# PATH entries are interpreted relative to the process working directory. Anchor
# inherited relative and empty entries before changing directories so startup
# validates and later invokes the same tools in the same order.
normalize_path() {
    local remaining="$1"
    local base="$2"
    local normalized=""
    local entry
    local has_more

    while :; do
        if [[ "$remaining" == *:* ]]; then
            entry="${remaining%%:*}"
            remaining="${remaining#*:}"
            has_more=1
        else
            entry="$remaining"
            has_more=0
        fi

        if [[ -z "$entry" ]]; then
            entry="$base"
        elif [[ "$entry" != /* ]]; then
            entry="$base/$entry"
        fi

        if [[ -n "$normalized" ]]; then
            normalized="$normalized:$entry"
        else
            normalized="$entry"
        fi

        if [[ "$has_more" -eq 0 ]]; then
            break
        fi
    done

    printf '%s' "$normalized"
}

inherited_path=""
if [[ -n "${PATH:-}" ]]; then
    inherited_path="$(normalize_path "$PATH" "$startup_dir")"
fi
export PATH="$CARGO_HOME/bin${inherited_path:+:$inherited_path}"

# Parse the repository default before any setup command runs. An explicit task
# selector remains authoritative; otherwise rustup resolves rust-toolchain.toml
# from the repository working directory. Startup validates either selection and
# never installs a missing toolchain or changes rustup's global/directory state.
repo_toolchain="$(python3 - "$repo/rust-toolchain.toml" <<'PY'
import pathlib
import sys
import tomllib

channel = tomllib.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))["toolchain"]["channel"]
if not isinstance(channel, str) or not channel.strip():
    raise ValueError("rust-toolchain.toml must declare a nonempty toolchain channel")
print(channel)
PY
)"
if [[ -n "${RUSTUP_TOOLCHAIN:-}" ]]; then
    toolchain_source=environment
    toolchain_selector="$RUSTUP_TOOLCHAIN"
else
    unset RUSTUP_TOOLCHAIN
    toolchain_source=rustup-resolution
    toolchain_selector="<unset>"
fi
export RUSTUP_AUTO_INSTALL=0

require_command() {
    local name="$1"
    local resolved
    if ! resolved="$(command -v -- "$name")"; then
        printf 'cloud-startup: required command not found on PATH: %s\n' "$name" >&2
        return 127
    fi
    printf 'cloud-startup: command %s=%s\n' "$name" "$resolved"
}

cd "$repo"
printf 'cloud-startup: rust-toolchain source=%s selector=%s repository-default=%s\n' \
    "$toolchain_source" "$toolchain_selector" "$repo_toolchain"
for command in rustup rustc cargo just node npm; do
    require_command "$command"
done

# A no-install environment variable is insufficient for rustup <= 1.27.
# Reuse the Cargo guard's non-selecting help probe for the selected manager
# and any distinct managers behind the actual rustc/cargo proxies. A newer
# unrelated PATH rustup cannot validate an older proxy in another installation.
. "$repo/scripts/lib/cargo-toolchain-guard.sh"
checked_managers=()
for tool in rustup rustc cargo; do
    resolved="$(command -v -- "$tool")"
    if [[ "$tool" == rustup ]]; then
        manager="$resolved"
    else
        manager="$(cargo_guard_proxy_manager "$resolved" || true)"
    fi
    [[ -n "$manager" ]] || continue
    already_checked=0
    for checked in "${checked_managers[@]}"; do
        if [[ "$manager" -ef "$checked" ]]; then
            already_checked=1
            break
        fi
    done
    [[ "$already_checked" -eq 0 ]] || continue
    if ! manager_version="$(cargo_guard_probe_rustup_manager "$manager")"; then
        printf 'cloud-startup: rustup >= 1.28.0 required before probing %s; manager=%s version=%s\n' \
            "$tool" "$manager" "${manager_version:-unverified}" >&2
        printf 'cloud-startup: update the manager explicitly; no toolchain-selecting probe was run.\n' >&2
        exit "$CARGO_GUARD_EXIT_CODE"
    fi
    checked_managers+=("$manager")
    printf 'cloud-startup: rustup-manager=%s version=%s\n' "$manager" "$manager_version"
done

# Version/identity output is the startup receipt. The extension doctor below
# remains the authority for accepting the active Node/npm versions.
rustup show active-toolchain
rustc --version
cargo --version
node --version
npm --version
just --version

python3 scripts/check_release_tag_provenance.py --prepare-git --repo-root .
just devplane-init
just agent-preflight

cd "$repo/vscode-extension"
npm run doctor
npm ci
