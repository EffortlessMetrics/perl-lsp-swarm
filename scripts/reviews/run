#!/usr/bin/env bash
# scripts/reviews/run — retired live review-receipt writer.
#
# Historical review-run / verification markers remain readable through the
# compatibility parsers and fixtures that own old incident evidence. This
# command no longer has authority to write GitHub comments or reviews.
#
# Durable current review state belongs in native GitHub review requests,
# submitted reviews, inline findings, and evidence-backed dispositions. A
# head SHA remains useful machine-evidence metadata and merge compare-and-swap
# protection; it is not a review verdict or a reason to publish lifecycle
# receipts.
set -euo pipefail

subcommand="${1:-missing}"
cat >&2 <<EOF
RETIRED: scripts/reviews/run $subcommand cannot write review lifecycle receipts.

Use native GitHub surfaces instead:
  - request review when a pending judgment must be visible;
  - submit a useful review with scope, evidence/falsifiers, findings or an
    explicit clean result, prior dispositions, what is established, residual
    risk, and next action;
  - post actionable findings in inline threads;
  - resolve findings only through an evidence-backed disposition.

Historical receipt readers and fixtures remain available for old incidents.
EOF
exit 2
