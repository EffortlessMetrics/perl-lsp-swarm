#!/usr/bin/env bash
# scripts/reviews/state — factual native GitHub review state for one PR.
#
# This is a read-only projection of check-pr-review-convergence. It does not
# model exact-head review receipts, fixed-head stages, verification ladders,
# leases, or agent lifecycle. The candidate head is returned only as observed
# metadata.
#
# It reads the same native facts as its parent and inherits the same limit: a
# submitted human review is a GitHub fact, not a substantive-review verdict.
# This helper therefore never reports REVIEWED. Subject-bound semantic
# currentness is owned by check-pr-semantic-review-currentness.py, and callers
# must consult it separately before treating a candidate as reviewed.
set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "usage: $0 <pr-number> [owner/repo]" >&2
    exit 2
fi

PR="$1"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLOSEOUT="$SCRIPT_DIR/../ci/check-pr-review-convergence"

command -v jq >/dev/null 2>&1 || { echo "ERROR: jq not found on PATH" >&2; exit 2; }
[[ -x "$CLOSEOUT" || -f "$CLOSEOUT" ]] || { echo "ERROR: closeout not found at $CLOSEOUT" >&2; exit 2; }

CLOSE_EXIT=0
CLOSE_OUT="$(bash "$CLOSEOUT" "$@" 2>/dev/null)" || CLOSE_EXIT=$?
if [[ "$CLOSE_EXIT" -ge 2 ]]; then
    jq -n --arg pr "$PR" --argjson childExit "$CLOSE_EXIT" '{
      pr: ($pr | tonumber? // $pr),
      state: "NOT_PROVEN",
      child_exit: $childExit,
      review_currentness: "NOT_PROVEN",
      semantic_currentness_required: true,
      exact_head_review_required: false
    }'
    exit 2
fi

JSON="$(printf '%s' "$CLOSE_OUT" | sed -n '/^{/,$p')"
if [[ -z "$JSON" ]] || ! jq -e . >/dev/null 2>&1 <<<"$JSON"; then
    echo "ERROR: closeout produced no usable JSON for PR #$PR" >&2
    jq -n --arg pr "$PR" '{
      pr: ($pr | tonumber? // $pr),
      state: "NOT_PROVEN",
      reason: "invalid_closeout_output",
      review_currentness: "NOT_PROVEN",
      semantic_currentness_required: true,
      exact_head_review_required: false
    }'
    exit 2
fi

CLASSIFICATION="$(jq -r '.formal_review.classification // "NOT_PROVEN"' <<<"$JSON")"
CONVERGED="$(jq -r '.converged // false' <<<"$JSON")"
HEAD="$(jq -r '.headRefOid // ""' <<<"$JSON")"
SUBMITTED_HUMAN_REVIEW_COUNT="$(jq -r '.submitted_human_review_count // 0' <<<"$JSON")"

# Native facts can converge; they cannot establish substantive review. Both
# converged classifications therefore project to the same state, and the
# classification field carries the finer distinction.
case "$CLASSIFICATION" in
    PENDING) STATE="PENDING_REVIEW" ;;
    FINDINGS_OPEN) STATE="FINDINGS_OPEN" ;;
    SUBMITTED_REVIEW_PRESENT | NO_SUBMITTED_HUMAN_REVIEW)
        if [[ "$CONVERGED" == "true" ]]; then
            STATE="NATIVE_FACTS_CONVERGED"
        else
            STATE="FINDINGS_OPEN"
        fi
        ;;
    *) STATE="NOT_PROVEN" ;;
esac

jq -n \
    --arg pr "$PR" \
    --arg head "$HEAD" \
    --arg state "$STATE" \
    --arg classification "$CLASSIFICATION" \
    --argjson converged "$CONVERGED" \
    --argjson submittedReviews "$SUBMITTED_HUMAN_REVIEW_COUNT" \
    '{
      pr: ($pr | tonumber? // $pr),
      observed_head: $head,
      state: $state,
      formal_review_classification: $classification,
      converged: $converged,
      submitted_human_review_count: $submittedReviews,
      review_currentness: "NOT_PROVEN",
      semantic_currentness_required: true,
      exact_head_review_required: false
    }'
