#!/usr/bin/env bash
# scripts/reviews/disposition — evidence-backed review-thread disposition.
#
# Reply with evidence, then resolve. Idempotency is based on stable finding
# identity (the GitHub thread), disposition class, and evidence identity. The
# observed PR head is retained as forensic metadata; unrelated head movement
# does not create another disposition reply.
set -euo pipefail

die_usage() { echo "ERROR: $1" >&2; exit 2; }

PR="" THREAD="" CLASS="" REPLY="" COMMIT="" ISSUE="" SUPERSEDED_BY="" ARGUMENT=""
REPO="" HEAD="" BY="" DRY_RUN=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --pr)            PR="${2:-}"; shift 2 ;;
        --thread)        THREAD="${2:-}"; shift 2 ;;
        --class)         CLASS="${2:-}"; shift 2 ;;
        --reply)         REPLY="${2:-}"; shift 2 ;;
        --commit)        COMMIT="${2:-}"; shift 2 ;;
        --issue)         ISSUE="${2:-}"; shift 2 ;;
        --superseded-by) SUPERSEDED_BY="${2:-}"; shift 2 ;;
        --argument)      ARGUMENT="${2:-}"; shift 2 ;;
        --repo)          REPO="${2:-}"; shift 2 ;;
        --head)          HEAD="${2:-}"; shift 2 ;;
        --by)            BY="${2:-}"; shift 2 ;;
        --dry-run)       DRY_RUN=1; shift ;;
        *) die_usage "unknown argument: $1" ;;
    esac
done

[[ -n "$PR" ]]     || die_usage "--pr is required"
[[ -n "$THREAD" ]] || die_usage "--thread is required"
[[ -n "$CLASS" ]]  || die_usage "--class is required"
[[ -n "$REPLY" ]]  || die_usage "--reply is required"
command -v jq >/dev/null 2>&1 || die_usage "jq not found on PATH"

EVIDENCE=""
case "$CLASS" in
    fixed)
        [[ -n "$COMMIT" ]] || die_usage "class=fixed requires --commit <sha>"
        EVIDENCE="$(jq -cn --arg c "$COMMIT" '{commit:$c}')"
        ;;
    refuted)
        [[ -n "$ARGUMENT" ]] || die_usage "class=refuted requires --argument <text>"
        EVIDENCE="$(jq -cn --arg a "$ARGUMENT" '{argument:$a}')"
        ;;
    superseded)
        [[ -n "$SUPERSEDED_BY" ]] || die_usage "class=superseded requires --superseded-by <n|url>"
        EVIDENCE="$(jq -cn --arg s "$SUPERSEDED_BY" '{superseded_by:$s}')"
        ;;
    follow-up)
        [[ "$ISSUE" =~ ^[0-9]+$ && "$ISSUE" -gt 0 ]] || die_usage "class=follow-up requires --issue <positive-integer>"
        EVIDENCE="$(jq -cn --argjson i "$ISSUE" '{issue:$i}')"
        ;;
    *)
        die_usage "invalid --class '$CLASS' (fixed|refuted|superseded|follow-up)"
        ;;
esac

if [[ "$DRY_RUN" -eq 0 ]]; then
    command -v gh >/dev/null 2>&1 || die_usage "gh not found on PATH (required unless --dry-run)"
    [[ -n "$REPO" ]] || REPO="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"
    [[ -n "$HEAD" ]] || HEAD="$(gh pr view "$PR" --repo "$REPO" --json headRefOid --jq .headRefOid)"
    [[ -n "$BY" ]]   || BY="$(gh api user --jq .login 2>/dev/null || echo unknown)"
else
    [[ -n "$HEAD" ]] || HEAD="DRYRUN-HEAD"
    [[ -n "$BY" ]]   || BY="dryrun-actor"
fi

# v1 marker remains readable by existing historical parsers. `head` records the
# observed candidate but does not participate in idempotency.
MARKER="$(jq -cn \
    --arg class "$CLASS" --arg tid "$THREAD" --arg by "$BY" --arg head "$HEAD" \
    --argjson ev "$EVIDENCE" \
    '{v:1, class:$class, thread_id:$tid, by:$by, head:$head, evidence:$ev}')"
BODY="$(printf '%s\n\n<!-- disposition:v1 %s -->' "$REPLY" "$MARKER")"

_resolve_thread() {
    local thread_id="$1"
    gh api graphql -f threadId="$thread_id" -f query='
        mutation($threadId: ID!) {
            resolveReviewThread(input: {threadId: $threadId}) {
                thread { id isResolved }
            }
        }'
}

_post_reply() {
    local thread_id="$1" body="$2"
    gh api graphql -f threadId="$thread_id" -f body="$body" -f query='
        mutation($threadId: ID!, $body: String!) {
            addPullRequestReviewThreadReply(input: {pullRequestReviewThreadId: $threadId, body: $body}) {
                comment { id }
            }
        }'
}

if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "DRY-RUN disposition for PR #$PR thread $THREAD (class=$CLASS, by=$BY, observed_head=$HEAD)"
    echo "--- reply body ---"
    printf '%s\n' "$BODY"
    echo "--- then: resolveReviewThread($THREAD) ---"
    exit 0
fi

# Stable idempotency: establish the existing thread state before any mutation.
# Provider, JSON, or marker-parser failure is NOT equivalent to a proven zero
# match; fail closed so an unavailable observation cannot create a duplicate
# reply and immediately resolve the thread.
THREAD_RESPONSE=""
if ! THREAD_RESPONSE="$(gh api graphql -f threadId="$THREAD" -f query='
    query($threadId: ID!) {
        node(id: $threadId) {
            ... on PullRequestReviewThread {
                isResolved
                comments(last: 50) { nodes { body } }
            }
        }
    }' 2>&1)"; then
    echo "ERROR: failed to read disposition state for thread $THREAD: $THREAD_RESPONSE" >&2
    exit 2
fi

MARKER_STATE=""
if ! MARKER_STATE="$(jq -ce --arg class "$CLASS" --argjson evidence "$EVIDENCE" '
    (.data.node // empty) as $node
    | if (($node | type) != "object") or ((($node.comments.nodes // null) | type) != "array") then
        error("invalid review-thread response")
      else
        [
          $node.comments.nodes[]?.body // ""
          | split("\n")[]
          | select(startswith("<!-- disposition:v1 ") and endswith(" -->"))
          | ltrimstr("<!-- disposition:v1 ")
          | rtrimstr(" -->")
        ] as $raw
        | [$raw[] | try fromjson catch null] as $parsed
        | {
            invalid: ([$parsed[] | select(. == null)] | length),
            matching: ([
              $parsed[]
              | select(. != null and .class == $class and .evidence == $evidence)
            ] | length)
          }
      end
' <<<"$THREAD_RESPONSE" 2>/dev/null)"; then
    echo "ERROR: invalid disposition state for thread $THREAD" >&2
    exit 2
fi

INVALID="$(jq -r '.invalid' <<<"$MARKER_STATE")"
EXISTING="$(jq -r '.matching' <<<"$MARKER_STATE")"
if [[ ! "$INVALID" =~ ^[0-9]+$ || ! "$EXISTING" =~ ^[0-9]+$ ]]; then
    echo "ERROR: non-numeric disposition state for thread $THREAD" >&2
    exit 2
fi
if [[ "$INVALID" -gt 0 ]]; then
    echo "ERROR: thread $THREAD contains $INVALID malformed disposition marker(s); refusing mutation" >&2
    exit 2
fi

if [[ "$EXISTING" -gt 0 ]]; then
    echo "OK matching disposition already exists on thread $THREAD (class=$CLASS, evidence=$EVIDENCE) — re-resolving without duplicate reply"
else
    if ! _post_reply "$THREAD" "$BODY" >/dev/null; then
        echo "ERROR: failed to post disposition reply to thread $THREAD" >&2
        exit 2
    fi
    echo "OK posted disposition reply (class=$CLASS, evidence=$EVIDENCE) to thread $THREAD"
fi

if ! _resolve_thread "$THREAD" >/dev/null; then
    echo "ERROR: failed to resolve thread $THREAD after disposition" >&2
    exit 2
fi

echo "OK resolved thread $THREAD (class=$CLASS, evidence=$EVIDENCE, observed_head=$HEAD)"
