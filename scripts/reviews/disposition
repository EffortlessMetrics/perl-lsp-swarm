#!/usr/bin/env bash
# scripts/reviews/disposition — evidence-backed review-thread disposition.
#
# Reply with evidence, then apply the disposition's truthful thread transition.
# Terminal dispositions resolve; current blockers and NOT_PROVEN remain open.
# Idempotency is based on stable finding identity (the GitHub thread),
# disposition class, and evidence identity. The observed PR head is forensic
# metadata; unrelated head movement does not create another disposition reply.
set -euo pipefail

die_usage() { echo "ERROR: $1" >&2; exit 2; }

PR="" THREAD="" CLASS="" REPLY="" COMMIT="" ISSUE="" SUPERSEDED_BY="" ARGUMENT=""
REPO="" HEAD="" BY="" DRY_RUN=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --pr)            PR="${2:-}"; shift 2 ;;
        --thread)        THREAD="${2:-}"; shift 2 ;;
        --class)         CLASS="${2:-}"; shift 2 ;;
        --reply)         REPLY="${2:-}"; shift 2 ;;
        --commit)        COMMIT="${2:-}"; shift 2 ;;
        --issue)         ISSUE="${2:-}"; shift 2 ;;
        --superseded-by) SUPERSEDED_BY="${2:-}"; shift 2 ;;
        --argument)      ARGUMENT="${2:-}"; shift 2 ;;
        --repo)          REPO="${2:-}"; shift 2 ;;
        --head)          HEAD="${2:-}"; shift 2 ;;
        --by)            BY="${2:-}"; shift 2 ;;
        --dry-run)       DRY_RUN=1; shift ;;
        *) die_usage "unknown argument: $1" ;;
    esac
done

[[ -n "$PR" ]]     || die_usage "--pr is required"
[[ -n "$THREAD" ]] || die_usage "--thread is required"
[[ -n "$CLASS" ]]  || die_usage "--class is required"
[[ -n "$REPLY" ]]  || die_usage "--reply is required"
command -v jq >/dev/null 2>&1 || die_usage "jq not found on PATH"

positive_issue() {
    [[ "$ISSUE" =~ ^[0-9]+$ && "$ISSUE" -gt 0 ]]
}

EVIDENCE=""
THREAD_TRANSITION=""
case "$CLASS" in
    fixed)
        [[ -n "$COMMIT" ]] || die_usage "class=fixed requires --commit <sha>"
        EVIDENCE="$(jq -cn --arg c "$COMMIT" '{commit:$c}')"
        THREAD_TRANSITION="resolve"
        ;;
    refuted)
        [[ -n "$ARGUMENT" ]] || die_usage "class=refuted requires --argument <text>"
        EVIDENCE="$(jq -cn --arg a "$ARGUMENT" '{argument:$a}')"
        THREAD_TRANSITION="resolve"
        ;;
    superseded)
        [[ -n "$SUPERSEDED_BY" ]] || die_usage "class=superseded requires --superseded-by <n|url>"
        EVIDENCE="$(jq -cn --arg s "$SUPERSEDED_BY" '{superseded_by:$s}')"
        THREAD_TRANSITION="resolve"
        ;;
    post-merge-follow-up)
        positive_issue || die_usage "class=post-merge-follow-up requires --issue <positive-integer>"
        [[ -n "$ARGUMENT" ]] || die_usage "class=post-merge-follow-up requires --argument <why the current claim is already satisfied>"
        EVIDENCE="$(jq -cn --argjson i "$ISSUE" --arg a "$ARGUMENT" '{issue:$i,argument:$a}')"
        THREAD_TRANSITION="resolve"
        ;;
    current-blocker)
        [[ -n "$ARGUMENT" ]] || die_usage "class=current-blocker requires --argument <current defect and required repair>"
        EVIDENCE="$(jq -cn --arg a "$ARGUMENT" '{argument:$a}')"
        THREAD_TRANSITION="keep_open"
        ;;
    blocked-by-prerequisite)
        positive_issue || die_usage "class=blocked-by-prerequisite requires --issue <positive-integer>"
        [[ -n "$ARGUMENT" ]] || die_usage "class=blocked-by-prerequisite requires --argument <why the defect remains current>"
        EVIDENCE="$(jq -cn --argjson i "$ISSUE" --arg a "$ARGUMENT" '{issue:$i,argument:$a}')"
        THREAD_TRANSITION="keep_open"
        ;;
    not-proven)
        [[ -n "$ARGUMENT" ]] || die_usage "class=not-proven requires --argument <missing or contradictory evidence>"
        EVIDENCE="$(jq -cn --arg a "$ARGUMENT" '{argument:$a}')"
        THREAD_TRANSITION="keep_open"
        ;;
    follow-up)
        die_usage "class=follow-up is ambiguous; use post-merge-follow-up when the current claim is already satisfied, or current-blocker/blocked-by-prerequisite when the defect remains"
        ;;
    *)
        die_usage "invalid --class '$CLASS' (fixed|refuted|superseded|post-merge-follow-up|current-blocker|blocked-by-prerequisite|not-proven)"
        ;;
esac

if [[ "$DRY_RUN" -eq 0 ]]; then
    command -v gh >/dev/null 2>&1 || die_usage "gh not found on PATH (required unless --dry-run)"
    [[ -n "$REPO" ]] || REPO="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"
    [[ -n "$HEAD" ]] || HEAD="$(gh pr view "$PR" --repo "$REPO" --json headRefOid --jq .headRefOid)"
    [[ -n "$BY" ]]   || BY="$(gh api user --jq .login 2>/dev/null || echo unknown)"
else
    [[ -n "$HEAD" ]] || HEAD="DRYRUN-HEAD"
    [[ -n "$BY" ]]   || BY="dryrun-actor"
fi

# Keep the v1 marker envelope readable by historical parsers. The added
# thread_transition field makes the intended GitHub state explicit without
# changing existing class/evidence identity. `head` remains forensic metadata.
MARKER="$(jq -cn \
    --arg class "$CLASS" --arg tid "$THREAD" --arg by "$BY" --arg head "$HEAD" \
    --arg transition "$THREAD_TRANSITION" --argjson ev "$EVIDENCE" \
    '{v:1,class:$class,thread_id:$tid,by:$by,head:$head,evidence:$ev,thread_transition:$transition}')"
BODY="$(printf '%s\n\n<!-- disposition:v1 %s -->' "$REPLY" "$MARKER")"

_resolve_thread() {
    local thread_id="$1"
    gh api graphql -f threadId="$thread_id" -f query='
        mutation($threadId: ID!) {
            resolveReviewThread(input: {threadId: $threadId}) {
                thread { id isResolved }
            }
        }' | jq -e '.data.resolveReviewThread.thread.isResolved == true' >/dev/null
}

_unresolve_thread() {
    local thread_id="$1"
    gh api graphql -f threadId="$thread_id" -f query='
        mutation($threadId: ID!) {
            unresolveReviewThread(input: {threadId: $threadId}) {
                thread { id isResolved }
            }
        }' | jq -e '.data.unresolveReviewThread.thread.isResolved == false' >/dev/null
}

_post_reply() {
    local thread_id="$1" body="$2"
    gh api graphql -f threadId="$thread_id" -f body="$body" -f query='
        mutation($threadId: ID!, $body: String!) {
            addPullRequestReviewThreadReply(input: {pullRequestReviewThreadId: $threadId, body: $body}) {
                comment { id }
            }
        }'
}

if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "DRY-RUN disposition for PR #$PR thread $THREAD (class=$CLASS, transition=$THREAD_TRANSITION, by=$BY, observed_head=$HEAD)"
    echo "--- reply body ---"
    printf '%s\n' "$BODY"
    if [[ "$THREAD_TRANSITION" == "resolve" ]]; then
        echo "--- then: resolveReviewThread($THREAD) ---"
    else
        echo "--- then: keep thread unresolved; if currently resolved, unresolveReviewThread($THREAD) BEFORE posting the reply, and enforce unresolved again after posting ---"
    fi
    exit 0
fi

# Stable idempotency: establish the existing thread state before any mutation.
# Provider, JSON, or marker-parser failure is NOT equivalent to a proven zero
# match; fail closed so unavailable observation cannot create a duplicate reply
# or apply the wrong thread transition.
THREAD_RESPONSE=""
if ! THREAD_RESPONSE="$(gh api graphql -f threadId="$THREAD" -f query='
    query($threadId: ID!) {
        node(id: $threadId) {
            ... on PullRequestReviewThread {
                isResolved
                comments(last: 50) { nodes { body } }
            }
        }
    }' 2>&1)"; then
    echo "ERROR: failed to read disposition state for thread $THREAD: $THREAD_RESPONSE" >&2
    exit 2
fi

MARKER_STATE=""
if ! MARKER_STATE="$(jq -ce --arg class "$CLASS" --argjson evidence "$EVIDENCE" '
    (.data.node // empty) as $node
    | if (($node | type) != "object") or ((($node.comments.nodes // null) | type) != "array") then
        error("invalid review-thread response")
      else
        [
          $node.comments.nodes[]?.body // ""
          | split("\n")[]
          | select(startswith("<!-- disposition:v1 ") and endswith(" -->"))
          | ltrimstr("<!-- disposition:v1 ")
          | rtrimstr(" -->")
        ] as $raw
        | [$raw[] | try fromjson catch null] as $parsed
        | {
            invalid: ([$parsed[] | select(. == null)] | length),
            matching: ([
              $parsed[]
              | select(. != null and .class == $class and .evidence == $evidence)
            ] | length),
            is_resolved: ($node.isResolved == true)
          }
      end
' <<<"$THREAD_RESPONSE" 2>/dev/null)"; then
    echo "ERROR: invalid disposition state for thread $THREAD" >&2
    exit 2
fi

INVALID="$(jq -r '.invalid' <<<"$MARKER_STATE")"
EXISTING="$(jq -r '.matching' <<<"$MARKER_STATE")"
IS_RESOLVED="$(jq -r '.is_resolved' <<<"$MARKER_STATE")"
if [[ ! "$INVALID" =~ ^[0-9]+$ || ! "$EXISTING" =~ ^[0-9]+$ || ! "$IS_RESOLVED" =~ ^(true|false)$ ]]; then
    echo "ERROR: invalid disposition state values for thread $THREAD" >&2
    exit 2
fi
if [[ "$INVALID" -gt 0 ]]; then
    echo "ERROR: thread $THREAD contains $INVALID malformed disposition marker(s); refusing mutation" >&2
    exit 2
fi

# For a live blocker, restore truthful GitHub state before doing anything that
# can fail. If evidence posting later fails, the thread remains visibly open
# rather than falling back to the falsely-clean state this command repairs.
REOPENED=0
if [[ "$THREAD_TRANSITION" == "keep_open" && "$IS_RESOLVED" == "true" ]]; then
    if ! _unresolve_thread "$THREAD" >/dev/null; then
        echo "ERROR: failed to reopen thread $THREAD before recording non-terminal disposition" >&2
        exit 2
    fi
    REOPENED=1
fi

if [[ "$EXISTING" -gt 0 ]]; then
    echo "OK matching disposition already exists on thread $THREAD (class=$CLASS, evidence=$EVIDENCE) — reapplying transition without duplicate reply"
else
    if ! _post_reply "$THREAD" "$BODY" >/dev/null; then
        echo "ERROR: failed to post disposition reply to thread $THREAD" >&2
        exit 2
    fi
    echo "OK posted disposition reply (class=$CLASS, transition=$THREAD_TRANSITION, evidence=$EVIDENCE) to thread $THREAD"
fi

if [[ "$THREAD_TRANSITION" == "resolve" ]]; then
    if ! _resolve_thread "$THREAD" >/dev/null; then
        echo "ERROR: failed to resolve thread $THREAD after terminal disposition" >&2
        exit 2
    fi
    echo "OK resolved thread $THREAD (class=$CLASS, evidence=$EVIDENCE, observed_head=$HEAD)"
    exit 0
fi

# Close the race window: the initial isResolved observation is stale the moment
# it returns, so a concurrent resolve could otherwise leave this command
# reporting success while the live blocker sits resolved. Enforce the final
# state after posting; unresolve is idempotent on an already-open thread.
if ! _unresolve_thread "$THREAD" >/dev/null; then
    echo "ERROR: failed to enforce unresolved state on thread $THREAD after non-terminal disposition" >&2
    exit 2
fi

if [[ "$REOPENED" -eq 1 ]]; then
    echo "OK reopened thread $THREAD (class=$CLASS, evidence=$EVIDENCE, observed_head=$HEAD)"
else
    echo "OK kept thread $THREAD unresolved (class=$CLASS, evidence=$EVIDENCE, observed_head=$HEAD)"
fi
