#!/usr/bin/env python3
"""Read complete PR feedback for content judgment, never a merge/review verdict.

Reuse the sanctioned paginated thread enumerator for resolution identity. REST
pagination supplies full inline messages/replies, ordinary issue comments, and all
submitted review bodies (not latestReviews). No text heuristic decides whether a
concern was repaired, superseded, or refuted; that remains the invoking skill's job.
"""
import argparse
import json
from pathlib import Path
import re
import subprocess
import sys


def stderr_diagnostic(stderr):
    """Classify a bounded prefix without publishing arbitrary child text.

    These are reported symptoms, not a transient/retryability verdict. Unknown
    output stays opaque because URLs, headers and feedback can contain secrets.
    """
    text = stderr or ''
    if isinstance(text, bytes):
        text = text.decode('utf-8', errors='replace')
    sample = text[:8192]
    truncated = len(text) > len(sample)
    for kind, pattern, summary in (
        ('access_denied',
         r'\b(?:forbidden|unauthorized|permission denied|access denied|'
         r'authentication failed|resource not accessible)\b|\bHTTP\s+(?:401|403)\b',
         'Child stderr reports an authentication or permission denial.'),
        ('transport_error',
         r'\b(?:timed? out|timeout|could not resolve|no such host|'
         r'connection reset|connection refused|network is unreachable|'
         r'temporary failure in name resolution|TLS handshake)\b',
         'Child stderr reports a network or timeout error; retryability is unknown.'),
    ):
        if re.search(pattern, sample, re.IGNORECASE):
            return {'kind': kind, 'summary': summary, 'truncated': truncated}
    kind = 'unrecognized' if sample.strip() else 'empty'
    summary = ('Unrecognized child stderr omitted.' if sample.strip()
               else 'Child supplied no non-whitespace stderr in the scanned prefix.')
    return {'kind': kind, 'summary': summary, 'truncated': truncated}


class FeedbackCommandFailure(RuntimeError):
    def __init__(self, operation, command, error):
        super().__init__(operation)
        # Describe only known command shapes, never arbitrary argv/error.cmd.
        if command[:2] == ['gh', 'api']:
            display = 'gh api'
        elif len(command) > 1 and Path(command[1]).name == 'threads':
            display = 'bash scripts/reviews/threads'
        else:
            display = 'child process'
        self.diagnostic = {'operation': operation, 'command': display,
                           'exit_code': error.returncode,
                           'stderr': stderr_diagnostic(error.stderr)}


def read_json(command, *, operation='json-read'):
    try:
        # Preserve exit status before decoding: malformed child output must not
        # replace a nonzero-exit diagnostic with an early UnicodeDecodeError.
        result = subprocess.run(command, check=True, capture_output=True)
    except subprocess.CalledProcessError as error:
        raise FeedbackCommandFailure(operation, command, error) from error
    stdout = result.stdout.decode('utf-8')
    result.stderr.decode('utf-8')  # Preserve strict decoding of successful streams.
    return json.loads(stdout)


def pages(repo, endpoint, *, operation='feedback-pages'):
    raw = read_json(["gh", "api", "--paginate", "--slurp",
                     f"repos/{repo}/{endpoint}?per_page=100"], operation=operation)
    if not isinstance(raw, list) or not raw or not all(isinstance(p, list) for p in raw):
        raise ValueError("expected complete slurped REST pages")
    rows = [row for page in raw for row in page]
    for row in rows:
        if (not isinstance(row, dict) or not isinstance(row.get("id"), int)
                or not isinstance(row.get("body"), str)
                or not isinstance(row.get("html_url"), str)):
            raise ValueError("feedback omitted identity, URL, or full body")
    if len({row["id"] for row in rows}) != len(rows):
        raise ValueError("duplicate feedback identity across pages")
    return rows


def collect(pr, repo):
    def head(operation):
        metadata = read_json(["gh", "api", f"repos/{repo}/pulls/{pr}"], operation=operation)
        value = metadata["head"]["sha"]
        if not isinstance(value, str) or len(value) != 40:
            raise ValueError("missing PR head identity")
        return value

    before = head('head-before')
    threads = read_json(["bash", str(Path(__file__).with_name("threads")),
                         str(pr), repo, "--json"], operation='review-threads')
    if not isinstance(threads.get("threads"), list) or not isinstance(threads.get("unresolved_count"), int):
        raise ValueError("incomplete thread inventory")
    inline = pages(repo, f"pulls/{pr}/comments", operation='inline-comments')
    comments = pages(repo, f"issues/{pr}/comments", operation='issue-comments')
    reviews = pages(repo, f"pulls/{pr}/reviews", operation='reviews')
    if head('head-after') != before:
        raise ValueError("PR head moved during feedback acquisition; reacquire")
    return {
        "schema_version": "pr_feedback.v1", "pr": pr, "repo": repo,
        "observed_head": before, "acquisition_mode": "gh_live",
        "threads": threads, "inline_comments": inline,
        "issue_comments": comments, "reviews": reviews,
        "review_currentness": "NOT_PROVEN",
        "next_step": "address-review-comments",
        "content_judgment_required": True,
        "prompt": "Read full bodies and replies, including COMMENTED reviews. Zero unresolved threads does not dispose ordinary-comment findings. Verify dispositions and semantic currentness before live CI.",
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("pr", type=int)
    parser.add_argument("repo", help="owner/repo")
    args = parser.parse_args()
    try:
        result = collect(args.pr, args.repo)
    except (FeedbackCommandFailure, subprocess.CalledProcessError,
            OSError, ValueError, KeyError, TypeError) as error:
        # Do not echo raw API output or credentials from child diagnostics.
        result = {"schema_version": "pr_feedback.v1", "pr": args.pr,
                  "repo": args.repo, "review_currentness": "NOT_PROVEN",
                  "next_step": "repair-feedback-acquisition",
                  "reason": 'CalledProcessError' if isinstance(error, FeedbackCommandFailure)
                  else type(error).__name__}
        if isinstance(error, FeedbackCommandFailure):
            result['command_failure'] = error.diagnostic
        print(json.dumps(result))
        return 2
    print(json.dumps(result))
    return 0


if __name__ == "__main__":
    sys.exit(main())
