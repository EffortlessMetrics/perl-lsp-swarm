#!/usr/bin/env bash
# scripts/reviews/threads — READ-ONLY enumeration of one PR's review threads (#6178).
#
# `scripts/reviews/disposition` is the only sanctioned resolve path and it
# REQUIRES `--thread <threadId>`. Nothing told an agent where that ID comes
# from: `scripts/reviews/state` returns an aggregate classification with no
# per-thread identity, and the one `reviewThreads` query in the repo lives
# inside `scripts/ci/check-pr-review-convergence-core`, which is a verdict gate
# and never emits IDs. So every agent hand-rolled its own GraphQL, or skipped
# dispositioning and left the PR parked at FINDINGS_OPEN.
#
# This script is that missing input. Its output feeds `disposition --thread`
# unchanged.
#
# It is strictly read-only: one paged GraphQL query, no mutation of any kind.
# Resolution stays exclusively in `scripts/reviews/disposition` (#3693 R1
# FILE 3) — this script deliberately contains no resolve mutation.
#
# ── Usage ────────────────────────────────────────────────────────────────────
#   scripts/reviews/threads <pr-number> [owner/repo] [--unresolved-only] [--json]
#
#   --unresolved-only  emit only threads with isResolved == false (the set that
#                      actually blocks the merge — GitHub's conversation-
#                      resolution rule ignores isOutdated, see #3679)
#   --json             machine-readable object on stdout instead of the
#                      human-readable listing
#
# If [owner/repo] is omitted it is resolved from the current checkout via
# `gh repo view`.
#
# ── Output (--json) ──────────────────────────────────────────────────────────
#   {
#     "pr": 1234, "repo": "owner/name",
#     "thread_count": N,          # after --unresolved-only filtering
#     "unresolved_count": N, "unresolved_active": N, "unresolved_outdated": N,
#     "threads": [ { "id", "isResolved", "isOutdated", "path",
#                    "line", "line_is_original", "originalLine", "startLine",
#                    "diffSide", "author", "url", "excerpt" } ]
#   }
#
# `id` is the GraphQL node ID that `disposition --thread` accepts. `line` is
# the current diff line, falling back to `originalLine` for an outdated thread
# whose hunk no longer exists at HEAD (`line_is_original` records which).
#
# ── Exit codes ───────────────────────────────────────────────────────────────
#   0 enumeration succeeded (including the zero-thread case)
#   2 usage error, missing gh/jq, or GraphQL fetch failure
set -euo pipefail

die_usage() { echo "ERROR: $1" >&2; exit 2; }

PR="" REPO_ARG="" UNRESOLVED_ONLY=0 AS_JSON=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --unresolved-only) UNRESOLVED_ONLY=1; shift ;;
        --json)            AS_JSON=1; shift ;;
        -h|--help)         sed -n '2,50p' "${BASH_SOURCE[0]}"; exit 0 ;;
        -*)                die_usage "unknown argument: $1" ;;
        *)
            if [[ -z "$PR" ]]; then PR="$1"
            elif [[ -z "$REPO_ARG" ]]; then REPO_ARG="$1"
            else die_usage "unexpected positional argument: $1"
            fi
            shift
            ;;
    esac
done

[[ -n "$PR" ]] || die_usage "usage: $0 <pr-number> [owner/repo] [--unresolved-only] [--json]"
[[ "$PR" =~ ^[0-9]+$ ]] || die_usage "<pr-number> must be a positive integer (got '$PR')"
command -v jq >/dev/null 2>&1 || die_usage "jq not found on PATH"
command -v gh >/dev/null 2>&1 || die_usage "gh not found on PATH"

REPO="$REPO_ARG"
if [[ -z "$REPO" ]]; then
    REPO="$(gh repo view --json nameWithOwner --jq .nameWithOwner)" \
        || die_usage "could not resolve owner/repo from the current checkout; pass it explicitly"
fi
[[ "$REPO" == */* ]] || die_usage "[owner/repo] must look like owner/name (got '$REPO')"
OWNER="${REPO%%/*}"
NAME="${REPO##*/}"

PAGE_SIZE="${REVIEW_THREADS_PAGE_SIZE:-50}"

WORK_DIR="$(mktemp -d)"
trap 'rm -rf "$WORK_DIR"' EXIT

# ── Paged fetch ─────────────────────────────────────────────────────────────
# PRs in this repo routinely exceed one page of review threads. Reading only
# the first page would hand the agent a truncated list, it would disposition a
# subset, and the PR would stay BLOCKED on threads it never saw.
#
# Pages accumulate in a FILE, never in an argv-passed variable. Bot review
# bodies are long: a real 12-thread PR already produces enough JSON that
# `jq --argjson accumulator "$SO_FAR"` dies with "Argument list too long",
# which is a silent-truncation-shaped failure mode on exactly the large PRs
# that need this script most. Every jq handoff below therefore goes through a
# file or stdin.
PAGES_FILE="$WORK_DIR/pages.json"
: > "$PAGES_FILE"
CURSOR="null"
HAS_NEXT="true"
while [[ "$HAS_NEXT" == "true" ]]; do
    AFTER_ARG=""
    [[ "$CURSOR" == "null" ]] || AFTER_ARG=", after: \"$CURSOR\""

    QUERY=$(cat <<EOF
query {
  repository(owner: "$OWNER", name: "$NAME") {
    pullRequest(number: $PR) {
      reviewThreads(first: $PAGE_SIZE$AFTER_ARG) {
        nodes {
          id
          isResolved
          isOutdated
          path
          line
          originalLine
          startLine
          originalStartLine
          diffSide
          comments(first: 1) {
            nodes { author { login } body url }
          }
        }
        pageInfo { hasNextPage endCursor }
      }
    }
  }
}
EOF
)
    PAGE_FILE="$WORK_DIR/page.json"
    if ! gh api graphql -f query="$QUERY" > "$PAGE_FILE" 2>"$WORK_DIR/page.err"; then
        echo "ERROR: GraphQL fetch failed for reviewThreads on $REPO#$PR:" >&2
        cat "$WORK_DIR/page.err" "$PAGE_FILE" >&2 || true
        exit 2
    fi
    if ! jq -ce '.data.repository.pullRequest.reviewThreads.nodes' "$PAGE_FILE" >> "$PAGES_FILE"; then
        echo "ERROR: unexpected GraphQL response for $REPO#$PR:" >&2
        head -c 2000 "$PAGE_FILE" >&2
        exit 2
    fi

    HAS_NEXT="$(jq -r '.data.repository.pullRequest.reviewThreads.pageInfo.hasNextPage' "$PAGE_FILE")"
    CURSOR="$(jq -r '.data.repository.pullRequest.reviewThreads.pageInfo.endCursor // "null"' "$PAGE_FILE")"
    # "more pages exist" + "no cursor to fetch them with" is the ONE shape in
    # which this script could return a truncated list while exiting 0 — the
    # exact failure it exists to prevent. Fail loudly instead of stopping quietly.
    if [[ "$HAS_NEXT" == "true" && "$CURSOR" == "null" ]]; then
        echo "ERROR: $REPO#$PR reported more review-thread pages but returned no cursor;" >&2
        echo "       refusing to report a possibly truncated thread list." >&2
        exit 2
    fi
done

# ── Projection ──────────────────────────────────────────────────────────────
PROJECTED_FILE="$WORK_DIR/projected.json"
jq -c --argjson unresolved_only "$UNRESOLVED_ONLY" -s 'add // []
    |
    def excerpt:
        (. // "")
        | gsub("\r"; "")
        | gsub("<!--(.|\n)*?-->"; "")
        | split("\n")
        | map(select(test("[^[:space:]]")))
        | (.[0] // "")
        | sub("^[[:space:]]+"; "") | sub("[[:space:]]+$"; "")
        | if length > 120 then .[0:117] + "..." else . end;
    map({
        id: .id,
        isResolved: (.isResolved // false),
        isOutdated: (.isOutdated // false),
        path: (.path // null),
        line: (.line // .originalLine),
        line_is_original: (.line == null and .originalLine != null),
        originalLine: .originalLine,
        startLine: (.startLine // .originalStartLine),
        diffSide: (.diffSide // "RIGHT"),
        author: (.comments.nodes[0].author.login // "unknown"),
        url: (.comments.nodes[0].url // null),
        excerpt: (.comments.nodes[0].body | excerpt)
    })
    | if $unresolved_only == 1 then map(select(.isResolved == false)) else . end
' "$PAGES_FILE" > "$PROJECTED_FILE"

SUMMARY_FILE="$WORK_DIR/summary.json"
jq -n --slurpfile projected "$PROJECTED_FILE" --arg pr "$PR" --arg repo "$REPO" '
    ($projected[0] // []) as $t | {
    pr: ($pr | tonumber),
    repo: $repo,
    thread_count: ($t | length),
    unresolved_count: ([$t[] | select(.isResolved == false)] | length),
    unresolved_active: ([$t[] | select(.isResolved == false and .isOutdated == false)] | length),
    unresolved_outdated: ([$t[] | select(.isResolved == false and .isOutdated == true)] | length),
    threads: $t
}' > "$SUMMARY_FILE"

if [[ "$AS_JSON" -eq 1 ]]; then
    jq . "$SUMMARY_FILE"
    exit 0
fi

# ── Human-readable listing ──────────────────────────────────────────────────
jq -r --arg repo "$REPO" --arg pr "$PR" --argjson filtered "$UNRESOLVED_ONLY" '
    "\($repo)#\($pr) — \(.thread_count) review thread(s)"
      + (if $filtered == 1 then " (unresolved only)" else "" end)
      + ": \(.unresolved_count) unresolved (\(.unresolved_active) active, \(.unresolved_outdated) outdated), "
      + "\(.thread_count - .unresolved_count) resolved",
    "",
    (.threads[]
      | "  \(.id)",
        "      \(if .isResolved then "RESOLVED  " else "UNRESOLVED" end) "
          + "\(if .isOutdated then "outdated" else "active  " end)  "
          + "\(.path // "(no file)"):\(.line // "?")"
          + (if .line_is_original then " (originalLine)" else "" end)
          + "  @\(.author)",
        "      \(.excerpt)",
        ""
    )
' "$SUMMARY_FILE"

UNRESOLVED="$(jq -r '.unresolved_count' "$SUMMARY_FILE")"
if [[ "$UNRESOLVED" -gt 0 ]]; then
    cat <<EOF
Resolve each unresolved thread through the sanctioned path (reply-with-evidence,
then resolve — never a raw resolve API):

  scripts/reviews/disposition --pr $PR --repo $REPO --thread <id> \\
      --class fixed --commit <sha> --reply 'Disposition: fixed
Evidence: <claim-bounded evidence>'

Classes: fixed (--commit) | refuted (--argument) | superseded (--superseded-by) | follow-up (--issue)
EOF
fi
exit 0
