#!/usr/bin/env bash
# Classify how a ripr evidence lane terminated, from its own job log only.
#
# Claims ownership: #12563 / #6807. A runner eviction (~10.5 min hosted kills,
# `The runner has received a shutdown signal`) converts into a false red on
# the required `ripr+ New Gap Gate` unless the absence of evidence is
# distinguished from negative evidence. This classifier is the shared,
# tested decision surface used by BOTH consumers:
#
#   - `.github/workflows/ripr.yml`   (result aggregator job `ripr`)
#   - `.github/workflows/ripr-retry.yml` (bounded same-head retry responder)
#   - `scripts/ci/ripr-bounded-retry`    (--decide decision table, shared)
#
# Decision boundary (audited on every application via callers echoing these
# outputs into their run logs):
#
#   1. A genuine ripr red ALWAYS outranks infra markers. If the lane printed
#      the terminal quality-gate receipt line ("quality gate failed; see
#      receipt ...", xtask/src/tasks/quality_gate.rs bail!), the analysis
#      completed and found gaps -> verdict `source-gap-terminal`. Such a log
#      must NEVER take the infra/retry path even if the runner was torn down
#      later during artifact upload.
#   2. Infra termination requires platform teardown evidence produced by the
#      runner itself, not by the analyzed workload:
#        - primary:   "The runner has received a shutdown signal"
#          -> `infra-eviction-shutdown-signal`
#        - secondary pair (alternate rendering of the same evictions):
#          "Process completed with exit code 143." AND
#          "The operation was canceled." -> `infra-eviction-sigterm-canceled`
#   3. Anything else is fail-closed: `no-terminal-receipt`. Callers must map
#      that to a blocking red (absence of evidence is not a pass), never to
#      success and never to a retry.
#   4. A log whose only marker is "The operation was canceled." (manual/API
#      cancellation rendering) is NOT auto-retry-eligible: combine it with
#      the lane result in the caller (`ripr-bounded-retry --decide`) which
#      yields the blocking, human-owned `cancelled-no-verdict` outcome.
#
# Output (machine-checkable; single line each):
#   verdict=<token>                        see tokens above
#   gap_receipt_matches=<n>
#   shutdown_signal_matches=<n>
#   sigterm143_matches=<n>
#   op_cancelled_matches=<n>
#   log_lines_scanned=<n>
#   partial_read=<true|false>              true when the size cap truncated
#   decision_boundary="<one-line summary>"
#
# Exit status is ALWAYS 0 for a performed classification (the verdict is the
# data); non-zero only signals misuse (bad arguments). Retrieval problems are
# reported as verdict=no-terminal-receipt with partial_read=false so callers
# fail closed deterministically.

set -u

usage() {
  printf 'usage: %s <logfile|-> [max_bytes]\n' "${0##*/}" >&2
}

MAX_BYTES_DEFAULT=$((16 * 1024 * 1024)) # bounded reads; logs are capped, not streamed whole

main() {
  if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    usage
    exit 64
  fi
  local input="$1"
  local max_bytes="${2:-$MAX_BYTES_DEFAULT}"
  case "$max_bytes" in
    ''|*[!0-9]*) usage; exit 64 ;;
  esac

  local tmp
  rc=0
  if ! tmp="$(mktemp)"; then
    classify_error "mktemp failed"
    return 0
  fi
  # Embed the resolved path now so the EXIT-time expansion cannot lose it.
  # shellcheck disable=SC2064  # expansion now is intended: fixed path
  trap 'rm -f "'"${tmp}"'"' EXIT

  if [ "$input" = "-" ]; then
    head -c "$max_bytes" >"$tmp" || true
  elif [ ! -f "$input" ]; then
    classify_error "log file not found: $input"
    return 0
  else
    head -c "$max_bytes" "$input" >"$tmp" || true
  fi

  # partial read detection: cap hit means we scanned a prefix only. A
  # truncated scan cannot prove absence of a receipt; `no-terminal-receipt`
  # below still fails closed, so a partial read never manufactures either a
  # green or a retry.
  local actual_size capped
  actual_size=$(wc -c <"$tmp" 2>/dev/null || printf '0')
  if [ "${input:-}" != "-" ] && [ -f "$input" ]; then
    local full_size
    full_size=$(wc -c <"$input" 2>/dev/null || printf '0')
    if [ "$full_size" -gt "$max_bytes" ]; then capped=true; else capped=false; fi
  else
    capped=false
  fi
  : "${actual_size:=0}"

  emit_verdict "$tmp" "$actual_size" "$capped" || rc=$?
  return 0
}

classify_error() {
  printf 'verdict=no-terminal-receipt\n'
  printf 'gap_receipt_matches=0\n'
  printf 'shutdown_signal_matches=0\n'
  printf 'sigterm143_matches=0\n'
  printf 'op_cancelled_matches=0\n'
  printf 'log_lines_scanned=0\n'
  printf 'partial_read=false\n'
  printf 'decision_boundary="retrieval failure fails closed to blocking red; infra and retry paths require positive teardown evidence"\n' >&2
  printf 'classification_error=%s\n' "$1" >&2
}

# grep guards: plain -c over a fully-read temp file; `|| true` because -c
# prints 0 with exit 1 when nothing matches. No SIGPIPE hazard here: input is
# a complete temp file (the aggregator formerly tripped pipefail streaming).
count_matches() {
  # $1=file $2=ere
  grep -cE "$2" "$1" 2>/dev/null || true
}

emit_verdict() {
  local file="$1" bytes="$2" capped="$3"
  local lines gap_hits shut_hits term143_hits cancel_hits verdict

  lines=$(wc -l <"$file" 2>/dev/null || printf '0')
  gap_hits=$(count_matches "$file" 'quality gate failed; see receipt')
  shut_hits=$(count_matches "$file" 'The runner has received a shutdown signal')
  term143_hits=$(count_matches "$file" 'Process completed with exit code 143\.')
  cancel_hits=$(count_matches "$file" 'The operation was canceled')

  if [ "$gap_hits" -gt 0 ]; then
    # Boundary rule 1: genuine terminal red outranks every infra marker.
    verdict="source-gap-terminal"
  elif [ "$shut_hits" -gt 0 ]; then
    verdict="infra-eviction-shutdown-signal"
  elif [ "$term143_hits" -gt 0 ] && [ "$cancel_hits" -gt 0 ]; then
    verdict="infra-eviction-sigterm-canceled"
  else
    verdict="no-terminal-receipt"
  fi

  printf 'verdict=%s\n' "$verdict"
  printf 'gap_receipt_matches=%s\n' "$gap_hits"
  printf 'shutdown_signal_matches=%s\n' "$shut_hits"
  printf 'sigterm143_matches=%s\n' "$term143_hits"
  printf 'op_cancelled_matches=%s\n' "$cancel_hits"
  printf 'log_lines_scanned=%s\n' "$lines"
  printf 'bytes_scanned=%s\n' "$bytes"
  printf 'partial_read=%s\n' "$capped"
  printf 'decision_boundary="genuine gap receipt outranks infra markers; retry requires positive runner-teardown evidence"\n'
}

main "$@"
