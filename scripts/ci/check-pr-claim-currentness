#!/usr/bin/env python3
"""Verify that a completed review-run receipt matches current head and material claim."""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path

REVIEWS_DIR = Path(__file__).resolve().parents[1] / "reviews"
sys.path.insert(0, str(REVIEWS_DIR))

from claim_digest import claim_digest  # noqa: E402

MARKER = re.compile(r"<!--\s*review-run:v1\s+(\{.*?\})\s*-->", re.DOTALL)


def _run(command: list[str]) -> str:
    completed = subprocess.run(command, check=False, capture_output=True, text=True)
    if completed.returncode != 0:
        raise RuntimeError(completed.stderr.strip() or "command failed")
    return completed.stdout


def _live_pr(pr: str, repo: str | None) -> tuple[str, str, str]:
    if not repo:
        repo = _run(["gh", "repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"]).strip()
    raw = _run(["gh", "pr", "view", pr, "--repo", repo, "--json", "headRefOid,body"])
    document = json.loads(raw)
    comments = _run(["gh", "api", "--paginate", f"repos/{repo}/issues/{pr}/comments", "--jq", ".[].body"])
    return document["headRefOid"], document.get("body") or "", comments


def _markers(comments: str) -> list[dict[str, object]]:
    records: list[dict[str, object]] = []
    for match in MARKER.finditer(comments):
        try:
            value = json.loads(match.group(1))
        except json.JSONDecodeError:
            continue
        if isinstance(value, dict):
            records.append(value)
    return records


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("pr", nargs="?", help="Pull-request number for live mode")
    parser.add_argument("--repo", help="owner/repo for live mode")
    parser.add_argument("--head", help="Expected/current head for fixture mode")
    parser.add_argument("--body-file", type=Path, help="PR-body fixture")
    parser.add_argument("--comments-file", type=Path, help="PR-comments fixture")
    parser.add_argument("--json", action="store_true")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    fixture_mode = args.body_file is not None or args.comments_file is not None or args.head is not None

    try:
        if fixture_mode:
            if not (args.body_file and args.comments_file and args.head):
                raise RuntimeError("fixture mode requires --head, --body-file, and --comments-file")
            head = args.head
            body = args.body_file.read_text(encoding="utf-8")
            comments = args.comments_file.read_text(encoding="utf-8")
        else:
            if not args.pr:
                raise RuntimeError("live mode requires a pull-request number")
            head, body, comments = _live_pr(args.pr, args.repo)
    except (OSError, RuntimeError, json.JSONDecodeError) as error:
        print(f"NOT_PROVEN: {error}", file=sys.stderr)
        return 2

    digest = str(claim_digest(body)["digest"])
    records = _markers(comments)
    matching = [
        record
        for record in records
        if record.get("status") == "done"
        and record.get("head") == head
        and record.get("claim_digest") == digest
    ]

    result = {
        "result": "current" if matching else "not_proven",
        "head": head,
        "claim_digest": digest,
        "matching_receipts": len(matching),
        "completed_receipts": sum(1 for record in records if record.get("status") == "done"),
    }

    if args.json:
        print(json.dumps(result, sort_keys=True))
    elif matching:
        print(f"claim review current: head={head} claim_digest={digest}")
    else:
        print(
            f"NOT_PROVEN: no completed review receipt matches head={head} claim_digest={digest}",
            file=sys.stderr,
        )

    return 0 if matching else 2


if __name__ == "__main__":
    raise SystemExit(main())
