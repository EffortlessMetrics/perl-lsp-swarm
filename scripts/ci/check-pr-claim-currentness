#!/usr/bin/env python3
"""Read historical review-run receipts in fixture mode only.

This compatibility parser no longer has live review-convergence authority. Direct
pull-request evaluation is retired; use scripts/ci/check-pr-review-convergence and the
provider-native review flow for current decisions.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import Any

REVIEWS_DIR = Path(__file__).resolve().parents[1] / "reviews"
sys.path.insert(0, str(REVIEWS_DIR))

from claim_digest import claim_digest, normalize_pr_body  # noqa: E402

MARKER_START = re.compile(r"<!--\s*review-run:v1\b")
TRUSTED_ASSOCIATIONS = {"OWNER", "MEMBER", "COLLABORATOR"}
REQUIRED_RECEIPT_FIELDS = {"v", "kind", "head", "reviewer", "status"}
ALLOWED_RECEIPT_FIELDS = REQUIRED_RECEIPT_FIELDS | {"claim_digest", "comment_id"}
REVIEW_KINDS = {"deep", "standard"}
REVIEW_STATUSES = {"running", "done"}
HISTORICAL_FIXTURE_EXIT = 3

RETIREMENT_MESSAGE = """RETIRED: live exact-head and claim-digest review verdicts are disabled.

Use the provider-native review flow and the public convergence wrapper:
  scripts/ci/check-pr-review-convergence <pr-number> [owner/repo]

Historical review-run.v1 markers remain readable only through explicit fixture inputs
for compatibility tests and incident analysis. A SHA may identify machine evidence or
protect the merge race; it is not the semantic review verdict.
"""


def _run(command: list[str]) -> str:
    completed = subprocess.run(command, check=False, capture_output=True, text=True)
    if completed.returncode != 0:
        raise RuntimeError(completed.stderr.strip() or "command failed")
    return completed.stdout


def _decode_json_stream(raw: str) -> list[Any]:
    decoder = json.JSONDecoder()
    cursor = 0
    values: list[Any] = []
    while cursor < len(raw):
        while cursor < len(raw) and raw[cursor].isspace():
            cursor += 1
        if cursor >= len(raw):
            break
        value, cursor = decoder.raw_decode(raw, cursor)
        values.append(value)
    return values


def _flatten_pages(values: list[Any]) -> list[dict[str, Any]]:
    comments: list[dict[str, Any]] = []
    for value in values:
        page = value if isinstance(value, list) else [value]
        for item in page:
            if isinstance(item, dict):
                comments.append(item)
    return comments


def _fixture_pr() -> tuple[str, str, list[dict[str, Any]]] | None:
    fixture = os.environ.get("CONVERGENCE_TEST_FIXTURE_DIR")
    if not fixture:
        return None
    root = Path(fixture)
    document = json.loads((root / "pr_view.json").read_text(encoding="utf-8"))
    comments_path = root / "pr_comments.json"
    comments = (
        json.loads(comments_path.read_text(encoding="utf-8"))
        if comments_path.exists()
        else []
    )
    if not isinstance(document, dict) or not isinstance(comments, list):
        raise RuntimeError("convergence fixtures must contain one PR object and a comments array")
    return (
        str(document["headRefOid"]),
        normalize_pr_body(document.get("body")),
        [item for item in comments if isinstance(item, dict)],
    )


def _read_pr_snapshot(pr: str, repo: str) -> tuple[str, str]:
    """Historical helper retained for compatibility-unit coverage only."""

    raw = _run(["gh", "pr", "view", pr, "--repo", repo, "--json", "headRefOid,body"])
    document = json.loads(raw)
    if not isinstance(document, dict) or not document.get("headRefOid"):
        raise RuntimeError("GitHub did not return a complete PR head/body snapshot")
    return str(document["headRefOid"]), normalize_pr_body(document.get("body"))


def _live_pr(pr: str, repo: str | None) -> tuple[str, str, list[dict[str, Any]]]:
    """Historical helper retained for compatibility-unit coverage only.

    The executable entry point never calls this function. It remains importable so the
    old snapshot-race parser can be tested without making it current authority.
    """

    fixture = _fixture_pr()
    if fixture is not None:
        return fixture

    if not repo:
        repo = _run(
            ["gh", "repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"]
        ).strip()

    first_head, first_body = _read_pr_snapshot(pr, repo)
    comments_raw = _run(
        ["gh", "api", "--paginate", f"repos/{repo}/issues/{pr}/comments?per_page=100"]
    )
    comments = _flatten_pages(_decode_json_stream(comments_raw))
    second_head, second_body = _read_pr_snapshot(pr, repo)
    if first_head != second_head or first_body != second_body:
        raise RuntimeError(
            "PR head or body changed while review comments were being loaded; retry against one fixed snapshot"
        )
    return second_head, second_body, comments


def _author_metadata(comment: dict[str, Any]) -> tuple[str, str]:
    user = comment.get("user")
    author = comment.get("author")
    login = ""
    if isinstance(user, dict):
        login = str(user.get("login") or "")
    elif isinstance(author, dict):
        login = str(author.get("login") or "")
    association = str(
        comment.get("author_association") or comment.get("authorAssociation") or ""
    ).upper()
    return login, association


def _valid_review_marker(value: dict[str, Any]) -> bool:
    """Apply the historical review-run.v1 wire contract."""

    keys = set(value)
    if not REQUIRED_RECEIPT_FIELDS.issubset(keys) or not keys.issubset(ALLOWED_RECEIPT_FIELDS):
        return False
    if value.get("v") != 1:
        return False
    if value.get("kind") not in REVIEW_KINDS:
        return False
    if not isinstance(value.get("head"), str):
        return False
    if not isinstance(value.get("reviewer"), str):
        return False
    if value.get("status") not in REVIEW_STATUSES:
        return False
    return (
        ("claim_digest" not in value or isinstance(value.get("claim_digest"), str))
        and ("comment_id" not in value or isinstance(value.get("comment_id"), str))
    )


def _count_invalid(association: str) -> tuple[int, int]:
    return (1, 0) if association in TRUSTED_ASSOCIATIONS else (0, 1)


def _markers(
    comments: list[dict[str, Any]],
) -> tuple[list[dict[str, Any]], int, int]:
    records: list[dict[str, Any]] = []
    invalid_trusted = 0
    invalid_untrusted = 0
    for comment in comments:
        login, association = _author_metadata(comment)
        body = normalize_pr_body(comment.get("body"))
        for start in MARKER_START.finditer(body):
            end = body.find("-->", start.end())
            if end < 0:
                trusted, untrusted = _count_invalid(association)
                invalid_trusted += trusted
                invalid_untrusted += untrusted
                break
            payload = body[start.end() : end].strip()
            try:
                value = json.loads(payload)
            except json.JSONDecodeError:
                trusted, untrusted = _count_invalid(association)
                invalid_trusted += trusted
                invalid_untrusted += untrusted
                continue
            if not isinstance(value, dict) or not _valid_review_marker(value):
                trusted, untrusted = _count_invalid(association)
                invalid_trusted += trusted
                invalid_untrusted += untrusted
                continue
            records.append(
                {
                    "marker": value,
                    "comment_id": str(comment.get("id") or ""),
                    "comment_author": login,
                    "author_association": association,
                    "trusted": association in TRUSTED_ASSOCIATIONS,
                }
            )
    return records, invalid_trusted, invalid_untrusted


def _fixture_comments(path: Path) -> list[dict[str, Any]]:
    value = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(value, list):
        raise RuntimeError("--comments-file must contain a structured JSON comments array")
    return [item for item in value if isinstance(item, dict)]


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "pr",
        nargs="?",
        help="retired live-mode argument; direct PR evaluation always fails closed",
    )
    parser.add_argument("--repo", help="retired live-mode argument")
    parser.add_argument("--head", help="historical fixture candidate head")
    parser.add_argument(
        "--expected-head",
        help="fixture-only expected head for historical race-protection tests",
    )
    parser.add_argument("--body-file", type=Path, help="historical PR-body fixture")
    parser.add_argument(
        "--comments-file",
        type=Path,
        help="historical structured PR-comments fixture",
    )
    parser.add_argument("--json", action="store_true")
    return parser


def _evaluate_fixture(args: argparse.Namespace) -> int:
    if not (args.body_file and args.comments_file and args.head):
        raise RuntimeError("fixture mode requires --head, --body-file, and --comments-file")

    head = args.head
    body = args.body_file.read_text(encoding="utf-8")
    comments = _fixture_comments(args.comments_file)

    if args.expected_head and head != args.expected_head:
        raise RuntimeError(
            "candidate moved while historical review receipts were being checked: "
            f"expected {args.expected_head}, observed {head}"
        )

    records, invalid_trusted_receipts, invalid_untrusted_receipts = _markers(comments)
    if not records and invalid_trusted_receipts == 0:
        result = {
            "result": "historical_not_applicable",
            "authority": "historical_fixture_only",
            "head": head,
            "claim_digest": None,
            "matching_receipts": 0,
            "completed_receipts": 0,
            "trusted_receipts": 0,
            "untrusted_receipts": 0,
            "invalid_receipts": invalid_untrusted_receipts,
            "invalid_trusted_receipts": 0,
            "invalid_untrusted_receipts": invalid_untrusted_receipts,
            "matching_authors": [],
        }
        if args.json:
            print(json.dumps(result, sort_keys=True))
        else:
            print(
                "historical claim review not applicable: "
                f"no review-run receipt exists at head={head}"
            )
        return HISTORICAL_FIXTURE_EXIT

    digest = str(claim_digest(body)["digest"])
    trusted = [record for record in records if record["trusted"]]
    matching = [
        record
        for record in trusted
        if record["marker"].get("status") == "done"
        and record["marker"].get("head") == head
        and record["marker"].get("claim_digest") == digest
        and record["marker"].get("comment_id") == record["comment_id"]
        and bool(record["comment_id"])
    ]

    result = {
        "result": (
            "historical_match"
            if matching and invalid_trusted_receipts == 0
            else "not_proven"
        ),
        "authority": "historical_fixture_only",
        "head": head,
        "claim_digest": digest,
        "matching_receipts": len(matching),
        "completed_receipts": sum(
            1 for record in records if record["marker"].get("status") == "done"
        ),
        "trusted_receipts": len(trusted),
        "untrusted_receipts": len(records) - len(trusted),
        "invalid_receipts": invalid_trusted_receipts + invalid_untrusted_receipts,
        "invalid_trusted_receipts": invalid_trusted_receipts,
        "invalid_untrusted_receipts": invalid_untrusted_receipts,
        "matching_authors": sorted(
            {str(record["comment_author"]) for record in matching if record["comment_author"]}
        ),
    }

    matched = bool(matching) and invalid_trusted_receipts == 0
    if args.json:
        print(json.dumps(result, sort_keys=True))
    elif matched:
        print(
            "historical claim receipt match: "
            f"head={head} claim_digest={digest} "
            f"trusted_authors={','.join(result['matching_authors'])}"
        )
    else:
        reason = (
            f"{invalid_trusted_receipts} invalid trusted review-run receipt(s) present"
            if invalid_trusted_receipts
            else "no trusted completed historical review receipt matches"
        )
        print(
            f"NOT_PROVEN: {reason} head={head} claim_digest={digest}",
            file=sys.stderr,
        )

    return HISTORICAL_FIXTURE_EXIT if matched else 1


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    fixture_mode = (
        args.body_file is not None or args.comments_file is not None or args.head is not None
    )

    if fixture_mode and (args.pr is not None or args.repo is not None):
        print(
            "NOT_PROVEN: live PR arguments cannot be combined with historical fixture arguments",
            file=sys.stderr,
        )
        return 2

    if not fixture_mode:
        print(RETIREMENT_MESSAGE, file=sys.stderr)
        return 2

    try:
        return _evaluate_fixture(args)
    except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as error:
        print(f"NOT_PROVEN: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
