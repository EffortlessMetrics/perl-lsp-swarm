#!/usr/bin/env bash
# check-pr-review-convergence — native GitHub review-fact convergence.
#
# This wrapper classifies native review requests, submitted-review presence,
# change requests, review threads, and disposition replies. It deliberately does
# NOT infer that a submitted human COMMENTED review is substantive or semantically
# current. Subject-bound semantic review is owned by
# check-pr-semantic-review-currentness.py.
set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "usage: $0 <pr-number> [owner/repo]" >&2
    exit 2
fi

PR="$1"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CORE="$SCRIPT_DIR/check-pr-review-convergence-core"

command -v jq >/dev/null 2>&1 || { echo "ERROR: jq not found on PATH" >&2; exit 2; }
[[ -x "$CORE" || -f "$CORE" ]] || { echo "ERROR: review convergence core not found at $CORE" >&2; exit 2; }

TMP_DIR="$(mktemp -d)"
cleanup() { rm -rf "$TMP_DIR"; }
trap cleanup EXIT

CORE_EXIT=0
# The core remains the paginated GitHub fact collector. Clear its legacy exact-head
# protocol enforcement; this wrapper classifies native facts and no more.
REVIEW_PROTOCOL_ENFORCE= bash "$CORE" "$@" >"$TMP_DIR/core.out" 2>"$TMP_DIR/core.err" || CORE_EXIT=$?
CORE_JSON="$(sed -n '/^{/,$p' "$TMP_DIR/core.out")"

not_proven() {
    local reason="$1"
    echo "NOT_PROVEN PR #$PR: $reason" >&2
    jq -n --arg pr "$PR" --arg reason "$reason" '{
      pr: ($pr | tonumber? // $pr),
      converged: false,
      native_review_facts_converged: false,
      review_currentness: "NOT_PROVEN",
      semantic_currentness_required: true,
      exact_head_review_required: false,
      material_claim_receipt_required: false,
      formal_review: {
        classification: "NOT_PROVEN",
        status: "unusable",
        reason: $reason
      }
    }'
    exit 2
}

if [[ "$CORE_EXIT" -ge 2 ]]; then
    cat "$TMP_DIR/core.err" >&2 || true
    not_proven "github_facts_unavailable"
fi

if [[ -z "$CORE_JSON" ]] || ! jq -e . >/dev/null 2>&1 <<<"$CORE_JSON"; then
    cat "$TMP_DIR/core.err" >&2 || true
    not_proven "invalid_fact_collector_output"
fi

get_num() {
    local selector="$1"
    local value
    if ! value="$(jq -r "$selector // 0" <<<"$CORE_JSON")"; then
        return 1
    fi
    [[ "$value" =~ ^[0-9]+$ ]] || return 1
    printf '%s\n' "$value"
}

load_num() {
    local target="$1"
    local selector="$2"
    local value
    if ! value="$(get_num "$selector")"; then
        not_proven "invalid_numeric_review_fact"
    fi
    printf -v "$target" '%s' "$value"
}

IS_DRAFT="$(jq -r '.is_draft // false' <<<"$CORE_JSON")"
load_num PENDING_REVIEWER_COUNT '.pending_reviewers | length'
REVIEW_DECISION="$(jq -r '.review_decision // ""' <<<"$CORE_JSON")"
load_num CURRENT_CHANGE_REQUEST_COUNT '.current_change_requests | length'
load_num UNRESOLVED_ACTIVE '.unresolved_active'
load_num UNRESOLVED_OUTDATED '.unresolved_outdated'
load_num UNRESOLVED_TOTAL '.unresolved_total'
load_num RESOLVED_WITHOUT_DISPOSITION '.resolved_without_disposition'
load_num HUMAN_REVIEW_COUNT '.human_review_count'
load_num DISMISSED_HUMAN_REVIEW_COUNT '.dismissed_human_review_count'
SUBMITTED_HUMAN_REVIEW_COUNT=$((HUMAN_REVIEW_COUNT - DISMISSED_HUMAN_REVIEW_COUNT))
if [[ "$SUBMITTED_HUMAN_REVIEW_COUNT" -lt 0 ]]; then
    SUBMITTED_HUMAN_REVIEW_COUNT=0
fi

CONVERGED=true
PENDING=false
FINDINGS_OPEN=false

if [[ "$IS_DRAFT" == "true" ]]; then
    PENDING=true
    CONVERGED=false
    echo "BLOCK PR #$PR: PR is draft; broad review is not yet requested" >&2
fi

if [[ "$PENDING_REVIEWER_COUNT" -gt 0 ]]; then
    PENDING=true
    CONVERGED=false
    while IFS= read -r reviewer; do
        echo "BLOCK PR #$PR: review is still requested from '$reviewer'" >&2
    done < <(jq -r '.pending_reviewers[]?' <<<"$CORE_JSON")
fi

if [[ "$REVIEW_DECISION" == "CHANGES_REQUESTED" || "$CURRENT_CHANGE_REQUEST_COUNT" -gt 0 ]]; then
    FINDINGS_OPEN=true
    CONVERGED=false
    echo "BLOCK PR #$PR: a submitted review still requests changes" >&2
fi

if [[ "$UNRESOLVED_ACTIVE" -gt 0 ]]; then
    FINDINGS_OPEN=true
    CONVERGED=false
    echo "BLOCK PR #$PR: $UNRESOLVED_ACTIVE active review thread(s) remain unresolved" >&2
fi

if [[ "$UNRESOLVED_OUTDATED" -gt 0 ]]; then
    FINDINGS_OPEN=true
    CONVERGED=false
    echo "BLOCK PR #$PR: $UNRESOLVED_OUTDATED outdated review thread(s) remain unresolved; live conversation resolution still requires disposition" >&2
fi

if [[ "$RESOLVED_WITHOUT_DISPOSITION" -gt 0 ]]; then
    FINDINGS_OPEN=true
    CONVERGED=false
    echo "BLOCK PR #$PR: $RESOLVED_WITHOUT_DISPOSITION resolved thread(s) have no disposition reply" >&2
fi

FORMAL_CLASSIFICATION="NO_SUBMITTED_HUMAN_REVIEW"
FORMAL_STATUS="absent"
FORMAL_REASON="no_non_dismissed_human_review_submission"
if [[ "$PENDING" == "true" ]]; then
    FORMAL_CLASSIFICATION="PENDING"
    FORMAL_STATUS="pending"
    FORMAL_REASON="native_review_request_or_draft"
elif [[ "$FINDINGS_OPEN" == "true" ]]; then
    FORMAL_CLASSIFICATION="FINDINGS_OPEN"
    FORMAL_STATUS="findings_open"
    FORMAL_REASON="change_request_or_thread_finding"
elif [[ "$SUBMITTED_HUMAN_REVIEW_COUNT" -gt 0 ]]; then
    FORMAL_CLASSIFICATION="SUBMITTED_REVIEW_PRESENT"
    FORMAL_STATUS="present_unclassified"
    FORMAL_REASON="semantic_currentness_requires_subject_bound_marker"
fi

if [[ "$CONVERGED" == "true" ]]; then
    echo "OK   PR #$PR: native review requests and finding threads have converged; semantic review currentness remains a separate required proof"
else
    echo "FAIL PR #$PR: native review-fact convergence not achieved — see BLOCK lines above"
fi

jq -n \
    --argjson core "$CORE_JSON" \
    --argjson converged "$CONVERGED" \
    --arg classification "$FORMAL_CLASSIFICATION" \
    --arg status "$FORMAL_STATUS" \
    --arg reason "$FORMAL_REASON" \
    --argjson submittedReviews "$SUBMITTED_HUMAN_REVIEW_COUNT" \
    '$core + {
      converged: $converged,
      native_review_facts_converged: $converged,
      review_currentness: "NOT_PROVEN",
      semantic_currentness_required: true,
      exact_head_review_required: false,
      material_claim_receipt_required: false,
      submitted_human_review_count: $submittedReviews,
      formal_review: {
        classification: $classification,
        status: $status,
        reason: $reason
      },
      legacy_receipt_observations: {
        review_runs_in_flight: ($core.review_runs_in_flight // 0),
        deep_review_receipt_head_match: ($core.deep_review_receipt_head_match // true),
        verification_receipt_head_match: ($core.verification_receipt_head_match // true),
        stale_reviews: ($core.stale_reviews // []),
        claim_receipt_required: false
      }
    }'

if [[ "$CONVERGED" == "true" ]]; then
    exit 0
fi
exit 1
