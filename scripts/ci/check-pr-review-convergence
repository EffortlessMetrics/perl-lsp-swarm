#!/usr/bin/env bash
# check-pr-review-convergence — semantic GitHub review convergence.
#
# The paginated core remains the provider-fact collector. This public command
# deliberately ignores its legacy exact-head review-run and material-claim
# receipt axes. Review converges from native GitHub state:
#
#   - no deliberately pending requested reviewer;
#   - no current change request;
#   - no unresolved review thread, including outdated threads while the live
#     ruleset requires conversation resolution;
#   - no substantive thread resolved without an evidence-backed disposition;
#   - usable provider facts.
#
# A SHA identifies the observed candidate. It is not the review verdict.
set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "usage: $0 <pr-number> [owner/repo]" >&2
    exit 2
fi

PR="$1"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CORE="$SCRIPT_DIR/check-pr-review-convergence-core"

command -v jq >/dev/null 2>&1 || {
    echo "ERROR: jq not found on PATH" >&2
    exit 2
}
[[ -f "$CORE" ]] || {
    echo "ERROR: review convergence core not found at $CORE" >&2
    exit 2
}

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

set +e
REVIEW_PROTOCOL_ENFORCE= bash "$CORE" "$@" >"$TMP_DIR/core.out" 2>"$TMP_DIR/core.err"
CORE_RC=$?
set -e

CORE_JSON="$(sed -n '/^{/,$p' "$TMP_DIR/core.out")"
if [[ "$CORE_RC" -ge 2 || -z "$CORE_JSON" ]] || ! jq -e . >/dev/null 2>&1 <<<"$CORE_JSON"; then
    echo "NOT_PROVEN PR #$PR: GitHub review facts could not be established" >&2
    cat "$TMP_DIR/core.err" >&2 || true
    jq -n --arg pr "$PR" '{
      schema:"review-convergence.v2",
      pr:($pr | tonumber? // $pr),
      observed_head:null,
      result:"not_proven",
      converged:false,
      exact_head_review_required:false,
      reason:"provider_or_instrument_failure"
    }'
    exit 2
fi

IS_DRAFT="$(jq -r '.is_draft // false' <<<"$CORE_JSON")"
HEAD="$(jq -r '.headRefOid // null' <<<"$CORE_JSON")"
PENDING_REVIEWERS="$(jq -r '.pending_reviewers | length' <<<"$CORE_JSON")"
CURRENT_CHANGE_REQUESTS="$(jq -r '.current_change_requests | length' <<<"$CORE_JSON")"
UNRESOLVED_TOTAL="$(jq -r '.unresolved_total // 0' <<<"$CORE_JSON")"
UNRESOLVED_ACTIVE="$(jq -r '.unresolved_active // 0' <<<"$CORE_JSON")"
UNRESOLVED_OUTDATED="$(jq -r '.unresolved_outdated // 0' <<<"$CORE_JSON")"
RESOLVED_WITHOUT_DISPOSITION="$(jq -r '.resolved_without_disposition // 0' <<<"$CORE_JSON")"
HUMAN_REVIEW_COUNT="$(jq -r '.human_review_count // 0' <<<"$CORE_JSON")"
DISMISSED_HUMAN_REVIEW_COUNT="$(jq -r '.dismissed_human_review_count // 0' <<<"$CORE_JSON")"
USABLE_REVIEW_COUNT=$((HUMAN_REVIEW_COUNT - DISMISSED_HUMAN_REVIEW_COUNT))
if [[ "$USABLE_REVIEW_COUNT" -lt 0 ]]; then
    USABLE_REVIEW_COUNT=0
fi

RESULT="converged"
REASON="native_review_state_converged"
EXIT_CODE=0

if [[ "$IS_DRAFT" == "true" || "$PENDING_REVIEWERS" -gt 0 ]]; then
    RESULT="pending"
    REASON="draft_or_requested_review_pending"
    EXIT_CODE=1
elif [[ "$CURRENT_CHANGE_REQUESTS" -gt 0 || "$UNRESOLVED_TOTAL" -gt 0 || "$RESOLVED_WITHOUT_DISPOSITION" -gt 0 ]]; then
    RESULT="findings_open"
    REASON="change_request_or_thread_finding"
    EXIT_CODE=1
fi

if [[ "$EXIT_CODE" -eq 0 ]]; then
    echo "OK   PR #$PR: native review requests, findings, threads, and dispositions have converged"
else
    echo "BLOCK PR #$PR: semantic review state is $RESULT ($REASON)" >&2
fi

jq -n \
    --argjson core "$CORE_JSON" \
    --arg schema "review-convergence.v2" \
    --arg head "$HEAD" \
    --arg result "$RESULT" \
    --arg reason "$REASON" \
    --argjson converged "$([[ "$EXIT_CODE" -eq 0 ]] && echo true || echo false)" \
    --argjson pendingReviewers "$PENDING_REVIEWERS" \
    --argjson currentChangeRequests "$CURRENT_CHANGE_REQUESTS" \
    --argjson unresolvedTotal "$UNRESOLVED_TOTAL" \
    --argjson unresolvedActive "$UNRESOLVED_ACTIVE" \
    --argjson unresolvedOutdated "$UNRESOLVED_OUTDATED" \
    --argjson resolvedWithoutDisposition "$RESOLVED_WITHOUT_DISPOSITION" \
    --argjson usefulSubmittedReviews "$USABLE_REVIEW_COUNT" \
    '$core + {
      schema:$schema,
      observed_head:$head,
      result:$result,
      reason:$reason,
      converged:$converged,
      exact_head_review_required:false,
      material_claim_receipt_required:false,
      pending_reviewer_count:$pendingReviewers,
      current_change_request_count:$currentChangeRequests,
      unresolved_total:$unresolvedTotal,
      unresolved_active:$unresolvedActive,
      unresolved_outdated:$unresolvedOutdated,
      resolved_without_disposition:$resolvedWithoutDisposition,
      useful_submitted_review_count:$usefulSubmittedReviews,
      legacy_observations:{
        review_runs_in_flight:($core.review_runs_in_flight // 0),
        stale_reviews:($core.stale_reviews // []),
        deep_review_receipt_head_match:($core.deep_review_receipt_head_match // null),
        verification_receipt_head_match:($core.verification_receipt_head_match // null)
      }
    }'

exit "$EXIT_CODE"
