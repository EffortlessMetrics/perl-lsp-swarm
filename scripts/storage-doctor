#!/usr/bin/env bash
# scripts/storage-doctor
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"

repo_name="$(basename "$repo_root")"
devplane="${DEVPLANE:-${XDG_CACHE_HOME:-$HOME/.cache}/devplane/$repo_name}"

fail=0

echo "== disk =="
df -h "$repo_root" "$devplane" 2>/dev/null || df -h "$repo_root"

echo
echo "== repo-local target dirs =="
target_list="$(mktemp "${TMPDIR:-/tmp}/storage-doctor-targets.XXXXXXXX")"
trap 'rm -f -- "$target_list"' EXIT
# Keep enumeration status separate from du: find does not propagate failures
# from -exec, and unknown retained output must not be reported as empty.
if ! find "$repo_root" -type d -name target -prune -print0 > "$target_list"; then
  echo "ERROR: could not enumerate repo-local target dirs: $repo_root" >&2
  fail=1
elif [ ! -s "$target_list" ]; then
  echo "none"
else
  # Measure each target independently and preserve its complete path, including
  # spaces, tabs and newlines. Never parse filenames from du's text records.
  while IFS= read -r -d '' path; do
    if ! usage="$(du -sk -- "$path")"; then
      echo "ERROR: could not measure repo-local target dir: $path" >&2
      fail=1
      continue
    fi
    kb="${usage%%$'\t'*}"
    if [[ ! "$kb" =~ ^(0|[1-9][0-9]*)$ ]]; then
      echo "ERROR: invalid target size for: $path" >&2
      fail=1
      continue
    fi
    awk -v kb="$kb" 'BEGIN { printf "%.1fG\t", kb/1024/1024 }'
    printf '%s\n' "$path"
    # Fail if any repo-local target dir is >1 GiB. Long counts are always over
    # that floor; avoid overflowing Bash's signed integer comparison.
    if [[ ${#kb} -gt 7 ]] || [ "$kb" -gt $((1024 * 1024)) ]; then
      echo "ERROR: repo-local target dir exceeds 1G: $path" >&2
      fail=1
    fi
  done < "$target_list"
fi

echo
echo "== devplane =="
echo "Batch du counts shared hardlinks once; per-path sizes depend on traversal order."
du -sh "$devplane"/* 2>/dev/null || echo "devplane not initialized: $devplane"

echo
echo "== cargo env =="
printf 'DEVPLANE=%s\n' "${DEVPLANE:-}"
printf 'CARGO_HOME=%s\n' "${CARGO_HOME:-}"
printf 'CARGO_TARGET_DIR=%s\n' "${CARGO_TARGET_DIR:-}"
printf 'CARGO_BUILD_BUILD_DIR=%s\n' "${CARGO_BUILD_BUILD_DIR:-}"
printf 'CARGO_INCREMENTAL=%s\n' "${CARGO_INCREMENTAL:-}"
printf 'CARGO_BUILD_JOBS=%s\n' "${CARGO_BUILD_JOBS:-}"
printf 'RUSTC_WRAPPER=%s\n' "${RUSTC_WRAPPER:-}"
printf 'SCCACHE_DIR=%s\n' "${SCCACHE_DIR:-}"
printf 'SCCACHE_CACHE_SIZE=%s\n' "${SCCACHE_CACHE_SIZE:-}"

echo
echo "== sccache =="
if command -v sccache >/dev/null 2>&1; then
  sccache --show-stats || true
else
  echo "sccache not installed"
fi

exit "$fail"
