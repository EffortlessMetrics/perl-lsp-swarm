#!/usr/bin/env bash
# scripts/cargo-safe
set -euo pipefail

# Toolchain guard (#12593): refuse a stale non-rustup cargo before any build work.
. "$(dirname -- "${BASH_SOURCE[0]}")/lib/cargo-toolchain-guard.sh" && cargo_toolchain_guard

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# Repository identity must be stable across linked worktrees: keyed by the
# COMMON git dir (the main checkout), never by this checkout's directory
# name, so every worktree of one repository shares a single devplane by
# default instead of per-checkout caches that can never hit each other.
common_git_dir="$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo "")"
if [ -n "$common_git_dir" ]; then
  repo_name="$(basename "$(dirname "$common_git_dir")")"
else
  repo_name="$(basename "$repo_root")"
fi

# Machine may override this. Default is user-cache, not repo-local.
devplane="${DEVPLANE:-${XDG_CACHE_HOME:-$HOME/.cache}/devplane/$repo_name}"
lock_root="$devplane/locks"

mkdir -p \
  "$devplane/cargo-home" \
  "$devplane/target" \
  "$devplane/build" \
  "$devplane/sccache" \
  "$devplane/tmp" \
  "$lock_root"

check_disk() {
  local path="$1"
  local min_free_gb="${MIN_FREE_GB:-40}"
  local max_used_pct="${MAX_USED_PCT:-85}"

  read -r used_pct avail_kb < <(
    df -Pk "$path" | awk 'NR==2 { gsub("%","",$5); print $5, $4 }'
  )

  local avail_gb=$(( avail_kb / 1024 / 1024 ))

  if [ "$used_pct" -ge "$max_used_pct" ] || [ "$avail_gb" -lt "$min_free_gb" ]; then
    echo "DENY: $path used=${used_pct}% free=${avail_gb}G" >&2
    exit 75
  fi
}

export CARGO_HOME="${CARGO_HOME:-$devplane/cargo-home}"
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$devplane/target}"
export CARGO_BUILD_BUILD_DIR="${CARGO_BUILD_BUILD_DIR:-$devplane/build}"
export CARGO_INCREMENTAL="${CARGO_INCREMENTAL:-0}"
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-2}"
export TMPDIR="${TMPDIR:-$devplane/tmp}"

if command -v sccache >/dev/null 2>&1; then
  export RUSTC_WRAPPER="${RUSTC_WRAPPER:-sccache}"
  export SCCACHE_DIR="${SCCACHE_DIR:-$devplane/sccache}"
  export SCCACHE_CACHE_SIZE="${SCCACHE_CACHE_SIZE:-15G}"

  # Cross-worktree sharing is structural: every worktree of the repository
  # resolves the same devplane (common-git-dir identity above), so compiler
  # invocations use identical CARGO_TARGET_DIR/SCCACHE_DIR paths and hit the
  # same sccache entries. No path-rewrite variable is exported here; the
  # sccache versions this repository documents do not support one.
fi

heavy="${1:-}"

case "$heavy" in
  build|check|test|run|bench|doc|clippy|nextest|xtask)
    check_disk "$devplane"

    if command -v flock >/dev/null 2>&1; then
      exec flock -w "${CARGO_LOCK_WAIT:-180}" \
        "$lock_root/cargo-build.lock" \
        cargo "$@"
    fi

    # Portable fallback where flock does not exist (Windows Git Bash): an
    # atomic mkdir lock with a bounded wait and stale-owner reclaim, so
    # shared-devplane runs stay serialized and fixed receipt paths stay
    # exclusive instead of falling through to unserialized cargo.
    lock_dir="$lock_root/cargo-build.lock.d"
    waited=0
    while ! mkdir "$lock_dir" 2>/dev/null; do
      owner_pid="$(cat "$lock_dir/pid" 2>/dev/null || echo "")"
      if [ -n "$owner_pid" ] && ! kill -0 "$owner_pid" 2>/dev/null; then
        rm -rf "$lock_dir"
        continue
      fi
      waited=$((waited + 5))
      if [ "$waited" -ge "${CARGO_LOCK_WAIT:-180}" ]; then
        echo "DENY: timed out waiting for $lock_dir" >&2
        exit 75
      fi
      sleep 5
    done
    echo $$ > "$lock_dir/pid"
    trap 'rm -rf "$lock_dir"' EXIT
    exec cargo "$@"
    ;;
  *)
    exec cargo "$@"
    ;;
esac
