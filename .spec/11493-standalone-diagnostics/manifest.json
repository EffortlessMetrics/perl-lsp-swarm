    },
    {
      "template_id": "t_selection_committed_path_failed",
      "text": "The {operation} completed, but the PATH entry could not be persisted."
    },
    {
      "template_id": "t_startup_failed",
      "text": "The {operation} finished, but starting the installed command from a fresh process failed."
    },
    {
      "template_id": "t_startup_not_observed",
      "text": "The {operation} completed. Fresh-process startup was not observed."
    },
    {
      "template_id": "t_rollback_restored",
      "text": "The {operation} was rolled back and the previous installation is current again."
    },
    {
      "template_id": "t_rollback_restored_new_session",
      "text": "The {operation} was rolled back and the previous installation is current again. Start a new shell session before running the restored command."
    },
    {
      "template_id": "t_no_selection_change",
      "text": "The {operation} made no selection change."
    },
    {
      "template_id": "t_no_selection_change_new_session",
      "text": "The {operation} made no selection change. Start a new shell session before running the installed command."
    },
    {
