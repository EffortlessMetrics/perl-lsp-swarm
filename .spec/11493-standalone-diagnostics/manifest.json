      "text": "A verified candidate exists but has not been published."
    },
    {
      "template_id": "t_candidate_awaiting_selection",
      "text": "A published candidate exists but is not the current selection."
    },
    {
      "template_id": "t_candidate_verified_startup_failed",
      "text": "A verified candidate exists, but starting it from a fresh process failed. Nothing was installed or selected by this attempt."
    },
    {
      "template_id": "t_candidate_published_startup_failed",
      "text": "A published candidate exists, but starting it from a fresh process failed. It is not the current selection, and nothing was installed by this attempt."
    },
    {
      "template_id": "t_failed_current_preserved",
      "text": "The {operation} failed. The previously installed version is still current."
    },
    {
      "template_id": "t_cancelled_current_preserved",
      "text": "The {operation} was cancelled. The previously installed version is still current."
    },
    {
      "template_id": "t_not_proven_current_preserved",
      "text": "The {operation} could not be proven. The previously installed version is still current."
    },
    {
      "template_id": "t_known_good_unproven",
      "text": "The {operation} did not complete, and the retained installation did not start from a fresh process."
    },
    {
      "template_id": "t_cleanup_residue",
      "text": "Temporary installation state was left behind and needs manual resolution."
    },
    {
      "template_id": "t_cleanup_deferred",
