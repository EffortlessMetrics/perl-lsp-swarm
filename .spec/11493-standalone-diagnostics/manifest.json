      "attempt_id",
      "candidate_id",
      "prior_current_candidate_id"
    ],
    "forbidden_reason": "Rendered diagnostics must not carry free text, raw paths, complete PATH values, credentials, evidence bodies, tool output, or per-attempt identity."
  },
  "schema_version": "standalone_diagnostics.v1",
  "status": "active",
  "summary_templates": [
    {
      "template_id": "t_packet_inconsistent",
      "text": "The {operation} attempt reported an internally inconsistent result ({disposition} with product units {product_units}). No product change is claimed."
