  "claim_boundary": {
    "claims": [
      "One ordered reason/action registry maps every typed standalone_install_transition.v1 outcome to a bounded user consequence.",
      "Projection is a pure total function of typed selector fields only.",
      "Unknown or unmapped typed combinations are registry gaps that fail validation."
    ],
    "does_not_claim": [
      "No installer, adapter, shell, or PowerShell behavior is changed by this registry.",
      "No user-visible documentation, copy, or route guidance is generated here.",
      "No release, publication, or channel mutation is authorized by any action.",
      "Reason domains whose stage results are not yet typed on main are deferred, not covered."
    ]
  },
