                        "type": "number",
                        "enum": [
                            1,
                            2,
                            3,
                            4,
                            5
                        ],
                        "enumDescriptions": [
                            "Severity 1 - very permissive",
                            "Severity 2 - permissive",
                            "Severity 3 - balanced default",
                            "Severity 4 - strict",
                            "Severity 5 - very strict"
                        ],
                        "default": 3,
                        "scope": "resource",
                        "order": 41,
                        "deprecationMessage": "Deprecated: use perl-lsp.critic.severity. This alias still works but perl-lsp.critic.* wins if both are set.",
                        "markdownDeprecationMessage": "**Deprecated:** use `perl-lsp.critic.severity`. This alias still works but `perl-lsp.critic.*` wins if both are set.",
                        "description": "Critic minimum severity (1 = least severe/reports more, 5 = most severe/reports less). Applies to the native critic; the legacy external engine uses the same scale.",
                        "markdownDescription": "Critic minimum severity (`1` = least severe/reports more, `5` = most severe/reports less). Applies to the native critic; the legacy external engine uses the same scale."
