                        "default": true,
                        "scope": "resource",
                        "order": 32,
                        "description": "Enable native critic diagnostics. Native critic is built in and requires no external tools.",
                        "markdownDescription": "Enable native critic diagnostics. Native critic is built into perl-lsp and requires no external tools."
                    },
                    "perl-lsp.critic.engine": {
                        "type": "string",
                        "enum": [
                            "native",
                            "legacy"
                        ],
                        "enumDescriptions": [
                            "Native built-in critic (default, no external tools required)",
