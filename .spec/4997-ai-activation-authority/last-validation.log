                    {
                        "id": "ai-completion",
                        "title": "AI-Powered Completions (Optional)",
                        "description": "Perl LSP supports AI-powered inline code suggestions, but the feature is **off by default** and only available when your language server advertises support.\n\nEnable it under `Settings` \u2192 search `perl-lsp.aiCompletion` (or run the command from the palette). If your server supports it, the extension also offers a one-time prompt to turn it on.",
                        "media": {
                            "image": "media/walkthrough/ai-completion.svg",
                            "altText": "AI Completions"
                        }
