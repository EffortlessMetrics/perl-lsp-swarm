        "typecheck:authority": "node scripts/check-typescript-authority.js",
        "typecheck:all": "npm run typecheck:authority && npm run typecheck && npm run typecheck:test && npm run typecheck:integration && npm run typecheck:published && npm run typecheck:scripts",
        "clean:out": "node -e \"const fs=require('fs'),path=require('path'); if(fs.existsSync('out')){for(const f of fs.readdirSync('out')){if(f!=='test')fs.rmSync(path.join('out',f),{recursive:true,force:true});}}\"",
        "compile": "npm run clean:out && rolldown -c rolldown.config.mjs",
        "clean:test": "node -e \"require('fs').rmSync('out-test',{recursive:true,force:true})\"",
        "compile:test": "npm run clean:test && tsc -p ./tsconfig.test.json",
        "watch": "npm run clean:out && rolldown -c rolldown.config.mjs --watch",
        "watch:types": "tsc -watch --noEmit -p ./tsconfig.json",
        "lint": "npm run lint:canary && node scripts/check-oxlint-warning-budget.js",
        "lint:ratchet": "node scripts/check-oxlint-warning-budget.js",
        "lint:canary": "node scripts/lint-canary.js",
        "fmt": "oxfmt --write .",
