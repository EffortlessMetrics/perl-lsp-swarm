                        ],
                        "default": "recommended",
                        "scope": "resource",
                        "order": 34,
                        "description": "Native critic rule profile.",
                        "markdownDescription": "Native critic rule profile: `recommended` (balanced default) or `strict` (more rules enabled)."
                    },
                    "perl-lsp.critic.severity": {
                        "type": "number",
                        "enum": [
                            1,
                            2,
                            3,
                            4,
                            5
                        ],
                        "enumDescriptions": [
                            "Severity 1 - very permissive",
                            "Severity 2 - permissive",
                            "Severity 3 - balanced default",
                            "Severity 4 - strict",
                            "Severity 5 - very strict"
                        ],
                        "default": 3,
                        "scope": "resource",
                        "order": 35,
                        "description": "Critic minimum severity (1 = least severe/reports more, 5 = most severe/reports less).",
                        "markdownDescription": "Critic minimum severity (`1` = least severe/reports more, `5` = most severe/reports less)."
                    },
                    "perl-lsp.critic.include": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": [],
                        "scope": "resource",
                        "order": 36,
                        "description": "Only these native critic rule IDs run, including ones outside the selected profile (e.g. native.variables.unused_lexical).",
                        "markdownDescription": "Only these native critic rule IDs run, including ones outside the selected profile (e.g. `native.variables.unused_lexical`)."
                    },
                    "perl-lsp.critic.exclude": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": [],
