                        ],
                        "default": "native",
                        "scope": "machine",
                        "order": 33,
                        "description": "Critic engine. 'native' uses the built-in critic (default); 'legacy' shells out to an external perlcritic binary for compatibility.",
                        "markdownDescription": "Critic engine. `native` uses the built-in critic (default, no external tools); `legacy` shells out to an external `perlcritic` binary for compatibility and requires it on `PATH`."
                    },
                    "perl-lsp.critic.profile": {
                        "type": "string",
                        "enum": [
                            "recommended",
                            "strict"
                        ],
                        "enumDescriptions": [
