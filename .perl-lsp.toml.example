# .perl-lsp.toml — project configuration for perl-lsp
#
# Copy this file to your workspace root and rename it to .perl-lsp.toml.
# Commit it to version control to share team-wide defaults with all editors.
#
# All sections and keys are optional. The file may be empty or omitted entirely.
# Unknown keys and sections are silently ignored for forward compatibility.
# Invalid TOML produces a warning notification in your editor.
#
# Configuration precedence (last-write-wins):
#   .perl-lsp.toml  ->  initializationOptions  ->  didChangeConfiguration
#   (this file)         (editor startup)            (live editor settings)
#
# Editor settings always override this file, so team members can still
# customize their own environments.
#
# Multi-root workspaces: each workspace folder loads its own .perl-lsp.toml.
# [perl] is scoped per-folder (include_paths etc. never leak across folders).
# The other sections — [diagnostics], [critic], [features], [formatting],
# [ai_completion], [next_edit] — are server-global: if two folders set the
# same key to different values, the FIRST folder wins and the server emits a
# window/showMessage warning naming the conflict. Non-conflicting keys from
# different folders all apply. For genuinely per-folder diagnostics/formatting,
# use per-folder editor settings (scope: "resource") instead. See
# docs/reference/CONFIG.md (Multi-root workspaces).

# ── [perl] ───────────────────────────────────────────────────────────────────
# Module resolution settings.

[perl]

# Perl version hint for the project (e.g. "5.38", "5.40").
# Parsed but not yet wired to diagnostics; reserved for future use.
# version = "5.38"

# Additional module include paths, relative to the workspace root.
# Overrides the built-in defaults (lib, ., local/lib/perl5) when non-empty.
# An empty list (include_paths = []) is treated as "not set" and leaves
# the built-in defaults unchanged.
#
# include_paths = ["lib", "local/lib/perl5"]

# ── [diagnostics] ────────────────────────────────────────────────────────────
# Linting settings. Critic diagnostics are enabled by default (perlcritic = true).
# With the default native engine ([critic].engine = "native") they use the
# Rust-native critic registry; set engine = "legacy" to shell out to perlcritic.

[diagnostics]

# Enable critic diagnostics (default: true).
# Uncomment and set to false to disable critic diagnostics.
#
# perlcritic = true

# Minimum perlcritic severity to report (1 = least severe, 5 = most severe).
# Default: 3 (Harsh). Must be in the range 1-5.
# Equivalent to `perlcritic --severity N`.
#
# perlcritic_severity = 3

# ── [critic] ────────────────────────────────────────────────────────────────
# Critic engine selection.

[critic]

# Engine values:
#   native (default)               = Rust-native critic rule registry
#   legacy / perlcritic / external = Perl::Critic-compatible legacy path
#
# engine = "native"

# ── [features] ───────────────────────────────────────────────────────────────
# LSP feature toggles.

[features]

# Enable or disable all inlay hints globally (default: true).
# Individual hint types (parameterHints, typeHints, chainedHints) are
# controlled via editor settings.
#
# inlay_hints = true

# ── [formatting] ─────────────────────────────────────────────────────────────
# Formatting configuration. All keys are optional. Native formatting is the
# default engine; external perltidy remains available as compatibility mode.
#
[formatting]
# Enable LSP formatting (default: true).
# enabled = true

# Formatter engine:
#   native            = Rust-native formatter
#   compat            = native formatter with compatibility-oriented defaults
#   external-perltidy = shell out to perltidy compatibility adapter
#   off               = disable formatting
#
# engine = "native"

# Path to a `.perltidyrc` profile file (optional). Used by the external
# perltidy adapter and native-tooling compatibility reports.
# perltidy_profile = ".perltidyrc"

# Maximum line length (default: 80).
# perltidy_maximum_line_length = 80

# Indent size in spaces (default: 4).
# perltidy_indent_columns = 4

# Use tabs instead of spaces (default: false).
# perltidy_tabs = false

# Opening brace on new line (default: false).
# perltidy_opening_brace_on_new_line = false

# Cuddled else style (default: true).
# perltidy_cuddled_else = true

# Space after keyword (default: true).
# perltidy_space_after_keyword = true

# Add trailing commas (default: false).
# perltidy_add_trailing_commas = false

# Vertical alignment (default: true).
# perltidy_vertical_alignment = true

# Block comment indentation (default: 0).
# perltidy_block_comment_indentation = 0

# Extra perltidy arguments (default: []).
# perltidy_extra_args = ["--no-check-syntax"]

# Timeout in seconds (default: 10).
# perltidy_timeout_secs = 10

# ──────────────────────────────────────────────────────────────────────────────
# AI Completion
# ──────────────────────────────────────────────────────────────────────────────
# AI-powered inline completions using an OpenAI-compatible API endpoint.
# Disabled by default.
#
# SECURITY: The project .perl-lsp.toml may ONLY opt out of AI completions.
# It CANNOT set endpoint, provider, model, api_key_*, timeout, or any other
# runtime field. A hostile cloned repository could otherwise name an
# arbitrary environment variable (e.g. AWS_SECRET_ACCESS_KEY) and have its
# value POSTed to an attacker-chosen endpoint (#4955).
#
# User-owned client configuration controls activation and the supported
# server settings. The primary VS Code extension exposes only the enable and
# streaming toggles; it does not expose endpoint or credential settings.
# See docs/reference/AI_COMPLETION.md for the current configuration matrix.
#
# To configure AI completions, use a client that supports the server's
# aiCompletion configuration channel. In the primary VS Code extension,
# configure only perl-lsp.aiCompletion.enabled and
# perl-lsp.aiCompletion.streaming.enabled.

[ai_completion]
# Opt out of AI completions for this project.
# When false, disables AI even if the user enabled it in their editor.
# When true or absent, has no effect (a repository cannot turn AI on).
# enabled = false

# ──────────────────────────────────────────────────────────────────────────────
# Next Edit (experimental)
# ──────────────────────────────────────────────────────────────────────────────
# Future runtime boundary for next-edit suggestions. Currently dormant.

[next_edit]
# Enable the next-edit runtime. Experimental.
# enabled = false
