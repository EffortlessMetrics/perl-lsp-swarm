# Optional machine-local Cargo settings; do not commit config.local.toml.
#
# Activation (pinned Cargo 1.100):
# - `scripts/cargo-safe` and `scripts/cargo-admitted` pass
#   `--config .cargo/config.local.toml` when this file exists.
# - For direct `cargo`, pass the same flag explicitly, e.g.
#   `cargo --config .cargo/config.local.toml check -p foo`, or export the
#   knobs you need via `CARGO_*` in your task shell.
#
# Precedence: admitted-route `--config` overrides (target/build paths, jobs
# policy) win over values here; do not put target-dir, build-dir, compiler
# wrappers, or sccache settings in this file (see docs/agents/CARGO_STORAGE.md).

[build]
jobs = 2
incremental = false
