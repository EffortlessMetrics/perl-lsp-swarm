# EditorConfig — universal cross-editor formatting defaults.
# https://editorconfig.org/
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{rs,toml}]
indent_size = 4

[*.{ts,js,json,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
# Markdown uses trailing spaces for hard line breaks — don't trim them.
trim_trailing_whitespace = false

[*.{ps1,pl,pm,t}]
indent_size = 4

[Makefile]
indent_style = tab

# These fixtures intentionally preserve their line-ending and whitespace
# representation; keep EditorConfig from normalizing test input on save.
[testdata/ux/release_smoke/crlf_links/main.pl]
end_of_line = crlf

[crates/perl-corpus/fixtures/parser_accuracy/span_coordinates.pl]
charset = utf-8-bom
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
