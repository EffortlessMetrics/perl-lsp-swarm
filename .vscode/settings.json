{
  "rust-analyzer.files.excludeDirs": [
    ".claude/worktrees",
    ".codex-worktrees",
    ".worktrees",
    "archive",
    "fuzz"
  ],
  "files.associations": {
    "*.pl": "perl",
    "*.pm": "perl",
    "*.pod": "perl",
    "*.t": "perl",
    "*.psgi": "perl"
  },
  "[perl]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": true,
    "editor.rulers": [79, 100],
    "editor.wordBasedSuggestions": "off",
    "editor.semanticHighlighting.enabled": true
  }
}
