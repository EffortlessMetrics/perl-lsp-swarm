{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vscode-extension: compile:test",
      "type": "npm",
      "script": "compile:test",
      "path": "${workspaceFolder}/vscode-extension",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "perl-lsp: devex",
      "type": "process",
      "command": "just",
      "args": ["devex"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Developer environment diagnostics (`just devex`)."
    },
    {
      "label": "perl-lsp: agent-check",
      "type": "process",
      "command": "just",
      "args": ["agent-check", "${input:perlLspCargoPackage}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$rustc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Focused admitted package check (`just agent-check <package>`). Preflight the same check -p <package> --profile agent --locked request first."
    },
    {
      "label": "perl-lsp: pr-fast",
      "type": "process",
      "command": "just",
      "args": ["pr-fast"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "detail": "Fast local pull-request gate (`just pr-fast`)."
    }
  ],
  "inputs": [
    {
      "id": "perlLspCargoPackage",
      "type": "promptString",
      "description": "Cargo package to check",
      "default": "perl-parser"
    }
  ]
}
