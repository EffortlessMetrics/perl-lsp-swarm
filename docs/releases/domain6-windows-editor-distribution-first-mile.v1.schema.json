{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/perl-lsp-swarm/blob/main/docs/releases/domain6-windows-editor-distribution-first-mile.v1.schema.json",
  "title": "Domain-6 inventory fragment v1",
  "description": "Deterministic, inventory-only Domain-6 (Windows/editor/distribution/first-mile) fragment for the #16399 post_sync_release_reconciliation.v1 ledger. It establishes the durable denominator (exact range, prefilter, work-unit identities, five reviewed seed rows, explicit not_proven remainder) and completes no semantic disposition. Generated by scripts/generate_domain6_fragment.py; see issue #16418.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "fragment_id", "parent_denominator", "prefilter_paths", "grouping_method_version", "record_counts", "work_unit_count", "reviewed_seed_count", "not_proven_unit_count", "work_units", "merge_units", "excluded_merges", "noref_watchlist", "corrections", "merge_enumeration", "consumers", "coverage"],
  "properties": {
    "schema": {"const": "post_sync_release_reconciliation.v1"},
    "fragment_id": {"const": "domain6_windows_editor_distribution_first_mile"},
    "parent_denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_sha", "observed_head"],
      "properties": {
        "start_sha": {"const": "f6b7b2c6626fbefbf01c9c9934cac5789186f8b2"},
        "observed_head": {"const": "102974155487bc955e01d5d5222053c4c449136c"}
      }
    },
    "prefilter_paths": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {"type": "string"}
    },
    "grouping_method_version": {"type": "string", "minLength": 1},
    "record_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["non_merge", "merge_units", "noref_watchlist_rows", "total_rows", "unique_commits"],
      "properties": {
        "non_merge": {"const": 682},
        "merge_units": {"const": 20},
        "noref_watchlist_rows": {"const": 3},
        "total_rows": {"const": 705},
        "unique_commits": {"const": 702}
      }
    },
    "work_unit_count": {"const": 672},
    "reviewed_seed_count": {"const": 14},
    "not_proven_unit_count": {"const": 658},
    "work_units": {
      "type": "array",
      "minItems": 672,
      "maxItems": 672,
      "items": {"$ref": "#/$defs/work_unit"}
    },
    "merge_units": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/work_unit"}
    },
    "excluded_merges": {
      "type": "array",
      "minItems": 74,
      "maxItems": 74,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha", "subject", "reason", "detail"],
        "properties": {
          "sha": {"$ref": "#/$defs/sha"},
          "subject": {"type": "string", "minLength": 1},
          "reason": {"enum": ["content-free", "blob-covered", "related-record"]},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "noref_watchlist": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commit", "subject", "reason"],
        "properties": {
          "commit": {"$ref": "#/$defs/sha"},
          "subject": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "corrections": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "merge_enumeration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["range_merges_touching_prefilter", "merge_units_kept", "related_remerges_recorded", "content_free_merges_excluded", "blob_covered_merges_excluded", "merge_units_created"],
      "properties": {
        "range_merges_touching_prefilter": {"const": 94},
        "merge_units_kept": {"const": 2},
        "related_remerges_recorded": {"const": 1},
        "content_free_merges_excluded": {"const": 62},
        "blob_covered_merges_excluded": {"const": 11},
        "merge_units_created": {"const": 18}
      }
    },
    "consumers": {"type": "object"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["omitted_records", "duplicate_records", "omitted_work_units", "duplicate_work_units", "digest"],
      "properties": {
        "omitted_records": {"const": 0},
        "duplicate_records": {"const": 0},
        "omitted_work_units": {"const": 0},
        "duplicate_work_units": {"const": 0},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "string_list": {"type": "array", "items": {"type": "string"}},
    "work_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_unit_id", "commits", "grouping_evidence", "primary_fragment", "primary_fragment_basis", "disposition_state", "paths_or_components"],
      "properties": {
        "work_unit_id": {"type": "string", "minLength": 1},
        "commits": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha"}},
        "grouping_evidence": {"type": "string", "minLength": 1},
        "primary_fragment": {"enum": ["editor", "distribution", "first_mile", "cross_domain_unassigned"]},
        "primary_fragment_basis": {"enum": ["seed_review", "merge_unit_review", "single_family_paths", "mixed_or_mechanics_paths"]},
        "disposition_state": {"enum": ["reviewed", "not_proven"]},
        "paths_or_components": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "release_domains": {"$ref": "#/$defs/string_list"},
        "primary_disposition": {"enum": ["product_behavior", "public_api_or_schema", "configuration_or_migration", "packaging_install_or_editor", "release_integrity_or_lineage", "proof_or_test_only", "documentation_or_claim_only", "reverted_or_superseded", "internal_architecture_unclaimed"]},
        "reachable_installed_effect": {"enum": ["yes", "no", "bounded", "not_proven"]},
        "public_claim_refs": {"$ref": "#/$defs/string_list"},
        "release_note_disposition": {"enum": ["required", "covered", "not_user_facing"]},
        "migration_or_upgrade_refs": {"$ref": "#/$defs/string_list"},
        "api_schema_package_effects": {"$ref": "#/$defs/string_list"},
        "proof_owner_refs": {"$ref": "#/$defs/string_list"},
        "known_limitations": {"$ref": "#/$defs/string_list"},
        "open_pr_relationships": {"$ref": "#/$defs/string_list"},
        "controlling_issues": {"$ref": "#/$defs/string_list"},
        "invalidators": {"$ref": "#/$defs/string_list"},
        "platforms_and_targets": {"$ref": "#/$defs/string_list"},
        "artifact_or_route_effects": {"$ref": "#/$defs/string_list"},
        "editor_manifest_or_protocol_effects": {"$ref": "#/$defs/string_list"},
        "installed_evidence_stage": {"type": "string", "minLength": 1},
        "member_subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["commit", "subject"],
            "properties": {
              "commit": {"$ref": "#/$defs/sha"},
              "subject": {"type": "string"}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"disposition_state": {"const": "reviewed"}}},
          "then": {
            "required": ["release_domains", "primary_disposition", "reachable_installed_effect", "public_claim_refs", "release_note_disposition", "migration_or_upgrade_refs", "api_schema_package_effects", "proof_owner_refs", "known_limitations", "open_pr_relationships", "controlling_issues", "invalidators", "platforms_and_targets", "artifact_or_route_effects", "editor_manifest_or_protocol_effects", "installed_evidence_stage"],
            "properties": {
              "primary_disposition": {"enum": ["product_behavior", "public_api_or_schema", "configuration_or_migration", "packaging_install_or_editor", "release_integrity_or_lineage", "proof_or_test_only", "documentation_or_claim_only", "reverted_or_superseded", "internal_architecture_unclaimed"]},
              "reachable_installed_effect": {"enum": ["yes", "no", "bounded", "not_proven"]},
              "release_note_disposition": {"enum": ["required", "covered", "not_user_facing"]}
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {"required": ["release_domains"]},
                {"required": ["primary_disposition"]},
                {"required": ["reachable_installed_effect"]},
                {"required": ["public_claim_refs"]},
                {"required": ["release_note_disposition"]},
                {"required": ["migration_or_upgrade_refs"]},
                {"required": ["api_schema_package_effects"]},
                {"required": ["proof_owner_refs"]},
                {"required": ["known_limitations"]},
                {"required": ["open_pr_relationships"]},
                {"required": ["controlling_issues"]},
                {"required": ["invalidators"]},
                {"required": ["platforms_and_targets"]},
                {"required": ["artifact_or_route_effects"]},
                {"required": ["editor_manifest_or_protocol_effects"]},
                {"required": ["installed_evidence_stage"]}
              ]
            }
          }
        }
      ]
    }
  }
}
