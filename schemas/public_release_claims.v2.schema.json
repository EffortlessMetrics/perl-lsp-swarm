{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/perl-lsp-swarm/schemas/public_release_claims.v2.schema.json",
  "title": "public_release_claims.v2",
  "description": "Deterministic install-claim catalog (v2). Rows are assembled from the landed docs/distribution/INSTALL_CLAIM_SURFACES.md inventory (#11575) by the sanctioned generator (`cargo xtask public-release-claims-v2`), keeping drift status, route dimensions, findings, and restatement groups as independent results rather than one scalar status. Coexists with public_release_claims.v1 per #11548/#10333: v1 remains historical; this schema is the current catalog shape for install-route consumers (#11549 classifier).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "generator",
    "issue",
    "source_inventory",
    "input_digests",
    "surfaces",
    "claims",
    "findings"
  ],
  "properties": {
    "schema_version": {"const": "public_release_claims.v2"},
    "status": {"const": "generated"},
    "generator": {
      "type": "string",
      "const": "cargo xtask public-release-claims-v2 build --write"
    },
    "issue": {"const": 11548},
    "source_inventory": {"$ref": "#/$defs/source_inventory"},
    "input_digests": {"$ref": "#/$defs/input_digests"},
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": false,
      "items": {"$ref": "#/$defs/surface"}
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/claim"}
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "source_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "audited_commit", "audited_date", "release_anchor", "track"],
      "properties": {
        "path": {"const": "docs/distribution/INSTALL_CLAIM_SURFACES.md"},
        "audited_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "audited_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "release_anchor": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "track": {"const": "public-beta"}
      }
    },
    "input_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory_document", "schema"],
      "properties": {
        "inventory_document": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "schema": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_id", "path", "role", "claim_class", "registry_cross_ref"],
      "properties": {
        "surface_id": {"type": "string", "pattern": "^S(?:0[1-9]|1[0-3])$"},
        "path": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "claim_class": {"type": "string", "minLength": 1},
        "registry_cross_ref": {"type": "string"}
      }
    },
    "drift_status": {
      "enum": [
        "current",
        "pending",
        "stale_example",
        "future_example",
        "mutable_pin",
        "cross_surface_drift",
        "source_drift",
        "volatile_number"
      ]
    },
    "finding_ref": {"type": "string", "pattern": "^FND-(?:[1-9]|1[0-2])$"},
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "windows_arm64": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "user_prose",
            "tracked_source",
            "published_receipt_v0_17_0"
          ],
          "description": "Conjunctive dimension (a): Windows ARM64 support asserted inconsistently across source, prose, and published assets (FND-4). The three fields are independent and must not be collapsed.",
          "properties": {
            "user_prose": {
              "enum": ["unsupported", "x64_fallback_build_from_source", "supported", "unspecified"]
            },
            "tracked_source": {"enum": ["not_built", "built", "unknown"]},
            "published_receipt_v0_17_0": {"enum": ["absent", "present", "unverified"]},
            "finding_refs": {
              "type": "array",
              "items": {"$ref": "#/$defs/finding_ref"},
              "uniqueItems": true
            }
          }
        },
        "sha256sums_enforcement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "description": "Conjunctive dimension (b): SHA256SUMS enforcement mode claimed for an installer surface (C207 fail-closed canonical versus C1005 fail-open residue; FND-7).",
          "properties": {
            "mode": {
              "enum": ["fail_closed_required", "fail_open_conditional", "verify_present_no_mode", "not_applicable"]
            },
            "finding_refs": {
              "type": "array",
              "items": {"$ref": "#/$defs/finding_ref"},
              "uniqueItems": true
            }
          }
        },
        "product_units": {
          "type": "object",
          "additionalProperties": false,
          "required": ["build_from_source_units"],
          "description": "Conjunctive dimension (c): product-unit membership (perllsp server, perl-dap adapter, extension) per acquisition mode (C208 BUILD_FROM_SOURCE=1 server-only versus archive pair; FND-11 tracked-installer divergence).",
          "properties": {
            "build_from_source_units": {
              "type": "array",
              "items": {"enum": ["perllsp", "perl-dap", "extension"]},
              "uniqueItems": true
            },
            "archive_units_claimed": {
              "type": "array",
              "items": {"enum": ["perllsp", "perl-dap"]},
              "uniqueItems": true
            },
            "tracked_installer_ships_adapter": {"type": ["boolean", "null"]},
            "finding_refs": {
              "type": "array",
              "items": {"$ref": "#/$defs/finding_ref"},
              "uniqueItems": true
            }
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "surface_id",
        "location",
        "summary",
        "drift_status",
        "notes",
        "finding_refs",
        "restatement_group",
        "omitted_caveats"
      ],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^C[0-9]{3,4}$"},
        "surface_id": {"type": "string", "pattern": "^S(?:0[1-9]|1[0-3])$"},
        "location": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "drift_status": {"$ref": "#/$defs/drift_status"},
        "notes": {"type": "string"},
        "finding_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding_ref"},
          "uniqueItems": true
        },
        "restatement_group": {
          "description": "Dedup join tag only. No canonical fragment or preference is selected here; that belongs to the later family slice.",
          "enum": ["bootstrap_identity", "verification_probes", null]
        },
        "omitted_caveats": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "enum": ["homebrew_tap_version_unproven", "crates_io_name_collision", "identity_bound_wrapper_framing"]
          },
          "uniqueItems": true
        },
        "dimensions": {"$ref": "#/$defs/dimensions"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "title", "related_claims", "owner_route"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/finding_ref"},
        "title": {"type": "string", "minLength": 1},
        "related_claims": {
          "type": "array",
          "items": {"type": "string", "pattern": "^C[0-9]{3,4}$"},
          "uniqueItems": true
        },
        "owner_route": {
          "description": "Recorded disposition pointer from the inventory text; `none_recorded` when the inventory assigns none.",
          "enum": [
            "#10342-ci-cutover",
            "#11549-classifier",
            "distribution-docs-sync",
            "none_recorded"
          ]
        }
      }
    }
  }
}
