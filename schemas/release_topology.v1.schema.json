{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/perl-lsp-swarm/schemas/release_topology.v1.schema.json",
  "title": "release_topology.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "release", "track", "frozen_product_sha", "workspace_version", "published_crates", "crate_count", "binary_targets", "archive_count", "vsix", "primary_channels", "secondary_channels", "sources"],
  "properties": {
    "schema": {"const": 1},
    "release": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "track": {"const": "public-beta"},
    "frozen_product_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "prepared_swarm_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "workspace_version": {"type": "string"},
    "published_crates": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "package_path", "version", "publish_order", "internal_dependencies"], "properties": {"name": {"type": "string"}, "package_path": {"type": "string"}, "version": {"type": "string"}, "publish_order": {"type": "integer", "minimum": 1}, "internal_dependencies": {"type": "array", "items": {"type": "string"}}}}},
    "crate_count": {"type": "integer", "minimum": 1},
    "binary_targets": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["target", "os", "architecture", "libc", "runner", "archive_name", "required_members"], "properties": {"target": {"type": "string"}, "os": {"enum": ["linux", "macos", "windows"]}, "architecture": {"type": "string"}, "libc": {"type": ["string", "null"]}, "runner": {"type": "string"}, "archive_name": {"type": "string"}, "required_members": {"type": "array", "items": {"type": "string"}}}}},
    "archive_count": {"type": "integer", "minimum": 1},
    "vsix": {"type": "object", "additionalProperties": false, "required": ["version", "asset_name", "package_path", "managed_targets", "bundled_targets"], "properties": {"version": {"type": "string"}, "asset_name": {"type": "string", "minLength": 1}, "package_path": {"const": "vscode-extension"}, "managed_targets": {"type": "array", "items": {"type": "string"}}, "bundled_targets": {"type": "array", "items": {"type": "string"}}}},
    "primary_channels": {"type": "array", "const": ["github_release", "crates_io", "vscode_marketplace", "open_vsx"]},
    "secondary_channels": {"type": "object", "additionalProperties": false, "required": ["docker", "homebrew"], "properties": {"docker": {"enum": ["required", "deferred"]}, "homebrew": {"enum": ["required", "deferred"]}}},
    "sources": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
  }
}
