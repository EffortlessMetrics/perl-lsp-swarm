{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.com/schemas/ast_change_impact.v1.schema.json",
  "title": "AST change impact packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "controller_issue",
    "coverage_scope",
    "claim_boundary",
    "complete",
    "impacts"
  ],
  "properties": {
    "schema_version": {
      "const": "ast_change_impact.v1"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "controller_issue": {
      "type": "string",
      "pattern": "^#[1-9][0-9]*$"
    },
    "coverage_scope": {
      "type": "string",
      "minLength": 1
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "complete": {
      "type": "boolean"
    },
    "inventory_authority": {
      "type": "string",
      "minLength": 1
    },
    "impacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/impact_row"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        },
        "required": ["complete"]
      },
      "then": {
        "required": ["inventory_authority"]
      }
    }
  ],
  "$defs": {
    "disposition": {
      "type": "string",
      "enum": [
        "implemented",
        "explicit_typed_boundary",
        "reviewed_bridge_debt",
        "reviewed_non_applicability",
        "migration_pending",
        "missing"
      ]
    },
    "change_kind": {
      "type": "string",
      "enum": ["added", "semantic_change", "split", "merge", "retirement"]
    },
    "impact_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ast_kind",
        "change_kind",
        "flat_hir_disposition",
        "body_hir_disposition",
        "pir_a_disposition",
        "owner_issue",
        "stop_condition",
        "claim_boundary"
      ],
      "properties": {
        "ast_kind": {
          "type": "string",
          "minLength": 1
        },
        "change_kind": {
          "$ref": "#/$defs/change_kind"
        },
        "parser_contract": {
          "type": "string",
          "minLength": 1
        },
        "flat_hir_disposition": {
          "$ref": "#/$defs/disposition"
        },
        "body_hir_disposition": {
          "$ref": "#/$defs/disposition"
        },
        "pir_a_disposition": {
          "$ref": "#/$defs/disposition"
        },
        "profiles_note": {
          "type": "string",
          "minLength": 1
        },
        "providers_note": {
          "type": "string",
          "minLength": 1
        },
        "gold_oracle_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "schema_cache_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owner_issue": {
          "type": "string",
          "pattern": "^#[1-9][0-9]*$"
        },
        "stop_condition": {
          "type": "string",
          "minLength": 1
        },
        "claim_boundary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
