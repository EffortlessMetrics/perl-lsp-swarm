{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/perl-lsp/schemas/agent_context.v1.schema.json",
  "title": "Agent context v1",
  "description": "Read-only orientation envelope for LSP clients and agents.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "command",
    "user_message",
    "claim_boundary",
    "request",
    "workspace_trust_report",
    "advertised_feature_ids",
    "execute_commands",
    "next_actions"
  ],
  "properties": {
    "schema_version": {"const": "agent_context.v1"},
    "command": {"const": "perl.agentContext"},
    "user_message": {"type": "string"},
    "claim_boundary": {"type": "string"},
    "request": {
      "type": "object",
      "required": ["method", "arguments_required", "arguments_shape"],
      "properties": {
        "method": {"const": "workspace/executeCommand"},
        "arguments_required": {"const": true},
        "arguments_shape": {"type": "string"}
      }
    },
    "workspace_trust_report": {
      "$ref": "workspace_trust_report.v1.schema.json"
    },
    "advertised_feature_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "execute_commands": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string"},
          "source": {"type": "string"},
          "command": {"type": "string"},
          "commands": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "description": {"type": "string"}
        }
      }
    }
  }
}
