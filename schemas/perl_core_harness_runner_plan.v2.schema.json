{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/perl_core_harness_runner_plan.v2.schema.json",
  "title": "Perl core harness runner plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "matrix_fingerprint", "target_id", "target_contract_digest", "runner", "runner_entrypoint", "canonical_selection_entrypoint", "raw_discovery_digest", "normalization_schema", "discovery_frame", "source_items", "normalized_order", "normalized_membership", "scheduling", "invocation_capture", "limitations", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "perl_core_harness.runner_plan.v2"},
    "matrix_fingerprint": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "target_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "target_contract_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "runner": {"enum": ["test", "harness", "direct_fallback"]},
    "runner_entrypoint": {"type": "string", "minLength": 1},
    "canonical_selection_entrypoint": {"type": "string", "minLength": 1},
    "raw_discovery_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "normalization_schema": {"const": "perl_core_harness.source_identity.v2"},
    "discovery_frame": {"enum": ["runner_t_directory_relative", "repository_root_relative", "canonical_repository_path"]},
    "source_items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_item"}},
    "normalized_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "normalized_membership": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "scheduling": {"$ref": "#/$defs/scheduling"},
    "invocation_capture": {"const": "not_proven"},
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "source_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_path", "discovery_frame", "canonical_path", "source_form", "path_class", "invocation_context"],
      "properties": {
        "raw_path": {"type": "string", "minLength": 1},
        "discovery_frame": {"enum": ["runner_t_directory_relative", "repository_root_relative", "canonical_repository_path"]},
        "canonical_path": {"type": "string", "minLength": 1},
        "source_form": {"enum": ["dot_t", "test_pl"]},
        "path_class": {"enum": ["local_t", "root_lib", "dist", "ext", "cpan"]},
        "invocation_context": {"enum": ["base_comp_run", "local_test_init", "root_lib_u1", "distribution_u2_t"]}
      }
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobs", "asap", "state_ordering", "properties"],
      "properties": {
        "jobs": {"type": ["integer", "null"], "minimum": 1},
        "asap": {"type": "boolean"},
        "state_ordering": {"type": "boolean"},
        "properties": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
      }
    }
  }
}
