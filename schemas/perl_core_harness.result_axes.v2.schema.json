{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/perl_core_harness.result_axes.v2.schema.json",
  "title": "Perl core harness result axes v2",
  "description": "Strict separated result axes for the upstream Perl core harness lane. Evidence validity, observed product outcome, compatibility admission, semantic support, and correctness mechanism are independent; the cross-axis rules in $defs.result_axes.allOf reject combinations that would overstate what the evidence establishes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "origin",
    "completion",
    "subject",
    "axes",
    "parse",
    "admission",
    "correctness_rails",
    "current_versus_accepted",
    "files",
    "invocations",
    "claim_boundary",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "perl_core_harness.result_axes.v2"},
    "origin": {"enum": ["current_measurement", "legacy_adapted"]},
    "completion": {"enum": ["complete", "incomplete", "not_attempted"]},
    "subject": {"$ref": "#/$defs/subject_identity"},
    "axes": {"$ref": "#/$defs/result_axes"},
    "parse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files_total", "files_passed", "axes"],
      "properties": {
        "files_total": {"type": "integer", "minimum": 0},
        "files_passed": {"type": "integer", "minimum": 0},
        "axes": {"$ref": "#/$defs/result_axes"}
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_admission",
        "by_support",
        "accepted_debt_count",
        "source_locked_count",
        "downstream_blocking_count"
      ],
      "properties": {
        "by_admission": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/admission"},
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "by_support": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/support"},
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "accepted_debt_count": {"type": "integer", "minimum": 0},
        "source_locked_count": {"type": "integer", "minimum": 0},
        "downstream_blocking_count": {"type": "integer", "minimum": 0}
      }
    },
    "correctness_rails": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/correctness_rail"}
    },
    "current_versus_accepted": {"$ref": "#/$defs/current_versus_accepted"},
    "files": {"type": "array", "items": {"$ref": "#/$defs/file_mode_result"}},
    "invocations": {"type": "array", "items": {"$ref": "#/$defs/invocation_result"}},
    "claim_boundary": {"$ref": "#/$defs/non_blank_string"},
    "limitations": {"type": "array", "items": {"$ref": "#/$defs/non_blank_string"}}
  },
  "allOf": [
    {
      "$comment": "Valid aggregate evidence requires a measurement that actually finished; an unfinished run cannot be published as valid evidence.",
      "if": {
        "properties": {"axes": {"properties": {"evidence": {"const": "valid"}}}},
        "required": ["axes"]
      },
      "then": {"properties": {"completion": {"const": "complete"}}}
    },
    {
      "$comment": "A complete run with valid evidence must record a real product outcome. A run that finished while assessing nothing would otherwise present itself as complete, valid and authoritative on the strength of no assessment at all.",
      "if": {
        "properties": {
          "completion": {"const": "complete"},
          "axes": {"properties": {"evidence": {"const": "valid"}}, "required": ["evidence"]}
        },
        "required": ["completion", "axes"]
      },
      "then": {
        "properties": {
          "axes": {"properties": {"observation": {"enum": ["clean", "failures_observed"]}}}
        }
      }
    },
    {
      "$comment": "A clean rollup cannot sit over a detail record that observed failures or whose instrument failed; either means the run did not come back clean.",
      "if": {
        "properties": {"axes": {"properties": {"observation": {"const": "clean"}}, "required": ["observation"]}},
        "required": ["axes"]
      },
      "then": {
        "properties": {
          "files": {"not": {"contains": {"type": "object", "required": ["axes"], "properties": {"axes": {"type": "object", "required": ["observation"], "properties": {"observation": {"enum": ["failures_observed", "process_or_protocol_failed"]}}}}}}},
          "invocations": {"not": {"contains": {"type": "object", "required": ["axes"], "properties": {"axes": {"type": "object", "required": ["observation"], "properties": {"observation": {"enum": ["failures_observed", "process_or_protocol_failed"]}}}}}}}
        }
      }
    },
    {
      "$comment": "Legacy-adapted evidence stays historical. Without this a schema-only consumer would accept a v1 record promoted to a candidate or no-change transition, which the Rust validator rejects.",
      "if": {
        "properties": {"origin": {"const": "legacy_adapted"}},
        "required": ["origin"]
      },
      "then": {
        "properties": {
          "current_versus_accepted": {"properties": {"transition": {"const": "historical"}}}
        }
      }
    }
  ],
  "$defs": {
    "non_blank_string": {
      "type": "string",
      "pattern": "\\S",
      "$comment": "At least one non-whitespace character. minLength alone would accept \"   \", which the Rust validator rejects as blank."
    },
    "evidence": {"enum": ["valid", "not_proven", "invalid", "stale", "cancelled"]},
    "observation": {
      "enum": ["clean", "failures_observed", "process_or_protocol_failed", "not_assessed"]
    },
    "admission": {
      "enum": [
        "implemented",
        "statically_classified",
        "accepted_debt",
        "unsupported",
        "not_assessed"
      ]
    },
    "support": {"enum": ["general", "partial", "blocked", "unavailable", "not_assessed"]},
    "mechanism": {
      "enum": ["none", "fixture_replay", "eir_execution", "real_perl_oracle", "curated_gold"]
    },
    "axis_name": {"enum": ["evidence", "observation", "admission", "support", "mechanism"]},
    "rail_availability": {"enum": ["available", "partial", "not_available", "stale"]},
    "transition": {
      "enum": [
        "no_change",
        "improvement_candidate",
        "regression",
        "contract_correction_candidate",
        "not_proven",
        "historical"
      ]
    },
    "result_axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "observation", "admission", "support", "mechanism"],
      "properties": {
        "evidence": {"$ref": "#/$defs/evidence"},
        "observation": {"$ref": "#/$defs/observation"},
        "admission": {"$ref": "#/$defs/admission"},
        "support": {"$ref": "#/$defs/support"},
        "mechanism": {"$ref": "#/$defs/mechanism"}
      },
      "allOf": [
        {
          "$comment": "Evidence validity is decided before domain outcome: a clean or failing product outcome requires valid evidence.",
          "if": {"properties": {"observation": {"enum": ["clean", "failures_observed"]}}},
          "then": {"properties": {"evidence": {"const": "valid"}}}
        },
        {
          "$comment": "An instrument failure is not_proven, not a product result.",
          "if": {"properties": {"observation": {"const": "process_or_protocol_failed"}}},
          "then": {"properties": {"evidence": {"not": {"const": "valid"}}}}
        },
        {
          "$comment": "An admission is a conclusion drawn from the evidence, so any admission other than not_assessed requires valid evidence.",
          "if": {
            "properties": {"admission": {"not": {"const": "not_assessed"}}},
            "required": ["admission"]
          },
          "then": {"properties": {"evidence": {"const": "valid"}}}
        },
        {
          "$comment": "A positive support claim needs valid evidence, an observed product outcome, an admission that can carry it, and a real mechanism. A subject recorded as not observed cannot also be reported as supported.",
          "if": {"properties": {"support": {"enum": ["general", "partial"]}}},
          "then": {
            "properties": {
              "evidence": {"const": "valid"},
              "observation": {"enum": ["clean", "failures_observed"]},
              "admission": {"not": {"enum": ["unsupported", "not_assessed"]}},
              "mechanism": {"not": {"const": "none"}}
            }
          }
        },
        {
          "$comment": "Compile admission, accepted debt, and fixture replay never imply general semantic support.",
          "if": {"properties": {"support": {"const": "general"}}},
          "then": {
            "properties": {
              "admission": {"const": "implemented"},
              "mechanism": {"not": {"const": "fixture_replay"}}
            }
          }
        }
      ]
    },
    "subject_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series_id",
        "subject_identity",
        "evidence_bundle_id",
        "measurement_sha",
        "denominator"
      ],
      "properties": {
        "series_id": {"$ref": "#/$defs/non_blank_string"},
        "subject_identity": {"$ref": "#/$defs/non_blank_string"},
        "evidence_bundle_id": {"$ref": "#/$defs/non_blank_string"},
        "measurement_sha": {"$ref": "#/$defs/non_blank_string"},
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "$comment": "A current aggregate without an exact denominator is not comparable."
        }
      }
    },
    "correctness_rail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism",
        "availability",
        "reason",
        "evidence_refs",
        "files_total",
        "files_passed"
      ],
      "properties": {
        "mechanism": {"$ref": "#/$defs/mechanism"},
        "availability": {"$ref": "#/$defs/rail_availability"},
        "reason": {"$ref": "#/$defs/non_blank_string"},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/non_blank_string"}},
        "files_total": {"type": ["integer", "null"], "minimum": 0},
        "files_passed": {"type": ["integer", "null"], "minimum": 0}
      },
      "allOf": [
        {
          "$comment": "Availability decides whether the rail ran. A rail that did not run claims nothing at all: no mechanism, no evidence, no counts. Keying this off the mechanism instead would let 'not_available' coexist with a full set of passing counts.",
          "if": {"properties": {"availability": {"const": "not_available"}}, "required": ["availability"]},
          "then": {
            "properties": {
              "mechanism": {"const": "none"},
              "evidence_refs": {"maxItems": 0},
              "files_total": {"const": null},
              "files_passed": {"const": null}
            }
          }
        },
        {
          "$comment": "A rail that ran names the mechanism it used and cites evidence.",
          "if": {
            "properties": {"availability": {"enum": ["available", "partial", "stale"]}},
            "required": ["availability"]
          },
          "then": {
            "properties": {
              "mechanism": {"not": {"const": "none"}},
              "evidence_refs": {"minItems": 1}
            }
          }
        },
        {
          "$comment": "An available rail reports what it covered.",
          "if": {"properties": {"availability": {"const": "available"}}, "required": ["availability"]},
          "then": {"properties": {"files_total": {"type": "integer"}}}
        },
        {
          "$comment": "Counts are both-or-neither: one populated count without the other is a half-reported rail, which the Rust validator rejects as RailCountsIncomplete.",
          "if": {"properties": {"files_total": {"type": "integer"}}, "required": ["files_total"]},
          "then": {"properties": {"files_passed": {"type": "integer"}}},
          "else": {"properties": {"files_passed": {"const": null}}}
        }
      ]
    },
    "current_versus_accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition", "requires_acceptance", "accepted_baseline_digest", "reason"],
      "properties": {
        "transition": {"$ref": "#/$defs/transition"},
        "requires_acceptance": {"type": "boolean"},
        "accepted_baseline_digest": {"oneOf": [{"$ref": "#/$defs/non_blank_string"}, {"type": "null"}]},
        "reason": {"$ref": "#/$defs/non_blank_string"}
      },
      "allOf": [
        {
          "$comment": "Acceptance means adoption into the ratchet, matching classify_compatibility_transition in perl-core-harness: an improvement or contract correction awaits acceptance, a regression does not — it is a blocking signal, not something adopted.",
          "if": {
            "properties": {
              "transition": {
                "enum": ["improvement_candidate", "contract_correction_candidate"]
              }
            },
            "required": ["transition"]
          },
          "then": {"properties": {"requires_acceptance": {"const": true}}},
          "else": {"properties": {"requires_acceptance": {"const": false}}}
        },
        {
          "$comment": "Improvement, regression and no-change are all claims relative to an actual accepted baseline; only a historical or unproven record has nothing to compare against.",
          "if": {
            "properties": {
              "transition": {"enum": ["improvement_candidate", "regression", "no_change"]}
            },
            "required": ["transition"]
          },
          "then": {"properties": {"accepted_baseline_digest": {"type": "string"}}}
        }
      ]
    },
    "file_mode_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "axes", "bucket"],
      "properties": {
        "path": {"$ref": "#/$defs/non_blank_string"},
        "mode": {"enum": ["parse", "compile", "execute"]},
        "axes": {"$ref": "#/$defs/result_axes"},
        "bucket": {"oneOf": [{"$ref": "#/$defs/non_blank_string"}, {"type": "null"}]}
      }
    },
    "invocation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocation_identity", "axes", "limitations"],
      "properties": {
        "invocation_identity": {"$ref": "#/$defs/non_blank_string"},
        "axes": {"$ref": "#/$defs/result_axes"},
        "limitations": {"type": "array", "items": {"$ref": "#/$defs/non_blank_string"}}
      }
    }
  }
}
