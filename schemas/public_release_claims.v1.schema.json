{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/perl-lsp-swarm/schemas/public_release_claims.v1.schema.json",
  "title": "public_release_claims.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "track", "subject_sha", "topology_digest", "claims"],
  "properties": {
    "schema_version": {"const": "public_release_claims.v1"},
    "release": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "track": {"const": "public-beta"},
    "subject_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "topology_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}}
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surfaces", "audience", "text_or_command", "authority", "evidence_refs", "status", "public_context", "limitation"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"},
        "surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "audience": {"const": "user"},
        "text_or_command": {"type": "string", "minLength": 1},
        "authority": {"enum": ["release_topology", "installed_transition", "experience_contract", "api_audit", "release_integrity"]},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["proven", "bounded", "blocked", "not_proven"]},
        "public_context": {"enum": ["swarm", "publication", "both"]},
        "limitation": {"type": ["string", "null"]}
      }
    }
  }
}
