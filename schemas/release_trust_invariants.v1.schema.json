{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/perl-lsp-swarm/schemas/release_trust_invariants.v1.schema.json",
  "title": "release_trust_invariants.v1",
  "description": "Machine-readable registry of mandatory v0.18 trust invariants (#9392 / #8507 PR 1). Generated Markdown is a projection of this document. Unknown, duplicate, ownerless, or superseded producer authority fails validation. Live candidate receipts are out of scope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry",
    "issue",
    "parent_issue",
    "owner",
    "updated",
    "claim_boundary",
    "owner_authorities",
    "producer_authorities",
    "negative_control_catalog",
    "controller_requirements",
    "invariants"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "release_trust_invariants.v1" },
    "registry": { "const": "release-trust-invariants" },
    "issue": { "const": 9392 },
    "parent_issue": { "const": 8507 },
    "owner": { "type": "string", "minLength": 1 },
    "updated": { "type": "string", "minLength": 1 },
    "claim_boundary": { "type": "string", "minLength": 1 },
    "owner_authorities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/owner_authority" }
    },
    "producer_authorities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/producer_authority" }
    },
    "negative_control_catalog": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/negative_control" }
    },
    "controller_requirements": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/controller_requirement" }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/invariant_row" }
    }
  },
  "$defs": {
    "authority_status": {
      "type": "string",
      "enum": ["current", "superseded"]
    },
    "producer_kind": {
      "type": "string",
      "enum": [
        "provider_decision_receipt",
        "provider_edit_receipt",
        "public_beta_experience_fan_in",
        "first_ten_minutes_receipt",
        "install_transition_receipt",
        "installed_public_beta_receipt",
        "process_lifecycle_receipt",
        "full_document_sync_receipt",
        "release_integrity_closeout",
        "no_publish_side_effects_receipt",
        "manifest_reachability_receipt",
        "public_claim_catalog_receipt"
      ]
    },
    "release_claim": {
      "type": "string",
      "enum": [
        "provider_exactness",
        "provider_edit_safety",
        "aggregation_honesty",
        "startup_honesty",
        "install_integrity",
        "artifact_identity",
        "lifecycle_cleanup",
        "text_synchronization",
        "release_integrity",
        "publication_authority",
        "installed_reachability",
        "public_claim_truth"
      ]
    },
    "identity_requirement": {
      "type": "string",
      "enum": ["required", "not_applicable"]
    },
    "terminal_semantics": {
      "type": "string",
      "enum": ["count", "blocks"]
    },
    "platform": {
      "type": "string",
      "enum": ["linux_x64", "windows_x64", "macos_bounded", "topology_selected"]
    },
    "profile": {
      "type": "string",
      "enum": [
        "public_beta",
        "installed_journey",
        "candidate_packet",
        "publication_rehearsal",
        "first_ten_minutes"
      ]
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1
    },
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "owner_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "status", "title"],
      "properties": {
        "issue": { "$ref": "#/$defs/issue_number" },
        "status": { "$ref": "#/$defs/authority_status" },
        "title": { "type": "string", "minLength": 1 },
        "successor": { "$ref": "#/$defs/issue_number" }
      }
    },
    "producer_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer_kind", "status", "owner_issue", "command_or_workflow"],
      "properties": {
        "producer_kind": { "$ref": "#/$defs/producer_kind" },
        "status": { "$ref": "#/$defs/authority_status" },
        "owner_issue": { "$ref": "#/$defs/issue_number" },
        "command_or_workflow": { "type": "string", "minLength": 1 },
        "successor": { "$ref": "#/$defs/producer_kind" }
      }
    },
    "negative_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner_issue", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "owner_issue": { "$ref": "#/$defs/issue_number" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "controller_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller_issue", "mandatory_invariant_ids"],
      "properties": {
        "controller_issue": { "$ref": "#/$defs/issue_number" },
        "mandatory_invariant_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stable_id" }
        }
      }
    },
    "subject_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha", "candidate_digest", "artifact_hashes"],
      "properties": {
        "source_sha": { "$ref": "#/$defs/identity_requirement" },
        "candidate_digest": { "$ref": "#/$defs/identity_requirement" },
        "artifact_hashes": { "$ref": "#/$defs/identity_requirement" }
      }
    },
    "denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "completeness_rule"],
      "properties": {
        "authority": { "type": "string", "minLength": 1 },
        "completeness_rule": { "type": "string", "minLength": 1 }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platforms", "profiles", "supported_envelope_ref"],
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/platform" }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profile" }
        },
        "supported_envelope_ref": { "$ref": "#/$defs/issue_number" }
      }
    },
    "terminal_input_states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "failure", "not_proven"],
      "properties": {
        "success": { "$ref": "#/$defs/terminal_semantics" },
        "failure": { "$ref": "#/$defs/terminal_semantics" },
        "not_proven": { "const": "blocks" }
      }
    },
    "invariant_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invariant_id",
        "release_claim",
        "owner_issue",
        "producer_kind",
        "subject_identity",
        "denominator",
        "applicability",
        "terminal_input_states",
        "negative_control_ids",
        "release_consumers",
        "claim_boundary"
      ],
      "properties": {
        "invariant_id": { "$ref": "#/$defs/stable_id" },
        "release_claim": { "$ref": "#/$defs/release_claim" },
        "owner_issue": { "$ref": "#/$defs/issue_number" },
        "producer_kind": { "$ref": "#/$defs/producer_kind" },
        "subject_identity": { "$ref": "#/$defs/subject_identity" },
        "denominator": { "$ref": "#/$defs/denominator" },
        "applicability": { "$ref": "#/$defs/applicability" },
        "terminal_input_states": { "$ref": "#/$defs/terminal_input_states" },
        "negative_control_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "release_consumers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/issue_number" }
        },
        "claim_boundary": { "type": "string", "minLength": 1 }
      }
    }
  }
}
