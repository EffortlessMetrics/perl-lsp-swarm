{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/perl_core_harness_runner_parity.v1.schema.json",
  "title": "Perl core harness runner membership parity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matrix_fingerprint",
    "target_id",
    "target_contract_digest",
    "left_runner",
    "right_runner",
    "membership_status",
    "missing_from_right",
    "extra_in_right",
    "order_equal",
    "scheduling_equal",
    "invocation_capture",
    "limitations",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "perl_core_harness.runner_parity.v1"},
    "matrix_fingerprint": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "target_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "target_contract_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "left_runner": {"enum": ["test", "harness", "direct_fallback"]},
    "right_runner": {"enum": ["test", "harness", "direct_fallback"]},
    "membership_status": {"enum": ["parity", "mismatch", "not_proven"]},
    "missing_from_right": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "extra_in_right": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "order_equal": {"type": "boolean"},
    "scheduling_equal": {"type": "boolean"},
    "invocation_capture": {"const": "not_proven"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
