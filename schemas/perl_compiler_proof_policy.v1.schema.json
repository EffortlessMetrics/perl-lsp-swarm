{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.com/schemas/perl_compiler_proof_policy.v1.schema.json",
  "title": "Perl compiler proof policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "controller_issue",
    "concept_ledger_schema",
    "coverage_scope",
    "claim_boundary",
    "complete",
    "proof_classes",
    "dimensions",
    "campaigns"
  ],
  "properties": {
    "schema_version": {
      "const": "perl_compiler_proof_policy.v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "controller_issue": {
      "type": "string",
      "pattern": "^#[1-9][0-9]*$"
    },
    "concept_ledger_schema": {
      "const": "perl_compiler_concepts.v1"
    },
    "coverage_scope": {
      "type": "string",
      "minLength": 1
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "complete": {
      "type": "boolean"
    },
    "closure_authority": {
      "type": "string",
      "pattern": "^issue:#[1-9][0-9]*/[a-z0-9][a-z0-9_-]*$"
    },
    "proof_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/proof_class"
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "campaigns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/campaign"
      }
    },
    "dispositions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/disposition"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        },
        "required": [
          "complete"
        ]
      },
      "then": {
        "required": [
          "closure_authority"
        ],
        "properties": {
          "dispositions": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "complete": {
            "const": false
          }
        },
        "required": [
          "complete"
        ]
      },
      "then": {
        "anyOf": [
          {
            "not": {
              "required": [
                "closure_authority"
              ]
            }
          },
          {
            "properties": {
              "dispositions": {
                "minItems": 1
              }
            },
            "required": [
              "dispositions"
            ]
          }
        ]
      }
    }
  ],
  "$defs": {
    "issue": {
      "type": "string",
      "pattern": "^#[1-9][0-9]*$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "claim_stage": {
      "enum": [
        "parser",
        "flat_hir",
        "body_hir",
        "pir_a",
        "effects_world",
        "eir",
        "provider"
      ]
    },
    "authority": {
      "enum": [
        "independent_gold",
        "compiler_snapshot",
        "mutation_fixture",
        "independent_fixture",
        "eir_differential",
        "real_perl_oracle",
        "composition_harness"
      ]
    },
    "missing_effect": {
      "enum": [
        "blocks_claim",
        "blocks_stage",
        "blocks_execution_claim",
        "blocks_claim_when_observable"
      ]
    },
    "proof_class": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class_id",
        "purpose",
        "authority",
        "claim_stages",
        "circular_output_allowed",
        "missing_effect",
        "owner_issue",
        "evidence_roles"
      ],
      "properties": {
        "class_id": {
          "$ref": "#/$defs/identifier"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "claim_stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/claim_stage"
          }
        },
        "circular_output_allowed": {
          "type": "boolean"
        },
        "missing_effect": {
          "$ref": "#/$defs/missing_effect"
        },
        "owner_issue": {
          "$ref": "#/$defs/issue"
        },
        "evidence_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence_role"
          }
        },
        "multi_role_claim_ceiling": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_roles": {
                "minItems": 2
              }
            },
            "required": [
              "evidence_roles"
            ]
          },
          "then": {
            "required": [
              "multi_role_claim_ceiling"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "evidence_roles": {
                "maxItems": 1
              }
            },
            "required": [
              "evidence_roles"
            ]
          },
          "then": {
            "not": {
              "required": [
                "multi_role_claim_ceiling"
              ]
            }
          }
        }
      ]
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension_id",
        "values",
        "owner_issue",
        "claim_boundary"
      ],
      "properties": {
        "dimension_id": {
          "$ref": "#/$defs/identifier"
        },
        "values": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "owner_issue": {
          "$ref": "#/$defs/issue"
        },
        "claim_boundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "concept_families",
        "dimensions",
        "proof_classes",
        "owner_issue",
        "claim_boundary"
      ],
      "properties": {
        "campaign_id": {
          "$ref": "#/$defs/identifier"
        },
        "concept_families": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "dimensions": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "proof_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "owner_issue": {
          "$ref": "#/$defs/issue"
        },
        "claim_boundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_role": {
      "enum": [
        "independent_structural_expectation",
        "compiler_generated_snapshot",
        "execution_receipt",
        "real_perl_oracle_observation",
        "verifier_mutation_result",
        "effects_world_fixture",
        "eir_differential_result",
        "composition_result",
        "implementation_diagnostic_receipt"
      ]
    },
    "item_kind": {
      "enum": [
        "proof_class",
        "dimension",
        "concept_family"
      ]
    },
    "disposition_status": {
      "enum": [
        "deferred_to_owner",
        "sequencing_blocked",
        "superseded_pending_removal"
      ]
    },
    "disposition_basis": {
      "enum": [
        "semantic",
        "sequencing"
      ]
    },
    "claim_effect": {
      "enum": [
        "excluded_from_claims",
        "claims_limited"
      ]
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_kind",
        "item_id",
        "status",
        "reason",
        "owner_issue",
        "basis",
        "review_after",
        "exit_condition",
        "claim_effect"
      ],
      "properties": {
        "item_kind": {
          "$ref": "#/$defs/item_kind"
        },
        "item_id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "$ref": "#/$defs/disposition_status"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "owner_issue": {
          "$ref": "#/$defs/issue"
        },
        "basis": {
          "$ref": "#/$defs/disposition_basis"
        },
        "review_after": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "exit_condition": {
          "type": "string",
          "minLength": 1
        },
        "claim_effect": {
          "$ref": "#/$defs/claim_effect"
        },
        "claims_limited_ceiling": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_effect": {
                "const": "claims_limited"
              }
            },
            "required": [
              "claim_effect"
            ]
          },
          "then": {
            "required": [
              "claims_limited_ceiling"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "claim_effect": {
                "const": "excluded_from_claims"
              }
            },
            "required": [
              "claim_effect"
            ]
          },
          "then": {
            "not": {
              "required": [
                "claims_limited_ceiling"
              ]
            }
          }
        }
      ]
    }
  }
}
