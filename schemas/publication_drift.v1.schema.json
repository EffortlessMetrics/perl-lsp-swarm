{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/perl-lsp-swarm/schemas/publication_drift.v1.schema.json",
  "title": "publication_drift.v1 observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "swarm",
    "public",
    "manifest_digest",
    "differences",
    "invariants"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "swarm": {
      "$ref": "#/$defs/subject"
    },
    "public": {
      "$ref": "#/$defs/subject"
    },
    "manifest_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "differences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "classification",
          "behavior_changed",
          "evidence"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "expected_publication_translation",
              "approved_lineage_exclusion",
              "release_metadata_only",
              "product_drift",
              "unknown_or_not_proven"
            ]
          },
          "behavior_changed": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_proven"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "sha",
        "version"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
