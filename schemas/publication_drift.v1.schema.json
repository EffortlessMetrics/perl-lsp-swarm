{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/perl-lsp-swarm/schemas/publication_drift.v1.schema.json",
  "title": "publication_drift.v1 observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "swarm",
    "public",
    "manifest",
    "differences",
    "invariants"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "swarm": {
      "$ref": "#/$defs/subject"
    },
    "public": {
      "$ref": "#/$defs/subject"
    },
    "manifest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/manifest"
        }
      ]
    },
    "differences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/difference"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/invariant"
      }
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "sha",
        "tree_digest",
        "version"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "swarm_sha",
        "public_sha"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\:]+(?:/[^/\\\\:]+)*$",
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "swarm_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "public_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "classification",
        "behavior_changed",
        "manifest_rule",
        "owner",
        "evidence"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\:]+(?:/[^/\\\\:]+)*$",
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        },
        "classification": {
          "enum": [
            "expected_publication_translation",
            "approved_lineage_exclusion",
            "release_metadata_only",
            "product_drift",
            "unknown_or_not_proven"
          ]
        },
        "behavior_changed": {
          "type": "boolean"
        },
        "manifest_rule": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "owner",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "not_proven"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
