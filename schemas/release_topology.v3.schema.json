{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/perl-lsp-swarm/schemas/release_topology.v3.schema.json",
  "title": "release_topology.v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release",
    "track",
    "frozen_product_sha",
    "workspace_version",
    "published_crates",
    "crate_count",
    "binary_targets",
    "archive_count",
    "vsix",
    "primary_channels",
    "secondary_channels",
    "sources",
    "checksum_assets",
    "subject_projection"
  ],
  "properties": {
    "schema": {
      "const": 3
    },
    "release": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "track": {
      "const": "public-beta"
    },
    "frozen_product_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "prepared_swarm_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "workspace_version": {
      "type": "string"
    },
    "published_crates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "package_path",
          "version",
          "publish_order",
          "internal_dependencies"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "package_path": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "publish_order": {
            "type": "integer",
            "minimum": 1
          },
          "internal_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "crate_count": {
      "type": "integer",
      "minimum": 1
    },
    "binary_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "os",
          "architecture",
          "libc",
          "runner",
          "archive_name",
          "required_members"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "os": {
            "enum": [
              "linux",
              "macos",
              "windows"
            ]
          },
          "architecture": {
            "type": "string"
          },
          "libc": {
            "type": [
              "string",
              "null"
            ]
          },
          "runner": {
            "type": "string"
          },
          "archive_name": {
            "type": "string"
          },
          "required_members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "archive_count": {
      "type": "integer",
      "minimum": 1
    },
    "vsix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "asset_name",
        "package_path",
        "managed_targets",
        "bundled_targets"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "asset_name": {
          "type": "string",
          "minLength": 1
        },
        "package_path": {
          "const": "vscode-extension"
        },
        "managed_targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bundled_targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "primary_channels": {
      "type": "array",
      "const": [
        "github_release",
        "crates_io",
        "vscode_marketplace",
        "open_vsx"
      ]
    },
    "secondary_channels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "docker",
        "homebrew"
      ],
      "properties": {
        "docker": {
          "enum": [
            "required",
            "deferred"
          ]
        },
        "homebrew": {
          "enum": [
            "required",
            "deferred"
          ]
        }
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "checksum_assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_name",
          "algorithm",
          "channel",
          "archive_targets"
        ],
        "properties": {
          "asset_name": {
            "const": "SHA256SUMS"
          },
          "algorithm": {
            "const": "sha256"
          },
          "channel": {
            "const": "github_release"
          },
          "archive_targets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "subject_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sbom",
        "subject_list",
        "named_artifacts",
        "external_records"
      ],
      "properties": {
        "sbom": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "channel"
          ],
          "properties": {
            "path": {
              "const": "dist/sbom-spdx.json"
            },
            "format": {
              "const": "SPDX-2.3"
            },
            "channel": {
              "const": "github_release"
            }
          }
        },
        "subject_list": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "role",
            "algorithm"
          ],
          "properties": {
            "path": {
              "const": "attestation-subjects.sha256"
            },
            "role": {
              "const": "local_subject_list"
            },
            "algorithm": {
              "const": "sha256"
            }
          }
        },
        "named_artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dynamic_classes",
            "fixed_artifacts",
            "conditional_paths"
          ],
          "properties": {
            "dynamic_classes": {
              "const": [
                "release_archives",
                "validated_build_evidence"
              ]
            },
            "conditional_paths": {
              "const": [
                {
                  "path": "release_notes.md",
                  "condition": "present",
                  "class": "release_notes"
                }
              ]
            },
            "fixed_artifacts": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "class"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "class": {
                    "enum": [
                      "checksum_set",
                      "sbom",
                      "terminal_manifest"
                    ]
                  }
                }
              }
            }
          }
        },
        "external_records": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "producer",
            "subjects_from",
            "execution"
          ],
          "properties": {
            "role": {
              "const": "external_attestation_records"
            },
            "producer": {
              "const": "actions/attest"
            },
            "subjects_from": {
              "const": "attestation-subjects.sha256"
            },
            "execution": {
              "const": "not_proven"
            }
          }
        }
      }
    }
  }
}
