{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/perl-lsp-swarm/schemas/v0_18_text_sync_envelope.v1.schema.json",
  "title": "v0_18_text_sync_envelope.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "subject_sha",
    "decision",
    "active_encoding_set",
    "text_sync_kind",
    "required_owner_issues",
    "production_authorities",
    "removed_or_disabled_authorities",
    "exact_process_receipts",
    "editor_receipts",
    "limitations",
    "public_claim_ceiling"
  ],
  "properties": {
    "schema_version": { "const": "v0_18_text_sync_envelope.v1" },
    "release": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "subject_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "decision": { "enum": ["atomic_incremental", "full_document_utf16"] },
    "active_encoding_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["utf-8", "utf-16"] }
    },
    "text_sync_kind": { "enum": ["incremental", "full"] },
    "required_owner_issues": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 }
    },
    "production_authorities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "removed_or_disabled_authorities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "exact_process_receipts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "editor_receipts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "public_claim_ceiling": { "type": "string", "minLength": 1 }
  }
}
