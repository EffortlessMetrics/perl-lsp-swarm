{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/perl_core_harness.landed_lineage.v1.schema.json",
  "title": "Perl core harness landed lineage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "series_id", "profile", "manifest_hash", "evidence_bundle_id",
    "evidence_bundle_digest", "measurement_sha", "publication_sha", "landed_sha",
    "publication_base_sha", "authoritative_artifacts", "publication_paths",
    "accepted_transition_id", "accepted_baseline_digest", "accepted_baseline_evidence_bundle",
    "observation_transition", "recorder_schema_version",
    "created_reason", "supersedes"
  ],
  "properties": {
    "schema_version": {"const": "perl_core_harness.landed_lineage.v1"},
    "series_id": {"type": "string", "minLength": 1},
    "profile": {"enum": ["base", "comp", "run", "core", "lib", "full"]},
    "manifest_hash": {"type": "string", "minLength": 1},
    "evidence_bundle_id": {"type": "string", "minLength": 1},
    "evidence_bundle_digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
    "measurement_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"},
    "publication_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"},
    "landed_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"},
    "publication_base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"},
    "authoritative_artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}
    },
    "publication_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "accepted_transition_id": {"type": ["string", "null"]},
    "accepted_baseline_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-fA-F]{64}$"},
    "accepted_baseline_evidence_bundle": {"type": ["string", "null"]},
    "observation_transition": {"enum": ["no_change", "improvement_candidate", "regression", "contract_correction_candidate", "not_proven", "historical"]},
    "recorder_schema_version": {"type": "string", "minLength": 1},
    "created_reason": {"type": "string", "minLength": 1},
    "supersedes": {"type": ["string", "null"]}
  }
}
