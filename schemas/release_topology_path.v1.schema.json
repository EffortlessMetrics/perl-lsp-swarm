{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/perl-lsp-swarm/schemas/release_topology_path.v1.schema.json",
  "title": "release_topology_path.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_topology_sha256",
    "path_id",
    "platform",
    "target",
    "expected_asset"
  ],
  "properties": {
    "schema_version": {"const": "release_topology_path.v1"},
    "release_topology_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path_id": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "expected_asset": {"type": "string", "minLength": 1}
  }
}
