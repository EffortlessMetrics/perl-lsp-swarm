{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/perl_core_harness_target_matrix_index.v1.schema.json",
  "title": "Perl core harness upstream target matrix index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "perl_version_row",
    "perl_requested_ref",
    "perl_resolved_ref",
    "topology_sources",
    "target_files",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "perl_core_harness.target_matrix_index.v1"
    },
    "perl_version_row": {
      "type": "string",
      "minLength": 1
    },
    "perl_requested_ref": {
      "type": "string",
      "minLength": 1
    },
    "perl_resolved_ref": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "topology_sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{40}$"
      }
    },
    "target_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[^/\\\\]+\\.json$"
      }
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
