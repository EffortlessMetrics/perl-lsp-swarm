{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/perl_core_harness_target_matrix.v1.schema.json",
  "title": "Perl core harness upstream target matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "perl_version_row",
    "perl_requested_ref",
    "perl_resolved_ref",
    "topology_sources",
    "targets",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "perl_core_harness.target_matrix.v1"},
    "perl_version_row": {"type": "string", "minLength": 1},
    "perl_requested_ref": {"type": "string", "minLength": 1},
    "perl_resolved_ref": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "topology_sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
    },
    "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/matrix_entry"}},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "matrix_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "disposition", "owner_issue", "claim_boundary"],
      "properties": {
        "contract": {"$ref": "#/$defs/contract"},
        "disposition": {"enum": ["implemented", "planned", "generated_composite", "preparation_only", "instrumentation_only", "platform_unavailable", "policy_excluded"]},
        "owner_issue": {"type": ["integer", "null"], "minimum": 1},
        "claim_boundary": {"type": "string", "minLength": 1}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "target_id", "upstream_name", "aliases", "display_name",
        "perl_version_row", "target_kind", "authority", "selection_authority", "selectors",
        "script_forms", "preparation", "variant_of", "composite_members",
        "composite_overlap_policy", "runner_switches", "variant_parameters", "environment",
        "terminal_policy", "capability_predicates", "exclusions", "replaces_target_id",
        "change_reason"
      ],
      "properties": {
        "schema_version": {"const": "perl_core_harness.target_selection.v1"},
        "target_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "upstream_name": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "display_name": {"type": "string", "minLength": 1},
        "perl_version_row": {"type": "string", "minLength": 1},
        "target_kind": {"enum": ["physical_series", "selector_variant", "environment_variant", "preparation_only", "generated_composite", "instrumentation_only"]},
        "authority": {"$ref": "#/$defs/authority"},
        "selection_authority": {"oneOf": [{"$ref": "#/$defs/authority"}, {"type": "null"}]},
        "selectors": {"type": "array", "items": {"$ref": "#/$defs/selector"}},
        "script_forms": {"type": "array", "uniqueItems": true, "items": {"enum": ["dot_t", "test_pl", "generated_perl"]}},
        "preparation": {"$ref": "#/$defs/preparation"},
        "variant_of": {"type": ["string", "null"], "pattern": "^[a-z0-9_]+$"},
        "composite_members": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
        "composite_overlap_policy": {"enum": [null, "reject_overlap", "deduplicate_by_logical_source"]},
        "runner_switches": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "variant_parameters": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "environment": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "terminal_policy": {"enum": ["not_applicable", "choose", "tty", "no_tty", "inherited"]},
        "capability_predicates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "exclusions": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}},
        "replaces_target_id": {"type": ["string", "null"], "pattern": "^[a-z0-9_]+$"},
        "change_reason": {"type": ["string", "null"]}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entrypoint"],
      "properties": {
        "kind": {"enum": ["test", "harness", "make", "explicit"]},
        "entrypoint": {"type": "string", "minLength": 1}
      }
    },
    "selector": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": {"kind": {"const": "recursive_root"}, "path": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "pattern"], "properties": {"kind": {"const": "non_recursive_glob"}, "pattern": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": {"kind": {"const": "exact_file"}, "path": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "pattern"], "properties": {"kind": {"const": "external_glob"}, "pattern": {"type": "string", "pattern": "^\\.\\./"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "component"], "properties": {"kind": {"const": "manifest_population"}, "component": {"enum": ["root_lib", "core_root_lib", "dist", "ext", "cpan"]}}}
      ]
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["make_target", "perl_runtime", "required_products"],
      "properties": {
        "make_target": {"type": ["string", "null"]},
        "perl_runtime": {"enum": ["miniperl", "full_perl", "inherited"]},
        "required_products": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "reason_code", "claim_impact"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "reason_code": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "claim_impact": {"type": "string", "minLength": 1}
      }
    }
  }
}
