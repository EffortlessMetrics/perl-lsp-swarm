{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/perl-lsp-swarm/schemas/verified_child_receipt.v1.schema.json",
  "title": "verified_child_receipt.v1",
  "description": "Digest-bound envelope emitted after a child receipt has been validated by its owning checker.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owner_issue",
    "schema_version",
    "receipt_schema_version",
    "candidate_id",
    "frozen_product_sha",
    "artifact_set_id",
    "source_receipt_sha256",
    "status",
    "claim_boundary",
    "limitation"
  ],
  "properties": {
    "owner_issue": {
      "type": "string",
      "pattern": "^#[0-9]+$"
    },
    "schema_version": {
      "const": "verified_child_receipt.v1"
    },
    "receipt_schema_version": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "frozen_product_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "artifact_set_id": {
      "type": "string",
      "minLength": 1
    },
    "source_receipt_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": ["pass", "limited", "blocked", "not_proven"]
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "limitation": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    }
  }
}
