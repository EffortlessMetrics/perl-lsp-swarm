{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/perl_core_harness.current_authority_index.v1.schema.json",
  "title": "Perl core harness current authority index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": "perl_core_harness.current_authority_index.v1"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series_id", "profile", "manifest_hash", "observation_bundle_path",
        "observation_bundle_id", "observation_bundle_digest", "observation_transition",
        "accepted_baseline_path", "accepted_baseline_digest", "accepted_baseline_evidence_bundle",
        "accepted_transition_id", "landed_lineage_path",
        "status", "claim_boundary", "unavailable_rails"
      ],
      "properties": {
        "series_id": {"type": "string", "minLength": 1},
        "profile": {"enum": ["base", "comp", "run", "core", "lib", "full"]},
        "manifest_hash": {"type": "string", "minLength": 1},
        "observation_bundle_path": {"type": "string", "minLength": 1},
        "observation_bundle_id": {"type": "string", "minLength": 1},
        "observation_bundle_digest": {"pattern": "^sha256:[0-9a-fA-F]{64}$"},
        "observation_transition": {"enum": ["no_change", "improvement_candidate", "regression", "contract_correction_candidate", "not_proven", "historical"]},
        "accepted_baseline_path": {"type": ["string", "null"]},
        "accepted_baseline_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-fA-F]{64}$"},
        "accepted_baseline_evidence_bundle": {"type": ["string", "null"]},
        "accepted_transition_id": {"type": ["string", "null"]},
        "landed_lineage_path": {"type": "string", "minLength": 1},
        "status": {"enum": ["current", "historical", "superseded"]},
        "claim_boundary": {"type": "string", "minLength": 1},
        "unavailable_rails": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
