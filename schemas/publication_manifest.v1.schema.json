{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/perl-lsp-swarm/schemas/publication_manifest.v1.schema.json",
  "title": "publication_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "swarm_sha",
    "public_sha",
    "version",
    "rules",
    "required_invariants",
    "swarm_repository",
    "public_repository",
    "swarm_tree_digest",
    "public_tree_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "swarm_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "public_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "required_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/invariant"
      }
    },
    "swarm_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "public_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "swarm_tree_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "public_tree_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "classification",
        "owner"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\:]+(?:/[^/\\\\:]+)*$",
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        },
        "classification": {
          "enum": [
            "expected_publication_translation",
            "approved_lineage_exclusion",
            "release_metadata_only"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
