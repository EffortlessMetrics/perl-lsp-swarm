{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/perl_core_harness_target_topology_drift.v1.schema.json",
  "title": "Perl core harness target topology drift v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pinned_matrix_fingerprint",
    "observed_perl_ref",
    "observed_perl_resolved_ref",
    "observed_topology_sources",
    "added_target_ids",
    "removed_target_ids",
    "changed_target_ids",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "perl_core_harness.target_topology_drift.v1"
    },
    "pinned_matrix_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "observed_perl_ref": {
      "type": "string",
      "minLength": 1
    },
    "observed_perl_resolved_ref": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "observed_topology_sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{40}$"
      }
    },
    "added_target_ids": {
      "$ref": "#/$defs/target_ids"
    },
    "removed_target_ids": {
      "$ref": "#/$defs/target_ids"
    },
    "changed_target_ids": {
      "$ref": "#/$defs/target_ids"
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "target_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    }
  }
}
