{
  "id": "perl-lsp",
  "name": "Perl Language Server",
  "url": "https://github.com/EffortlessMetrics/perl-lsp",
  "programArgs": {
    "default": "sh -c ${BASE_DIR}/perllsp --stdio",
    "windows": "${BASE_DIR}/perllsp.exe --stdio"
  },
  "expandConfiguration": true,
  "fileTypeMappings": [
    {
      "fileType": {
        "name": "Perl",
        "patterns": [
          "*.pl",
          "*.pm",
          "*.t"
        ]
      },
      "languageId": "perl"
    }
  ]
}
