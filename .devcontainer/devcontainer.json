{
  "name": "perl-lsp-swarm",
  "dockerFile": "../.docker/perl-lsp/Dockerfile",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "customizations": {
    "vscode": {
      "settings": {
        "perl-lsp.server.path": "perllsp",
        "perl-lsp.server.args": ["--stdio"]
      }
    }
  },
  "remoteUser": "appuser",
  "features": {},
  "postCreateCommand": "perllsp --version",
  "comment": "Editor-inside-container topology (editor_inside_container). Host editors must use scripts/docker/run-perllsp-host-editor.sh instead."
}
