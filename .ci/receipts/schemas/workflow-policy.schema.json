{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/perl-lsp/workflow-policy.schema.json",
  "title": "workflow-policy-lint receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_kind",
    "passed",
    "error_count",
    "warning_count",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "receipt_kind": {
      "const": "workflow_policy_lint"
    },
    "passed": {
      "type": "boolean"
    },
    "error_count": {
      "type": "integer",
      "minimum": 0
    },
    "warning_count": {
      "type": "integer",
      "minimum": 0
    },
    "subject": {
      "type": "object",
      "required": [
        "mode",
        "selection",
        "path_identity_sha256",
        "workflow_file_count",
        "scan_completed",
        "lane_whitelist_requested",
        "isolation_registry_requested"
      ],
      "properties": {
        "mode": {
          "enum": ["repository", "fixture"]
        },
        "selection": {
          "enum": ["explicit_root", "compiled_root", "fixture"]
        },
        "path_identity_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "workflow_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "scan_completed": {
          "type": "boolean"
        },
        "lane_whitelist_requested": {
          "type": "boolean"
        },
        "isolation_registry_requested": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["level", "code", "workflow", "message"],
        "properties": {
          "level": {
            "enum": ["error", "warning"]
          },
          "code": {
            "type": "string"
          },
          "workflow": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
