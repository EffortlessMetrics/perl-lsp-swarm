{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/intent-diff-gate.schema.json",
  "title": "intent-diff-gate receipt",
  "type": "object",
  "required": [
    "claimed_component",
    "claimed_closeout_issues",
    "expected_paths",
    "actual_paths",
    "source_state",
    "evidence",
    "verdict",
    "violations"
  ],
  "properties": {
    "claimed_component": {
      "type": ["string", "null"]
    },
    "claimed_closeout_issues": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 }
    },
    "expected_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "actual_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "source_state": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "base_sha", "head_sha"],
          "properties": {
            "kind": { "const": "complete" },
            "base_sha": { "type": ["string", "null"] },
            "head_sha": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "partial" },
            "reason": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "unavailable" },
            "reason": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ],
      "description": "Typed state of the PR change-set observation (#15384). Only `complete` may authorise a closeout verdict; `partial`/`unavailable` sources force a `closeout_with_incomplete_source` fail when the PR body uses a closing keyword."
    },
    "evidence": {
      "type": "object",
      "required": [
        "target_path_touched",
        "test_updated",
        "behavior_receipt",
        "override_approved"
      ],
      "properties": {
        "target_path_touched": { "type": "boolean" },
        "test_updated": { "type": "boolean" },
        "behavior_receipt": { "type": "boolean" },
        "override_approved": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "warn", "fail"]
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "level", "message"],
        "properties": {
          "code": { "type": "string" },
          "level": { "type": "string", "enum": ["warn", "fail"] },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
