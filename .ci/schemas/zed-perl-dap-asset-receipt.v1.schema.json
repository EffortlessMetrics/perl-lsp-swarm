{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/perl-lsp-swarm/.ci/schemas/zed-perl-dap-asset-receipt.v1.schema.json",
  "title": "Zed perl-dap public asset receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "result", "observed_at", "contract", "release", "topology", "projection", "verifier", "targets", "cache_recovery", "limitations", "claim_boundary", "currentness"],
  "allOf": [
    {
      "if": {
        "properties": {"result": {"not": {"const": "not_run"}}},
        "required": ["result"]
      },
      "then": {
        "properties": {
          "contract": {
            "properties": {
              "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            },
            "required": ["sha256"]
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {"const": "zed_perl_dap_asset_receipt.v1"},
    "stage": {"const": "public_perl_dap_asset"},
    "result": {"enum": ["not_run", "pass", "fail", "instrument_failed", "contract_stale"]},
    "observed_at": {"type": ["string", "null"], "format": "date-time"},
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "schema_version"],
      "properties": {
        "relative_path": {"type": "string"},
        "sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "schema_version": {"const": "zed_perl_dap_managed_downloads.v1"}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "id", "tag", "version", "prerelease", "draft", "published_at", "producer"],
      "properties": {
        "repository": {"const": "EffortlessMetrics/perl-lsp"},
        "id": {"type": ["integer", "null"]},
        "tag": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]},
        "prerelease": {"type": ["boolean", "null"]},
        "draft": {"type": ["boolean", "null"]},
        "published_at": {"type": ["string", "null"]},
        "producer": {"type": ["string", "null"]}
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "sha256"],
      "properties": {
        "subject": {"const": "docs/reference/downstream-dap-integrations.json"},
        "sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zed_adapter_subject", "sha256", "debug_adapter_id"],
      "properties": {
        "zed_adapter_subject": {"const": ".ci/fixtures/zed-perl-upstream/manifest.toml"},
        "sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "debug_adapter_id": {"const": "perl-dap"}
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "version", "architecture", "python"],
      "properties": {
        "os": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]},
        "architecture": {"type": ["string", "null"]},
        "python": {"type": ["string", "null"]}
      }
    },
    "targets": {"type": "array", "items": {"$ref": "#/$defs/target"}},
    "cache_recovery": {
      "type": ["object", "null"],
      "required": ["result", "known_good_before", "selected_after", "scenario_results"],
      "properties": {
        "result": {"enum": ["pass", "fail"]}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_bytes", "archive_layout", "dap_process", "cache_recovery", "real_zed_debug_session", "actual_zed", "public_registry"],
      "properties": {
        "asset_bytes": {"enum": ["not_run", "proven"]},
        "archive_layout": {"enum": ["not_run", "proven"]},
        "dap_process": {"enum": ["not_run", "proven_for_matching_host_only", "not_executed_on_this_verifier"]},
        "cache_recovery": {"enum": ["not_run", "proven_isolated_cache_model_only"]},
        "real_zed_debug_session": {"const": "not_proven"},
        "actual_zed": {"const": "not_proven"},
        "public_registry": {"const": "not_proven"}
      }
    },
    "currentness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invalidators"],
      "properties": {
        "invalidators": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "os", "architecture", "disposition", "result", "asset", "archive", "binary", "stdio_smoke", "errors"],
      "properties": {
        "target": {"type": "string"},
        "os": {"type": "string"},
        "architecture": {"type": "string"},
        "disposition": {"enum": ["managed", "path_only", "deferred", "unsupported"]},
        "result": {"enum": ["not_run", "managed_executed", "managed_extracted_not_executed", "path_only", "deferred", "unsupported", "fail"]},
        "asset": {"type": ["object", "null"]},
        "archive": {"type": ["object", "null"]},
        "binary": {"type": ["object", "null"]},
        "stdio_smoke": {"type": ["object", "null"]},
        "errors": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
