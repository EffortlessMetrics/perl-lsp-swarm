{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EffortlessMetrics/perl-lsp-swarm/main/.ci/schemas/agent-client-compat.v1.schema.json",
  "title": "agent_client_compat.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "stage",
    "repository",
    "candidate_sha",
    "platform",
    "host",
    "integration",
    "server",
    "workspace_fixture",
    "journey",
    "result",
    "limitations",
    "artifacts",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": { "const": "agent_client_compat.v1" },
    "observed_at": { "type": "string", "format": "date-time", "minLength": 1 },
    "stage": {
      "enum": ["static_package", "exact_source_local", "public_artifact", "official_directory"]
    },
    "repository": { "type": "string", "minLength": 1 },
    "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "platform": { "$ref": "#/$defs/platform" },
    "host": { "$ref": "#/$defs/host" },
    "integration": { "$ref": "#/$defs/integration" },
    "server": { "$ref": "#/$defs/server" },
    "workspace_fixture": { "$ref": "#/$defs/workspaceFixture" },
    "journey": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Journey cell objects must be unique; the Rust validator additionally enforces uniqueness by id.",
      "items": { "$ref": "#/$defs/journeyCell" }
    },
    "result": { "enum": ["pass", "fail", "partial", "not_proven", "unsupported"] },
    "failure_class": {
      "enum": ["product", "host_plugin", "fixture", "protocol", "instrument", "environment"]
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "claim_boundary": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "result": { "enum": ["fail", "not_proven"] } },
        "required": ["result"]
      },
      "then": { "required": ["failure_class"] }
    },
    {
      "if": { "properties": { "result": { "const": "pass" } }, "required": ["result"] },
      "then": {
        "not": { "required": ["failure_class"] },
        "properties": {
          "journey": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/journeyCell" },
                { "properties": { "result": { "enum": ["pass", "unsupported"] } } }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "result": { "enum": ["partial", "unsupported"] } },
        "required": ["result"]
      },
      "then": { "properties": { "limitations": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "os_version", "arch"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "os_version": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "version"],
      "properties": {
        "product": { "enum": ["claude_code", "codex_cli", "codex_desktop", "codex_ide"] },
        "version": { "type": "string", "minLength": 1 },
        "instrument_model": { "type": "string", "minLength": 1 }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "plugin_name", "plugin_version", "marketplace_source", "marketplace_ref", "package_sha256"],
      "properties": {
        "mode": { "enum": ["native_lsp_plugin", "cli_skill", "native_local_mcp", "external_bridge"] },
        "plugin_name": { "type": "string", "minLength": 1 },
        "plugin_version": { "type": "string", "minLength": 1 },
        "marketplace_source": { "type": "string", "minLength": 1 },
        "marketplace_ref": { "type": "string", "minLength": 1 },
        "package_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "version", "build_revision", "artifact_sha256", "protocol", "protocol_or_schema_version"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "build_revision": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "protocol": { "enum": ["lsp", "mcp", "cli"] },
        "protocol_or_schema_version": { "type": "string", "minLength": 1 }
      }
    },
    "workspaceFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "journeyCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "result", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
        "result": { "enum": ["pass", "fail", "partial", "not_proven", "unsupported"] },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "limitation": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "result": { "enum": ["partial", "not_proven"] } },
            "required": ["result"]
          },
          "then": { "required": ["limitation"] }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![~/])(?![A-Za-z]:/)(?!.*://)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
