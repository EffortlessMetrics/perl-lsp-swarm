{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/perl-lsp/.ci/schemas/ux-flakes.schema.json",
  "title": "perl-lsp UX flake ledger",
  "description": "Registry of known-flaky or known-blocked UX scenario tests with quarantine support, terminal dispositions, and evidence-backed replacement mappings.",
  "type": "object",
  "required": [
    "schema_version",
    "entries",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "description": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flakeEntry"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "$defs": {
    "disposition": {
      "enum": [
        "still_failing",
        "stabilized",
        "resolved_by_intent",
        "folded",
        "not_proven"
      ],
      "description": "Terminal reconciliation result for the historical failure claim."
    },
    "evidence": {
      "type": "object",
      "required": [
        "command",
        "verification_pr",
        "verified_sha",
        "replacement_tests"
      ],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "Hard-fail command used to verify the maintained executable contract."
        },
        "verification_pr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Pull request carrying the exact-head verification run."
        },
        "verified_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$",
          "description": "Exact commit SHA verified by the hard-fail lane, when recorded."
        },
        "replacement_tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Maintained executable tests that now own the historical intent."
        }
      }
    },
    "flakeEntry": {
      "type": "object",
      "required": [
        "test",
        "crate",
        "subsystem",
        "state",
        "disposition",
        "failure_mode",
        "failure_class",
        "component",
        "issue",
        "owner",
        "first_seen",
        "scope",
        "quarantine_effect",
        "expires_after_days",
        "resolved_in",
        "resolved_at",
        "evidence",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "test": {
          "type": "string",
          "minLength": 1,
          "description": "Fully qualified historical test name (module::function)."
        },
        "crate": {
          "type": "string",
          "minLength": 1,
          "description": "Crate containing the test or replacement contract."
        },
        "subsystem": {
          "type": "string",
          "minLength": 1,
          "description": "Subsystem owner for triage routing."
        },
        "state": {
          "enum": [
            "active",
            "resolved"
          ],
          "description": "Whether a current failure remains actionable."
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "failure_mode": {
          "type": "string",
          "minLength": 1,
          "description": "Historical failure behavior."
        },
        "failure_class": {
          "enum": [
            "provider_regression",
            "server_crash",
            "timeout",
            "test_race",
            "infra",
            "matrix_drift",
            "baseline_drift",
            "new_test_bug",
            "unknown"
          ],
          "description": "UxFailureClass enum value classifying the failure."
        },
        "component": {
          "enum": [
            "completion",
            "diagnostics",
            "module_resolution",
            "workspace_symbols",
            "rename",
            "hover",
            "goto_definition",
            "infra"
          ],
          "description": "UxComponent enum value identifying the subsystem exercised."
        },
        "issue": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Current GitHub issue for active failures; null when no current failure remains."
        },
        "owner": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Current responsible party for active failures; null when no current failure remains."
        },
        "first_seen": {
          "type": "string",
          "format": "date",
          "description": "ISO-8601 date when the failure was first observed."
        },
        "scope": {
          "enum": [
            "pr",
            "nightly",
            "release"
          ],
          "description": "CI tier where the historical failure manifested."
        },
        "quarantine_effect": {
          "enum": [
            "non_blocking_pr",
            "release_blocking",
            "advisory"
          ],
          "description": "Historical quarantine effect."
        },
        "expires_after_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Optional auto-expiry for active entries."
        },
        "resolved_in": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "PR that recorded the terminal disposition."
        },
        "resolved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Date the terminal disposition was recorded."
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "description": "Rationale preserving the distinction between stabilization and changed intent."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "active"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "disposition": {
                "enum": [
                  "still_failing",
                  "not_proven"
                ]
              },
              "issue": {
                "type": "integer",
                "minimum": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "resolved_in": {
                "type": "null"
              },
              "resolved_at": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "disposition": {
                "enum": [
                  "stabilized",
                  "resolved_by_intent",
                  "folded",
                  "not_proven"
                ]
              },
              "resolved_at": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "active",
        "resolved",
        "by_subsystem",
        "by_disposition"
      ],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "active": {
          "type": "integer",
          "minimum": 0
        },
        "resolved": {
          "type": "integer",
          "minimum": 0
        },
        "by_subsystem": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_disposition": {
          "type": "object",
          "required": [
            "still_failing",
            "stabilized",
            "resolved_by_intent",
            "folded",
            "not_proven"
          ],
          "additionalProperties": false,
          "properties": {
            "still_failing": {
              "type": "integer",
              "minimum": 0
            },
            "stabilized": {
              "type": "integer",
              "minimum": 0
            },
            "resolved_by_intent": {
              "type": "integer",
              "minimum": 0
            },
            "folded": {
              "type": "integer",
              "minimum": 0
            },
            "not_proven": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
