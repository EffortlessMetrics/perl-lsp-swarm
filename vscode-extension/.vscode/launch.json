{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "extensionHost",
      "request": "launch",
      "name": "Run Extension (checked build)",
      "preLaunchTask": "perl-lsp: checked build",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/.vscode/dev-workspace"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"]
    },
    {
      "type": "extensionHost",
      "request": "launch",
      "name": "Run Extension (dev watch)",
      "preLaunchTask": "perl-lsp: dev watch (supervisor)",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/.vscode/dev-workspace"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"]
    }
  ]
}
