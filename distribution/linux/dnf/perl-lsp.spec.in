# This scaffold repackages release binaries built with strip = "debuginfo".
# There is no DWARF to split; the pre-install guard refuses unexpected debug inputs
# before the standard RPM strip/policy scripts can discard their information.
%global debug_package %{nil}

Name:           __PACKAGE_NAME__
Version:        __RELEASE_VERSION__
Release:        1%{?dist}
Summary:        __PACKAGE_SUMMARY__
License:        __PACKAGE_LICENSE__
URL:            __PACKAGE_HOMEPAGE__
BuildArch:      __RPM_ARCH__
Source0:        __DOWNLOAD_URL__
BuildRequires:  binutils

%description
perl-lsp is a public-beta Perl language server written in Rust.
This package installs the perllsp and perl-dap executables from the public-beta release artifact.

%prep
%autosetup -n __SOURCE_DIR__

%build
for binary in perllsp perl-dap; do
    header=$(LC_ALL=C readelf -h "$binary") || {
        echo "Release binary $binary is not a readable ELF executable" >&2
        exit 1
    }
    if ! printf '%s\n' "$header" | grep -Eq 'Type:[[:space:]]+(EXEC|DYN)[[:space:]]' ||
       printf '%s\n' "$header" | grep -Eq 'Entry point address:[[:space:]]+0x0+$'; then
        echo "Release binary $binary is not a readable ELF executable" >&2
        exit 1
    fi
    sections=$(LC_ALL=C readelf -SW "$binary") || exit 1
    if printf '%s\n' "$sections" | grep -Eq '[[:space:]](\.debug_|\.zdebug_|\.gnu_debug(data|link|altlink)|\.stab(str)?([[:space:]]|\.)|\.gdb_index[[:space:]])'; then
        echo "Release binary $binary contains debug information; use debug-preserving packaging" >&2
        exit 1
    fi
done

%install
rm -rf %{buildroot}
install -Dpm 0755 perllsp %{buildroot}%{_bindir}/perllsp
install -Dpm 0755 perl-dap %{buildroot}%{_bindir}/perl-dap

%files
%license LICENSE-MIT LICENSE-APACHE
%doc README.md
%{_bindir}/perllsp
%{_bindir}/perl-dap

%changelog
* Thu Jan 01 1970 __PACKAGE_MAINTAINER__ - __RELEASE_VERSION__-1
- Initial packaging template
