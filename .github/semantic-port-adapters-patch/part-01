+/// Adapter-construction failure that prevents truthful fact attribution.
+#[non_exhaustive]
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ProviderAdapterError {
+    /// Snapshot metadata is malformed.
+    InvalidSnapshot(String),
+    /// A shard has no stable source URI.
+    InvalidShardIdentity(FileId),
+    /// Two shards claim the same file identity.
+    DuplicateShardFile(FileId),
+    /// Two shards claim the same canonical source URI.
+    DuplicateShardSourceUri(String),
+    /// One shard repeats an anchor identity.
+    DuplicateAnchor {
+        /// File containing the duplicate identity.
+        file_id: FileId,
+        /// Repeated anchor identity.
+        anchor_id: AnchorId,
+    },
+    /// One shard repeats an entity identity.
+    DuplicateEntity {
+        /// File containing the duplicate identity.
+        file_id: FileId,
+        /// Repeated entity identity.
+        entity_id: EntityId,
+    },
+    /// One shard repeats an occurrence identity.
+    DuplicateOccurrence {
+        /// File containing the duplicate identity.
+        file_id: FileId,
+        /// Repeated occurrence identity.
+        occurrence_id: OccurrenceId,
+    },
+    /// An anchor claims a file other than its containing shard.
+    AnchorFileMismatch {
+        /// File identity owned by the shard.
+        shard_file_id: FileId,
+        /// File identity carried by the anchor.
+        anchor_file_id: FileId,
+        /// Mismatched anchor identity.
+        anchor_id: AnchorId,
+    },
+    /// Two adapted or canonical facts claim the same canonical identity.
+    DuplicateFactId(FactId),
+    /// A canonical collection has no fact-backed source trace.
+    MissingCanonicalEvidence,
+    /// A canonical or adapted envelope fails the provider fact contract.
+    InvalidFact {
+        /// Rejected fact identity.
+        fact_id: FactId,
+        /// Checked contract failure.
+        reason: ProviderQueryContractError,
+    },
+}
+
+impl fmt::Display for ProviderAdapterError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::InvalidSnapshot(reason) => {
+                write!(formatter, "invalid adapter snapshot: {reason}")
+            }
+            Self::InvalidShardIdentity(file_id) => {
+                write!(formatter, "file-fact shard {} has no source URI", file_id.0)
+            }
+            Self::DuplicateShardFile(file_id) => {
+                write!(formatter, "duplicate file-fact shard identity {}", file_id.0)
+            }
+            Self::DuplicateShardSourceUri(uri) => {
+                write!(formatter, "duplicate file-fact shard source URI {uri}")
+            }
+            Self::DuplicateAnchor { file_id, anchor_id } => write!(
+                formatter,
+                "file {} repeats anchor identity {}",
+                file_id.0, anchor_id.0
+            ),
+            Self::DuplicateEntity { file_id, entity_id } => write!(
+                formatter,
+                "file {} repeats entity identity {}",
+                file_id.0, entity_id.0
+            ),
+            Self::DuplicateOccurrence { file_id, occurrence_id } => write!(
+                formatter,
+                "file {} repeats occurrence identity {}",
+                file_id.0, occurrence_id.0
+            ),
+            Self::AnchorFileMismatch {
+                shard_file_id,
+                anchor_file_id,
+                anchor_id,
+            } => write!(
+                formatter,
+                "anchor {} claims file {} inside shard {}",
+                anchor_id.0, anchor_file_id.0, shard_file_id.0
+            ),
+            Self::DuplicateFactId(fact_id) => {
+                write!(formatter, "duplicate adapted fact identity {}", fact_id.0)
+            }
+            Self::MissingCanonicalEvidence => {
+                write!(formatter, "canonical adapter has no fact-backed source evidence")
+            }
+            Self::InvalidFact { fact_id, reason } => {
+                write!(formatter, "adapted fact {} is invalid: {reason}", fact_id.0)
+            }
+        }
+    }
+}
+
+impl Error for ProviderAdapterError {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::InvalidFact { reason, .. } => Some(reason),
+            _ => None,
+        }
+    }
+}
