+/// One already-canonical envelope plus the only adapter-owned matching metadata.
+///
+/// Canonical entity, file, package, scope, source geometry, producer, lifecycle,
+/// provenance, confidence, freshness, and boundary fields remain inside the
+/// envelope. The adapter may add only source-level symbol aliases and the request
+/// generation to which the producer bound that fact.
+#[non_exhaustive]
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct CanonicalEnvelopeInput {
+    envelope: SemanticFactEnvelope,
+    generation_scope: ProviderFactGenerationScope,
+    symbols: Vec<String>,
+}
+
+impl CanonicalEnvelopeInput {
+    /// Validate and canonicalize one canonical envelope input.
+    pub fn try_new(
+        envelope: SemanticFactEnvelope,
+        generation_scope: ProviderFactGenerationScope,
+        symbols: impl IntoIterator<Item = String>,
+    ) -> Result<Self, ProviderAdapterError> {
+        let fact_id = envelope.fact_id;
+        let mut symbols: Vec<_> = symbols.into_iter().collect();
+        symbols.sort();
+        symbols.dedup();
+        ProviderQueryFact::try_new(
+            ProviderQueryFactRole::Supporting,
+            generation_scope,
+            envelope.clone(),
+            symbols.clone(),
+        )
+        .map_err(|reason| ProviderAdapterError::InvalidFact { fact_id, reason })?;
+        Ok(Self {
+            envelope,
+            generation_scope,
+            symbols,
+        })
+    }
+
+    /// Canonical envelope retained by this input.
+    #[must_use]
+    pub const fn envelope(&self) -> &SemanticFactEnvelope {
+        &self.envelope
+    }
+
+    /// Request generation to which this fact is bound.
+    #[must_use]
+    pub const fn generation_scope(&self) -> ProviderFactGenerationScope {
+        self.generation_scope
+    }
+
+    /// Canonical source-level symbol aliases.
+    #[must_use]
+    pub fn symbols(&self) -> &[String] {
+        &self.symbols
+    }
+}
