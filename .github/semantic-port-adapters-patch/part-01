+#[derive(Debug, Clone, PartialEq, Eq)]
+struct AdapterFactRecord {
+    envelope: SemanticFactEnvelope,
+    generation_scope: ProviderFactGenerationScope,
+    symbols: Vec<String>,
+    occurrence_kind: Option<OccurrenceKind>,
+    trace_source: ProviderFactSourceKind,
+    source_hash: Option<String>,
+    model_version: Option<u32>,
+}
+
+impl AdapterFactRecord {
+    fn try_new(
+        envelope: SemanticFactEnvelope,
+        generation_scope: ProviderFactGenerationScope,
+        mut symbols: Vec<String>,
+        occurrence_kind: Option<OccurrenceKind>,
+        trace_source: ProviderFactSourceKind,
+        source_hash: Option<String>,
+        model_version: Option<u32>,
+    ) -> Result<Self, ProviderAdapterError> {
+        symbols.sort();
+        symbols.dedup();
+        let fact_id = envelope.fact_id;
+        ProviderQueryFact::try_new(
+            ProviderQueryFactRole::Supporting,
+            generation_scope,
+            envelope.clone(),
+            symbols.clone(),
+        )
+        .map_err(|reason| ProviderAdapterError::InvalidFact { fact_id, reason })?;
+        Ok(Self {
+            envelope,
+            generation_scope,
+            symbols,
+            occurrence_kind,
+            trace_source,
+            source_hash,
+            model_version,
+        })
+    }
+
+    fn to_query_fact(
+        &self,
+        role: ProviderQueryFactRole,
+    ) -> Result<ProviderQueryFact, ProviderQueryContractError> {
+        ProviderQueryFact::try_new(
+            role,
+            self.generation_scope,
+            self.envelope.clone(),
+            self.symbols.clone(),
+        )
+    }
+
+    fn trace(
+        &self,
+        request: &ProviderQueryRequest,
+        fallback_state: ProviderFallbackState,
+    ) -> Option<ProviderFactTrace> {
+        let SemanticProvenance::Known(provenance) = self.envelope.provenance else {
+            return None;
+        };
+        let SemanticConfidence::Known(confidence) = self.envelope.confidence else {
+            return None;
+        };
+        Some(ProviderFactTrace::new(
+            request.surface,
+            self.trace_source,
+            provenance,
+            confidence,
+            provider_freshness(self.envelope.freshness),
+            fallback_state,
+            self.source_hash.clone(),
+            self.envelope.anchor.anchor_id,
+            self.model_version,
+        ))
+    }
+
+    fn directly_matches(&self, subject: &ProviderQuerySubject) -> bool {
+        match subject {
+            ProviderQuerySubject::Entity(entity_id) => self.envelope.entity_id == Some(*entity_id),
+            ProviderQuerySubject::File(file_id) => self.envelope.anchor.file_id == *file_id,
+            ProviderQuerySubject::Position {
+                file_id,
+                byte_offset,
+            } => {
+                self.envelope.anchor.file_id == *file_id
+                    && range_contains(&self.envelope.anchor, *byte_offset)
+            }
+            ProviderQuerySubject::Package(package) => {
+                self.envelope.package.as_deref() == Some(package.as_str())
+            }
+            ProviderQuerySubject::Symbol(symbol) => {
+                self.symbols.binary_search(symbol).is_ok()
+            }
+            ProviderQuerySubject::Workspace => true,
+        }
+    }
+
+    fn is_current_for(&self, request: &ProviderQueryRequest) -> bool {
+        let expected = match self.generation_scope {
+            ProviderFactGenerationScope::Document => &request.context.document_generation,
+            ProviderFactGenerationScope::Workspace => &request.context.workspace_generation,
+        };
+        generation_is_known(expected)
+            && generation_is_known(&self.envelope.source_generation)
+            && &self.envelope.source_generation == expected
+    }
+
+    fn is_exact_for(&self, request: &ProviderQueryRequest) -> bool {
+        self.is_current_for(request)
+            && self.envelope.status() == SemanticFactStatus::Exact
+            && self.envelope.boundary.is_none()
+    }
+}
