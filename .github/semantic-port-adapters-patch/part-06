+fn shard_fact_and_entity_identities_include_file_identity() -> Result<(), Box<dyn Error>> {
+    let port = FileFactShardPort::try_new(
+        &[
+            complete_shard(FileId(10), "file:///one.pl"),
+            complete_shard(FileId(11), "file:///two.pl"),
