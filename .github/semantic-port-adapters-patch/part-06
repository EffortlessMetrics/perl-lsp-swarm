+        snapshot()?,
+    )?;
+    let workspace = execute_provider_query(
+        &port,
+        &request(
+            ProviderQueryKind::Declaration,
+            ProviderQuerySubject::Workspace,
+        ),
+        &NoopProviderQueryControl,
+    )?;
+    assert_eq!(workspace.outcome(), ProviderQueryOutcome::Exact);
+    let fact_ids: BTreeSet<_> = workspace.value_facts().map(|fact| fact.fact_id).collect();
+    let entity_ids: BTreeSet<_> = workspace
+        .value_facts()
+        .filter_map(|fact| fact.entity_id)
+        .collect();
+    assert_eq!(fact_ids.len(), 2);
+    assert_eq!(entity_ids.len(), 2);
+    let first_entity = port.canonical_entity_id(FileId(10), EntityId(30));
+    let second_entity = port.canonical_entity_id(FileId(11), EntityId(30));
+    assert!(first_entity.is_some());
+    assert!(second_entity.is_some());
+    assert_ne!(first_entity, second_entity);
+
+    let from_first_file = execute_provider_query(
+        &port,
+        &request(
+            ProviderQueryKind::Declaration,
+            ProviderQuerySubject::Position {
+                file_id: FileId(10),
+                byte_offset: 21,
+            },
+        ),
+        &NoopProviderQueryControl,
+    )?;
+    assert_eq!(from_first_file.value_facts().count(), 1);
+    assert!(from_first_file
+        .value_facts()
+        .all(|fact| fact.anchor.file_id == FileId(10)));
+    Ok(())
+}
