        let selectors = direct_records(&request.subject, records);
+            let targets = entity_ids(&selectors);
+            selection.ambiguous = targets.len() > 1;
+            for record in selectors {
+                let role = if is_declaration(record) {
+                    ProviderQueryFactRole::SelectorValue
+                } else {
+                    ProviderQueryFactRole::Selector
+                };
+                selection.insert(record, role);
+            }
+            if !selection.ambiguous {
+                for record in records.iter().filter(|record| {
+                    is_declaration(record)
+                        && record
+                            .envelope
+                            .entity_id
+                            .is_some_and(|entity_id| targets.contains(&entity_id))
+                }) {
+                    selection.insert(record, ProviderQueryFactRole::Value);
+                }
+            }
+        }
+        ProviderQuerySubject::Symbol(_) => {
+            let candidates: Vec<_> = records
+                .iter()
+                .filter(|record| record.directly_matches(&request.subject))
+                .collect();
+            let targets = entity_ids(&candidates);
+            selection.ambiguous = targets.len() > 1;
+            if selection.ambiguous {
+                for record in candidates {
+                    selection.insert(record, ProviderQueryFactRole::Supporting);
+                }
+            } else {
+                for record in records.iter().filter(|record| {
+                    is_declaration(record)
+                        && (record.directly_matches(&request.subject)
+                            || record
+                                .envelope
+                                .entity_id
+                                .is_some_and(|entity_id| targets.contains(&entity_id)))
+                }) {
+                    selection.insert(record, ProviderQueryFactRole::Value);
+                }
+            }
+        }
+        _ => {
+            for record in records.iter().filter(|record| {
+                is_declaration(record) && record.directly_matches(&request.subject)
+            }) {
+                selection.insert(record, ProviderQueryFactRole::Value);
+            }
+        }
+    }
+    add_direct_boundaries(&request.subject, records, &mut selection);
+    selection
+}
