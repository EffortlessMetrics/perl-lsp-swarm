+fn select_references<'a>(
+    request: &ProviderQueryRequest,
+    records: &'a [AdapterFactRecord],
+    include_declaration: bool,
+) -> QuerySelection<'a> {
+    let mut selection = QuerySelection::default();
+    match &request.subject {
+        ProviderQuerySubject::Position { .. } => {
+            let selectors = direct_records(&request.subject, records);
+            let targets = entity_ids(&selectors);
+            selection.ambiguous = targets.len() > 1;
+            for record in selectors {
+                selection.insert(record, ProviderQueryFactRole::Selector);
+            }
+            if !selection.ambiguous {
+                add_reference_values(
+                    records,
+                    &targets,
+                    include_declaration,
+                    &mut selection,
+                );
+            }
+        }
+        ProviderQuerySubject::Symbol(_) => {
+            let candidates: Vec<_> = records
+                .iter()
+                .filter(|record| record.directly_matches(&request.subject))
+                .collect();
+            let targets = entity_ids(&candidates);
+            selection.ambiguous = targets.len() > 1;
+            if selection.ambiguous {
+                for record in candidates {
+                    selection.insert(record, ProviderQueryFactRole::Supporting);
+                }
+            } else {
+                add_reference_values(
+                    records,
+                    &targets,
+                    include_declaration,
+                    &mut selection,
+                );
+            }
+        }
+        ProviderQuerySubject::Entity(entity_id) => {
+            add_reference_values(
+                records,
+                &BTreeSet::from([*entity_id]),
+                include_declaration,
+                &mut selection,
+            );
+        }
+        ProviderQuerySubject::File(_)
+        | ProviderQuerySubject::Package(_)
+        | ProviderQuerySubject::Workspace => {
+            for record in records.iter().filter(|record| {
+                record.directly_matches(&request.subject)
+                    && (is_reference_occurrence(record)
+                        || include_declaration && is_declaration(record))
+            }) {
+                selection.insert(record, ProviderQueryFactRole::Value);
+            }
+        }
+    }
+    add_direct_boundaries(&request.subject, records, &mut selection);
+    selection
+}
