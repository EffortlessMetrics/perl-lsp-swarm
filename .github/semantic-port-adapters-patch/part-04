+fn select_boundaries<'a>(
+    request: &ProviderQueryRequest,
+    records: &'a [AdapterFactRecord],
+) -> QuerySelection<'a> {
+    let mut selection = QuerySelection::default();
+    for record in records.iter().filter(|record| {
+        record.envelope.kind == SemanticFactKind::Boundary
+            && record.directly_matches(&request.subject)
+    }) {
+        let role = if matches!(&request.subject, ProviderQuerySubject::Position { .. }) {
+            ProviderQueryFactRole::SelectorValue
+        } else {
+            ProviderQueryFactRole::Value
+        };
+        selection.insert(record, role);
+    }
+    selection
+}
+
+fn add_reference_values<'a>(
+    records: &'a [AdapterFactRecord],
+    targets: &BTreeSet<EntityId>,
+    include_declaration: bool,
+    selection: &mut QuerySelection<'a>,
+) {
+    if targets.is_empty() {
+        return;
+    }
+    for record in records.iter().filter(|record| {
+        record
+            .envelope
+            .entity_id
+            .is_some_and(|entity_id| targets.contains(&entity_id))
+            && (is_reference_occurrence(record)
+                || include_declaration && is_declaration(record))
+    }) {
+        selection.insert(record, ProviderQueryFactRole::Value);
+    }
+}
+
+fn add_direct_boundaries<'a>(
+    subject: &ProviderQuerySubject,
+    records: &'a [AdapterFactRecord],
+    selection: &mut QuerySelection<'a>,
+) {
+    for record in records.iter().filter(|record| {
+        record.envelope.kind == SemanticFactKind::Boundary && record.directly_matches(subject)
+    }) {
+        let role = if matches!(subject, ProviderQuerySubject::Position { .. }) {
+            ProviderQueryFactRole::Selector
+        } else {
+            ProviderQueryFactRole::Supporting
+        };
+        selection.insert(record, role);
+    }
+}
+
+fn direct_records<'a>(
+    subject: &ProviderQuerySubject,
+    records: &'a [AdapterFactRecord],
+) -> Vec<&'a AdapterFactRecord> {
+    records
+        .iter()
+        .filter(|record| record.directly_matches(subject))
+        .collect()
+}
+
+fn entity_ids(records: &[&AdapterFactRecord]) -> BTreeSet<EntityId> {
+    records
+        .iter()
+        .filter(|record| record.envelope.kind != SemanticFactKind::Boundary)
+        .filter_map(|record| record.envelope.entity_id)
+        .collect()
+}
+
+fn is_declaration(record: &AdapterFactRecord) -> bool {
+    matches!(
+        record.envelope.kind,
+        SemanticFactKind::Declaration | SemanticFactKind::Module
+    )
+}
+
+fn is_reference_occurrence(record: &AdapterFactRecord) -> bool {
+    record.envelope.kind == SemanticFactKind::Occurrence
+        && record.occurrence_kind != Some(OccurrenceKind::Definition)
+}
+
+fn is_scope_fact(record: &AdapterFactRecord) -> bool {
+    matches!(
+        record.envelope.kind,
+        SemanticFactKind::Declaration | SemanticFactKind::Occurrence
+    )
+}
+
+fn merge_roles(
+    left: ProviderQueryFactRole,
+    right: ProviderQueryFactRole,
+) -> ProviderQueryFactRole {
+    if left == right {
+        return left;
+    }
+    if left == ProviderQueryFactRole::SelectorValue
+        || right == ProviderQueryFactRole::SelectorValue
+        || role_is_selector(left) && role_is_value(right)
+        || role_is_value(left) && role_is_selector(right)
+    {
+        ProviderQueryFactRole::SelectorValue
+    } else if left == ProviderQueryFactRole::Supporting {
+        right
+    } else {
+        left
+    }
+}
+
+fn role_is_selector(role: ProviderQueryFactRole) -> bool {
+    matches!(
+        role,
+        ProviderQueryFactRole::Selector | ProviderQueryFactRole::SelectorValue
+    )
+}
+
+fn role_is_value(role: ProviderQueryFactRole) -> bool {
+    matches!(
+        role,
+        ProviderQueryFactRole::Value | ProviderQueryFactRole::SelectorValue
+    )
+}
+
+fn role_is_supporting(role: ProviderQueryFactRole) -> bool {
+    role == ProviderQueryFactRole::Supporting
+}
