+//! Truthful adapters from current semantic fact producers into the provider port.
+//!
+//! This module is additive: it does not route live provider requests or change
+//! provider answers. It adapts current file-fact shards and already-canonical
+//! semantic envelopes into the checked query contract while preserving source,
+//! generation, producer, provenance, confidence, lifecycle, and boundary state.
+//!
+//! Exact-empty authority is intentionally narrow. Only a concrete, file-bounded
+//! [`FileFactShard`] denominator whose category hashes prove coverage may issue a
+//! request-bound completeness grant. Canonical envelope collections never infer
+//! completeness from the presence, label, or producer of unrelated facts.
+
+use super::semantic_port::{
+    ProviderCompletenessGrant, ProviderFactGenerationScope, ProviderQueryCapability,
+    ProviderQueryContractError, ProviderQueryControl, ProviderQueryEvidenceInput,
+    ProviderQueryFact, ProviderQueryFactRole, ProviderQueryKind, ProviderQueryOutcome,
+    ProviderQueryRequest, ProviderQueryResultDraft, ProviderQuerySubject,
+    ProviderQueryTerminalState, ProviderReadinessRequirement, ProviderReadinessState,
+    ProviderResultPath, ProviderSemanticPort, issue_provider_completeness_grant,
+};
+use perl_semantic_facts::{
+    AnchorFact, AnchorId, BoundaryDisposition, BoundaryKind, BoundaryLink, Confidence, EntityFact,
+    EntityId, EntityKind, FactId, FileId, LifecyclePhase, OccurrenceFact, OccurrenceId,
+    OccurrenceKind, Provenance, ProviderFactFreshness, ProviderFactSourceKind, ProviderFactTrace,
+    ProviderFallbackState, SemanticConfidence, SemanticFactEnvelope, SemanticFactKind,
+    SemanticFactStatus, SemanticFreshness, SemanticProducer, SemanticProvenance,
+    SemanticReasonCode, SourceAnchor, SourceGeneration,
+};
+use perl_workspace::workspace::workspace_index::FileFactShard;
+use serde::Serialize;
+use std::collections::{BTreeMap, BTreeSet};
+use std::error::Error;
+use std::fmt;
+
+/// Producer boundary represented by a current [`FileFactShard`].
+///
+/// This constrained vocabulary prevents a caller from relabeling parser or
+/// workspace facts as HIR, PIR-A, or framework facts. Actual compiler facts must
+/// enter through [`CanonicalEnvelopePort`] with their canonical producer intact.
+#[non_exhaustive]
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize)]
+pub enum FileFactShardSource {
+    /// Current-document parser/AST projection.
+    ParserAst,
+    /// Current-document semantic-analyzer projection.
+    SemanticAnalyzer,
+    /// Canonical workspace-index shard.
+    WorkspaceIndex,
+    /// Current ProjectModel projection stored in the existing workspace producer vocabulary.
+    ///
+    /// `perl-semantic-facts` does not yet define a distinct ProjectModel producer.
+    /// This variant therefore retains `WorkspaceIndex` rather than manufacturing
+    /// compiler attribution. It also cannot issue exact-empty authority.
+    ProjectModel,
+}
+
+impl FileFactShardSource {
+    fn producer(self) -> SemanticProducer {
+        match self {
+            Self::ParserAst => SemanticProducer::Parser,
+            Self::SemanticAnalyzer => SemanticProducer::SemanticAnalyzer,
+            Self::WorkspaceIndex | Self::ProjectModel => SemanticProducer::WorkspaceIndex,
+        }
+    }
+
+    fn trace_source(self) -> ProviderFactSourceKind {
+        match self {
+            Self::ParserAst => ProviderFactSourceKind::ParserSyntax,
+            Self::SemanticAnalyzer | Self::ProjectModel => ProviderFactSourceKind::SemanticFact,
+            Self::WorkspaceIndex => ProviderFactSourceKind::LegacyWorkspace,
+        }
+    }
+
+    fn generation_scope(self) -> ProviderFactGenerationScope {
+        match self {
+            Self::ParserAst | Self::SemanticAnalyzer => ProviderFactGenerationScope::Document,
+            Self::WorkspaceIndex | Self::ProjectModel => ProviderFactGenerationScope::Workspace,
+        }
+    }
+
+    fn source_generation(self, snapshot: &ProviderAdapterSnapshot) -> SourceGeneration {
+        match self.generation_scope() {
+            ProviderFactGenerationScope::Document => snapshot.document_generation.clone(),
+            ProviderFactGenerationScope::Workspace => snapshot.workspace_generation.clone(),
+        }
+    }
+
+    fn completeness_provenance(self) -> Option<SemanticProvenance> {
+        match self {
+            Self::ParserAst | Self::WorkspaceIndex => {
+                Some(SemanticProvenance::Known(Provenance::ExactAst))
+            }
+            Self::SemanticAnalyzer => {
+                Some(SemanticProvenance::Known(Provenance::SemanticAnalyzer))
+            }
+            Self::ProjectModel => None,
+        }
+    }
+
+    fn unavailable_provenance(self) -> Provenance {
+        match self {
+            Self::ParserAst | Self::WorkspaceIndex => Provenance::ExactAst,
+            Self::SemanticAnalyzer | Self::ProjectModel => Provenance::SemanticAnalyzer,
+        }
+    }
+
+    fn unavailable_confidence(self) -> Confidence {
+        match self {
+            Self::ProjectModel => Confidence::Medium,
+            Self::ParserAst | Self::SemanticAnalyzer | Self::WorkspaceIndex => Confidence::High,
+        }
+    }
+
+    const fn token(self) -> &'static str {
+        match self {
+            Self::ParserAst => "parser_ast",
+            Self::SemanticAnalyzer => "semantic_analyzer",
+            Self::WorkspaceIndex => "workspace_index",
+            Self::ProjectModel => "project_model",
+        }
+    }
+}
