+/// Request-independent metadata for one adapted producer snapshot.
+///
+/// Fields are private and this type intentionally does not implement
+/// `Deserialize`. Exactness is rechecked against every request; serialized labels
+/// cannot restore authority or bypass the request-generation/readiness guard.
+#[non_exhaustive]
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct ProviderAdapterSnapshot {
+    document_generation: SourceGeneration,
+    workspace_generation: SourceGeneration,
+    freshness: SemanticFreshness,
+    lifecycle: LifecyclePhase,
+    fallback_state: ProviderFallbackState,
+    model_version: Option<u32>,
+}
+
+impl ProviderAdapterSnapshot {
+    /// Construct validated adapter snapshot metadata.
+    pub fn try_new(
+        document_generation: SourceGeneration,
+        workspace_generation: SourceGeneration,
+        freshness: SemanticFreshness,
+        lifecycle: LifecyclePhase,
+        fallback_state: ProviderFallbackState,
+        model_version: Option<u32>,
+    ) -> Result<Self, ProviderAdapterError> {
+        if generation_is_malformed(&document_generation)
+            || generation_is_malformed(&workspace_generation)
+        {
+            return Err(ProviderAdapterError::InvalidSnapshot(
+                "known generations must be non-empty".to_string(),
+            ));
+        }
+        Ok(Self {
+            document_generation,
+            workspace_generation,
+            freshness,
+            lifecycle,
+            fallback_state,
+            model_version,
+        })
+    }
+
+    /// Document generation represented by this snapshot.
+    #[must_use]
+    pub const fn document_generation(&self) -> &SourceGeneration {
+        &self.document_generation
+    }
+
+    /// Workspace/model generation represented by this snapshot.
+    #[must_use]
+    pub const fn workspace_generation(&self) -> &SourceGeneration {
+        &self.workspace_generation
+    }
+
+    /// Producer-snapshot freshness.
+    #[must_use]
+    pub const fn freshness(&self) -> SemanticFreshness {
+        self.freshness
+    }
+
+    /// Lifecycle phase represented by the adapted facts.
+    #[must_use]
+    pub const fn lifecycle(&self) -> LifecyclePhase {
+        self.lifecycle
+    }
+
+    /// Whether this snapshot is primary, fallback, shadow, unavailable, or blocked.
+    #[must_use]
+    pub const fn fallback_state(&self) -> ProviderFallbackState {
+        self.fallback_state
+    }
+
+    /// Optional producer model/schema version retained in traces.
+    #[must_use]
+    pub const fn model_version(&self) -> Option<u32> {
+        self.model_version
+    }
+
+    fn matches_request(&self, request: &ProviderQueryRequest) -> bool {
+        generation_is_known(&self.document_generation)
+            && generation_is_known(&self.workspace_generation)
+            && self.document_generation == request.context.document_generation
+            && self.workspace_generation == request.context.workspace_generation
+    }
+
+    fn is_primary(&self) -> bool {
+        self.fallback_state == ProviderFallbackState::Primary
+    }
+
+    fn is_fallback(&self) -> bool {
+        self.fallback_state == ProviderFallbackState::Fallback
+    }
+
+    fn can_claim_exact(&self, request: &ProviderQueryRequest) -> bool {
+        self.matches_request(request)
+            && self.is_primary()
+            &