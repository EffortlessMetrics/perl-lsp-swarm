+fn generation_is_known(generation: &SourceGeneration) -> bool {
+    matches!(generation, SourceGeneration::Known(value) if !value.trim().is_empty())
+}
+
+fn generation_is_malformed(generation: &SourceGeneration) -> bool {
+    matches!(generation, SourceGeneration::Known(value) if value.trim().is_empty())
+}
