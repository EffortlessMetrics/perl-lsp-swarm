+/// Adapter over facts that already use the canonical semantic envelope.
+///
+/// Producer identities are preserved verbatim. HIR, PIR-A, and framework
+/// attribution can appear only when a selected canonical envelope actually names
+/// that producer. This adapter never issues exact-empty authority and never
+/// authorizes edits from ordinary facts.
+pub struct CanonicalEnvelopePort {
+    records: Vec<AdapterFactRecord>,
+    snapshot: ProviderAdapterSnapshot,
+    unavailable_trace_seeds: Vec<UnavailableTraceSeed>,
+}
+
+impl CanonicalEnvelopePort {
+    /// Construct a canonical-envelope adapter and reject conflicting identities.
+    pub fn try_new(
+        inputs: impl IntoIterator<Item = CanonicalEnvelopeInput>,
+        snapshot: ProviderAdapterSnapshot,
+    ) -> Result<Self, ProviderAdapterError> {
+        let mut records = Vec::new();
+        let mut fact_ids = BTreeSet::new();
+        for input in inputs {
+            let fact_id = input.envelope.fact_id;
+            if !fact_ids.insert(fact_id) {
+                return Err(ProviderAdapterError::DuplicateFactId(fact_id));
+            }
+            let trace_source = source_for_producer(input.envelope.producer);
+            records.push(AdapterFactRecord::try_new(
+                input.envelope,
+                input.generation_scope,
+                input.symbols,
+                None,
+                trace_source,
+                None,
+                snapshot.model_version,
+            )?);
+        }
+        records.sort_by_key(|record| record.envelope.fact_id);
+        let unavailable_trace_seeds = trace_seeds_from_records(&records);
+        if unavailable_trace_seeds.is_empty() {
+            return Err(ProviderAdapterError::MissingCanonicalEvidence);
+        }
+        Ok(Self {
+            records,
+            snapshot,
+            unavailable_trace_seeds,
+        })
+    }
+}
+
+impl ProviderSemanticPort for CanonicalEnvelopePort {
+    fn query(
+        &self,
+        request: &ProviderQueryRequest,
+        control: &dyn ProviderQueryControl,
+    ) -> Result<ProviderQueryResultDraft, ProviderQueryContractError> {
+        query_records(
+            request,
+            control,
+            &self.records,
+            &self.snapshot,
+            &self.unavailable_trace_seeds,
+            |_request| Ok(None),
+        )
+    }
+}
