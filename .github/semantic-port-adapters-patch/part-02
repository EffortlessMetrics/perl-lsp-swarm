+/// Adapter over current parser, semantic-analyzer, workspace, or ProjectModel file shards.
+pub struct FileFactShardPort {
+    records: Vec<AdapterFactRecord>,
+    denominators: BTreeMap<FileId, ShardDenominator>,
+    source: FileFactShardSource,
+    snapshot: ProviderAdapterSnapshot,
+    unavailable_trace_seeds: Vec<UnavailableTraceSeed>,
+}
+
+impl FileFactShardPort {
+    /// Adapt file-fact shards with a constrained, truthful source identity.
+    pub fn try_new(
+        shards: &[FileFactShard],
+        source: FileFactShardSource,
+        snapshot: ProviderAdapterSnapshot,
+    ) -> Result<Self, ProviderAdapterError> {
+        let mut records = Vec::new();
+        let mut denominators = BTreeMap::new();
+        let mut source_uris = BTreeSet::new();
+        let mut fact_ids = BTreeSet::new();
+
+        for shard in shards {
+            if shard.source_uri.trim().is_empty() {
+                return Err(ProviderAdapterError::InvalidShardIdentity(shard.file_id));
+            }
+            if denominators.contains_key(&shard.file_id) {
+                return Err(ProviderAdapterError::DuplicateShardFile(shard.file_id));
+            }
+            if !source_uris.insert(shard.source_uri.clone()) {
+                return Err(ProviderAdapterError::DuplicateShardSourceUri(
+                    shard.source_uri.clone(),
+                ));
+            }
+
+            let mut denominator = ShardDenominator {
+                source_uri: shard.source_uri.clone(),
+                file_id: shard.file_id,
+                content_hash: shard.content_hash,
+                producer_schema_version: shard.producer_schema_version,
+                anchors_hash: shard.anchors_hash,
+                entities_hash: shard.entities_hash,
+                occurrences_hash: shard.occurrences_hash,
+                edges_hash: shard.edges_hash,
+                incomplete_capabilities: BTreeSet::new(),
+            };
+            adapt_shard(
+                shard,
+                source,
+                &snapshot,
+                &mut records,
+                &mut fact_ids,
+                &mut denominator,
+            )?;
+            denominators.insert(shard.file_id, denominator);
+        }
+
+        records.sort_by_key(|record| record.envelope.fact_id);
+        let mut unavailable_trace_seeds = trace_seeds_from_records(&records);
+        if unavailable_trace_seeds.is_empty() {
+            unavailable_trace_seeds.push(file_source_trace_seed(
+                source,
+                &snapshot,
+                &denominators,
+            ));
+        }
+        Ok(Self {
+            records,
+            denominators,
+            source,
+            snapshot,
+            unavailable_trace_seeds,
+        })
+    }
+
+    /// Resolve one shard-local entity identity to the canonical adapter identity.
+    ///
+    /// File-fact entity IDs are local to their shard. Callers that retain a local
+    /// ID must bind it to the owning file before issuing an `Entity` query.
+    #[must_use]
+    pub fn canonical_entity_id(
+        &self,
+        file_id: FileId,
+        local_entity_id: EntityId,
+    ) -> Option<EntityId> {
+        self.denominators.get(&file_id).map(|denominator| {
+            stable_shard_entity_id(
+                self.source,
+                &denominator.source_uri,
+                file_id,
+                local_entity_id,
+            )
+        })
+    }
+
+    fn exact_empty_grant(
+        &self,
+        request: &ProviderQueryRequest,
+    ) -> Result<Option<ProviderCompletenessGrant>, ProviderQueryContractError> {
+        if !self.snapshot.can_claim_exact(request) {
+            return Ok(None);
+        }
+        let Some(provenance) = self.source.completeness_provenance() else {
+            return Ok(None);
+        };
+        let file_id = match &request.subject {
+            ProviderQuerySubject::File(file_id)
+            | ProviderQuerySubject::Position { file_id, .. } => *file_id,
+            _ => return Ok(None),
+        };
+        let Some(denominator) = self.denominators.get(&file_id) else {
+            return Ok(None);
+        };
+        let capability = ProviderQueryCapability::from_query(&request.kind);
+        if !denominator.is_complete_for(capability) {
+            return Ok(None);
+        }
+        issue_provider_completeness_grant(
+            request,
+            self.source.producer(),
+            denominator.denominator_id(self.source, capability),
+            denominator.snapshot_id(self.source),
+            1,
+            provenance,
+            SemanticConfidence::Known(Confidence::High),
+            SemanticFreshness::Fresh,
+        )
+        .map(Some)
+    }
+}
