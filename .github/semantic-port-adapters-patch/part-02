+#[derive(Debug, Default)]
+struct QuerySelection<'a> {
+    records: BTreeMap<FactId, (&'a AdapterFactRecord, ProviderQueryFactRole)>,
+    ambiguous: bool,
+}
+
+impl<'a> QuerySelection<'a> {
+    fn insert(&mut self, record: &'a AdapterFactRecord, role: ProviderQueryFactRole) {
+        self.records
+            .entry(record.envelope.fact_id)
+            .and_modify(|(_, current)| *current = merge_roles(*current, role))
+            .or_insert((record, role));
+    }
+
+    fn value_count(&self) -> usize {
+        self.records
+            .values()
+            .filter(|(_, role)| role_is_value(*role))
+            .count()
+    }
+
+    fn all_records(&self) -> impl Iterator<Item = &'a AdapterFactRecord> + '_ {
+        self.records.values().map(|(record, _)| *record)
+    }
+
+    fn without_values(&mut self) {
+        for (_, role) in self.records.values_mut() {
+            *role = match *role {
+                ProviderQueryFactRole::SelectorValue => ProviderQueryFactRole::Selector,
+                ProviderQueryFactRole::Value => ProviderQueryFactRole::Supporting,
+                other => other,
+            };
+        }
+    }
+
+    fn has_dynamic_boundary(&self) -> bool {
+        self.all_records().any(|record| {
+            record.envelope.boundary.as_ref().is_some_and(|boundary| {
+                matches!(
+                    boundary.kind,
+                    BoundaryKind::DynamicValue
+                        | BoundaryKind::DynamicRequire
+                        | BoundaryKind::DynamicIncludePath
+                        | BoundaryKind::CompileTimeExecution
+                        | BoundaryKind::SymbolicReference
+                )
+            }) || record.envelope.kind == SemanticFactKind::Boundary
+                && record.envelope.reason_code == SemanticReasonCode::DynamicValue
+        })
+    }
+
+    fn first_boundary(&self) -> Option<BoundaryLink> {
+        self.all_records()
+            .find_map(|record| record.envelope.boundary.clone())
+    }
+
+    fn any_status(&self, status: SemanticFactStatus) -> bool {
+        self.all_records()
+            .any(|record| record.envelope.status() == status)
+    }
+
+    fn to_facts(&self) -> Result<Vec<ProviderQueryFact>, ProviderQueryContractError> {
+        self.records
+            .values()
+            .map(|(record, role)| record.to_query_fact(*role))
+            .collect()
+    }
+
+    fn traces(
+        &self,
+        request: &ProviderQueryRequest,
+        fallback_state: ProviderFallbackState,
+    ) -> Vec<ProviderFactTrace> {
+        let mut traces: Vec<_> = self
+            .all_records()
+            .filter_map(|record| record.trace(request, fallback_state))
+            .collect();
+        canonicalize_traces(&mut traces);
+        traces
+    }
+}
+
+fn query_records<F>(
+    request: &ProviderQueryRequest,
+    control: &dyn ProviderQueryControl,
+    records: &[AdapterFactRecord],
+    snapshot: &ProviderAdapterSnapshot,
+    unavailable_trace_seeds: &[UnavailableTraceSeed],
+    exact_empty_grant: F,
+) -> Result<ProviderQueryResultDraft, ProviderQueryContractError>
+where
+    F: FnOnce(
+        &ProviderQueryRequest,
+    ) -> Result<Option<ProviderCompletenessGrant>, ProviderQueryContractError>,
+{
+    if !request.is_well_formed() {
+        return Err(ProviderQueryContractError::MalformedRequest);
+    }
+    if request.context.cancellation == super::semantic_port::ProviderCancellationState::Cancelled
+        || control.is_cancelled()
+    {
+        return Ok(terminal_draft(
+            ProviderQueryOutcome::Cancelled,
+            ProviderQueryTerminalState::Cancelled,
+        ));
+    }
+    if request.context.deadline == super::semantic_port::ProviderQueryDeadline::Expired
+        || control.deadline_expired()
+    {
+        return Ok(terminal_draft(
+            ProviderQueryOutcome::DeadlineExceeded,
+            ProviderQueryTerminalState::DeadlineExceeded,
+        ));
+    }
+    if request.context.readiness_requirement == ProviderReadinessRequirement::EditAuthorizing {
+        return Ok(no_value_draft(
+            ProviderQueryOutcome::Unavailable,
+            Vec::new(),
+            SemanticReasonCode::UnsupportedEffect,
+            vec!["edit_authority_requires_guarded_plan".to_string()],
+            None,
+            unavailable_traces(request, unavailable_trace_seeds),
+        ));
+    }
+    match request.context.readiness_state {
+        ProviderReadinessState::Failed => {
+            return Ok(terminal_draft(
+                ProviderQueryOutcome::Error,
+                ProviderQueryTerminalState::Failed,
+            ));
+        }
+        ProviderReadinessState::Stale => {
+            return Ok(no_value_draft(
+                ProviderQueryOutcome::Stale,
+                Vec::new(),
+                SemanticReasonCode::StaleDependency,
+                vec!["request_readiness_stale".to_string()],
+                None,
+                Vec::new(),
+            ));
+        }
+        ProviderReadinessState::Building | ProviderReadinessState::Unavailable => {
+            return Ok(no_value_draft(
+                ProviderQueryOutcome::Unavailable,
+                Vec::new(),
+                SemanticReasonCode::MissingGeneration,
+                vec!["required_semantic_snapshot_not_ready".to_string()],
+                None,
+                unavailable_traces(request, unavailable_trace_seeds),
+            ));
+        }
