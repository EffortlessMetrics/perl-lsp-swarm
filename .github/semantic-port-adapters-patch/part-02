roviderQueryCapability,
+    ) -> String {
+        format!(
+            "file-fact-shard-v1:{}:{:016x}:{}:{}",
+            source.token(),
+            stable_hash_bytes(self.source_uri.as_bytes()),
+            self.file_id.0,
+            capability_token(capability)
+        )
+    }
+
+    fn snapshot_id(&self, source: FileFactShardSource) -> String {
+        format!(
+            "file-fact-snapshot-v1:{}:{:016x}:{}:{:016x}:{}:{}:{}:{}:{}",
+            source.token(),
+            stable_hash_bytes(self.source_uri.as_bytes()),
+            self.file_id.0,
+            self.content_hash,
+            self.producer_schema_version,
+            optional_hash_token(self.anchors_hash),
+            optional_hash_token(self.entities_hash),
+            optional_hash_token(self.occurrences_hash),
+            optional_hash_token(self.edges_hash),
+        )
+    }
+}
