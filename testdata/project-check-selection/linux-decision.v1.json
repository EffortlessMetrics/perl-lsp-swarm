{
  "architecture": {
    "alternatives": [
      {
        "assessment": "Native, disk-only, exact legacy pm/pl/t and exclusion behavior; inline parsing, unsorted traversal, links and incomplete-success require explicit migration.",
        "decision": "retain ownership, correct named policy rows through #10756/#10766",
        "id": "current-project-walker",
        "source": "crates/perl-lsp-rs/src/cli/check_project.rs"
      },
      {
        "assessment": "Git subprocess and fallback can select different sets; broader case-insensitive source/shebang/XS families, include roots, sorting and cancellation, but ignored paths/traversal errors can vanish; DiscoveryResult lacks operational path evidence and finite entry budget. Does not itself run an index, yet importing its default semantics into CLI changes authority.",
        "decision": "refuse wholesale reuse for v1; reuse only separately proven pure lower-level primitives without default workspace policy",
        "id": "workspace-discovery",
        "source": "crates/perl-workspace/src/discovery/mod.rs; crates/perl-lsp-rs/src/runtime/file_discovery.rs"
      },
      {
        "assessment": "Pure extension/name predicates exist, but canonical editor families and workspace skip names differ from CLI v1; extensionless path helper reads disk.",
        "decision": "do not silently reuse wider predicates or content probes; keep explicit versioned CLI policy rows",
        "id": "source-and-ignore-predicates",
        "source": "crates/perl-parser-core/src/syntax/source_file.rs; crates/perl-workspace/src/ignore/mod.rs"
      },
      {
        "assessment": "Could expose finite deterministic error-aware selection, but adds a new generic authority before a second static consumer exists.",
        "decision": "defer general service; smallest extraction under existing #10756 ownership",
        "id": "new-general-filesystem-service",
        "source": "alternative design, no implementation"
      }
    ],
    "chosen": "Retain CLI-owned static selection in #10756; extract a small policy-driven plan/result boundary without introducing another general scanner or workspace index.",
    "migration": [
      "#10756 preserves the legacy report under a named compatibility selection identity while carrying explicit incomplete/path/read evidence; no silent legacy behavior switch.",
      "#10756/#10766 implement canonical v1 selection and strict/report completeness deliberately. Correct/refuse rows are future migration obligations, not claims of implemented behavior.",
      "#10897 owns canonical parser evaluation; #10809 owns typed category projection; #11269/#11270 consume the accepted result once, without rewalking/reparsing.",
      "The legacy alias remains text-only under #11270; older #7233 JSON proposal is superseded for projects by the later controller and its current reconciliation comment."
    ],
    "reverse_when": [
      "An existing discovery API can produce the same versioned static selection, reversible paths, finite budgets and complete operational evidence without Git/index/default-policy coupling.",
      "Independent native-platform evidence requires a platform-specific path identity or exclusion amendment.",
      "Another real static consumer demonstrates that a generic service removes semantic duplication rather than only shortening code."
    ]
  },
